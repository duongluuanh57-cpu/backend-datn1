    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node --input-type=module -e \"import {rmSync,existsSync} from 'fs'; if (existsSync('dist')) {rmSync('dist', {recursive: true, force: true}); console.log('🧹 Cleaned dist folder')}\"",

<!-- ═══════════════════════════════════════════════════════════════════════
   Trang Chỉnh sửa / Bổ sung Sản phẩm
   mode = 'edit' → chỉnh sửa toàn bộ nội dung
   mode = 'supplement' → bổ sung thông tin (scent read-only)
   ═══════════════════════════════════════════════════════════════════════ -->
<div id="supplement-detail">
  <!-- ── Header ── -->
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;flex-wrap:wrap;">
    <a href="/admin/products" style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;font-weight:500;padding:6px 12px;border-radius:8px;border:1px solid var(--border);" onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'" onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border)'">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Quay lại danh sách
    </a>
    <span style="color:var(--text-muted);">/</span>
    <span id="sd-breadcrumb" style="color:var(--text-primary);font-weight:600;font-size:14px;">Đang tải...</span>
    <span id="sd-status-badge" style="display:none;font-size:11px;padding:3px 12px;border-radius:12px;font-weight:600;"></span>
    <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
      <span id="sd-save-status" style="font-size:12px;"></span>
      <button type="button" id="sd-btn-fill" onclick="fillMissing()" title="AI tự động điền các thông tin còn thiếu" style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid #8b5cf6;border-radius:8px;background:rgba(139,92,246,0.06);color:#8b5cf6;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(139,92,246,0.12)'" onmouseout="this.style.background='rgba(139,92,246,0.06)'">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
      </button>
      <button type="button" id="sd-btn-activate" onclick="saveProduct(true)" style="display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border:none;border-radius:8px;background:var(--accent);color:#fff;cursor:pointer;font-size:12px;font-weight:600;transition:all 0.2s;box-shadow:0 2px 8px rgba(201,169,110,0.25);white-space:nowrap;" onmouseover="this.style.filter='brightness(1.1)';this.style.boxShadow='0 4px 16px rgba(201,169,110,0.35)'" onmouseout="this.style.filter='';this.style.boxShadow='0 2px 8px rgba(201,169,110,0.25)'">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Lưu & Kích hoạt
      </button>
    </div>
  </div>

  <!-- ── Loading ── -->
  <div id="sd-loading" style="text-align:center;padding:80px 20px;color:var(--text-muted);">
    <svg style="animation:spin 1s linear infinite;width:28px;height:28px;margin:0 auto 12px;color:var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
    Đang tải thông tin sản phẩm...
  </div>

  <!-- ── Error ── -->
  <div id="sd-error" style="display:none;text-align:center;padding:80px 20px;"></div>

  <!-- ── Main Form ── -->
  <div id="sd-form" style="display:none;">
    <form id="supplement-form" onsubmit="event.preventDefault();">
      
      <!-- ── 2-Column Layout ── -->
      <div class="sd-form-grid">
        
        <!-- ── LEFT: Ảnh sản phẩm Component ── -->
        <%- include('./partials/product-image-uploader') %>

        <!-- ── RIGHT: Thông tin ── -->
        <div style="display:flex;flex-direction:column;gap:20px;">
          
          <!-- ── Card: Thông tin cơ bản Component ── -->
          <%- include('./partials/product-basic-info-card') %>

          <!-- ── Card: Khuyến mãi ── -->
          <div class="dt-card">
            <h3 style="font-size:14px;font-weight:600;margin:0 0 16px;color:var(--text-primary);">Khuyến mãi</h3>
            <div style="display:grid;grid-template-columns:1fr;gap:12px;">
              <div class="supp-form-group">
                <label>Giảm giá (%)</label>
                <input type="number" id="sd-discount" min="0" max="100" placeholder="0" />
              </div>
            </div>
          </div>

          <!-- ── Card: Biến thể (Variants) Component ── -->
          <%- include('./partials/product-variants-card') %>

          <!-- ── Card: Thuộc tính nước hoa Component ── -->
          <%- include('./partials/product-scent-meta-card') %>

        </div>
      </div>
    </form>
  </div>
</div>

<!-- ── Modals Chọn Danh mục & Tags Component ── -->
<%- include('./partials/product-category-tag-modals') %>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.min.js"></script>
<script>
var PRODUCT_ID = '<%= productId %>';
var TOKEN = '<%= apiToken %>';
var MODE = '<%= mode || 'supplement' %>';
var IS_NEW = '<%= (typeof isNew !== 'undefined' && isNew) ? true : false %>' === 'true';
var H = { 'Authorization': 'Bearer ' + TOKEN, 'Content-Type': 'application/json' };
var currentProduct = null;
var allBrands = [];
var allCategories = [];
var allTags = [];
var selectedCatNames = [];
var selectedTagSlugs = [];
var quill = null;
var currentVariants = [];
var subImageCount = 0;

// Image state tracking
var existingImages = [];        // full list of existing image URLs from DB
var deletedImageUrls = [];      // URLs that were deleted
var uploadedSubImages = [];     // [{ index, url }] — newly uploaded subs
var uploadedMainImageUrl = null; // newly uploaded main image URL

function $(id) { return document.getElementById(id); }
<%- include('../common/utils') %>

// ═══════════════════════════════════════════════════════════════
// LOAD DATA
// ═══════════════════════════════════════════════════════════════
function loadData() {
  // If this is a new product, skip product fetch, just load brands/categories/tags
  var requests = [
    fetch('/api/brands', { headers: H }).then(function(r) { return r.json(); }).catch(function(){ return { success:false, data:[] }; }),
    fetch('/api/categories', { headers: H }).then(function(r) { return r.json(); }).catch(function(){ return { success:false, data:[] }; }),
    fetch('/api/tags', { headers: H }).then(function(r) { return r.json(); }).catch(function(){ return { success:false, data:[] }; }),
  ];

  if (!IS_NEW && PRODUCT_ID) {
    requests.unshift(
      fetch('/api/products/' + PRODUCT_ID + '/admin', { headers: H }).then(function(r) { return r.json(); })
    );
  } else {
    requests.unshift(Promise.resolve({ success: true, data: null }));
  }

  Promise.all(requests).then(function(results) {
    var productRes = results[0];
    var brandsRes = results[1];
    var categoriesRes = results[2];
    var tagsRes = results[3];

    if (IS_NEW || !PRODUCT_ID) {
      // New product — render empty form
      currentProduct = { name: '', brand: '', categories: [], tag: '', image: '', images: [], variants: [], description: '', discountPercentage: 0, discountStartDate: null, discountEndDate: null, status: 'draft' };
    } else {
      if (!productRes || !productRes.success || !productRes.data) {
        $('sd-loading').style.display = 'none';
        $('sd-error').style.display = 'block';
        $('sd-error').innerHTML = '<p style="font-size:16px;font-weight:600;color:var(--danger);">Không tìm thấy sản phẩm</p><p style="margin-top:8px;font-size:13px;color:var(--text-muted);">Sản phẩm có thể đã bị xóa.</p>';
        return;
      }
      currentProduct = productRes.data;
    }

    allBrands = brandsRes.success ? (brandsRes.data || []) : [];
    // Handle cả 2 format: array hoặc { items: [...] }
    var catData = categoriesRes.success ? (categoriesRes.data || []) : [];
    allCategories = Array.isArray(catData) ? catData : (catData.items || []);

    // Handle tags response: { success, data: [...] }
    if (tagsRes.success && Array.isArray(tagsRes.data)) {
      allTags = tagsRes.data;
    } else if (tagsRes.success && tagsRes.data && Array.isArray(tagsRes.data.items)) {
      allTags = tagsRes.data.items;
    }

    // Extract existing images
    var prodImages = Array.isArray(currentProduct.images) ? currentProduct.images : [];
    existingImages = prodImages.length > 0 ? prodImages : (currentProduct.image ? [currentProduct.image] : []);

    renderForm();

    // Init Quill after form is rendered
    quill = new Quill('#sd-description-editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['clean']
        ]
      }
    });
    quill.root.innerHTML = currentProduct.description || '';

    $('sd-loading').style.display = 'none';
    $('sd-form').style.display = 'block';

    // ── Auto-fill on name input ──
    var autoFillTimer = null;
    $('sd-name').addEventListener('input', function() {
      clearTimeout(autoFillTimer);
      var name = this.value.trim();
      if (name.length < 3) return;
      autoFillTimer = setTimeout(function() { autoFillProduct(name); }, 800);
    });
  }).catch(function() {
    $('sd-loading').style.display = 'none';
    $('sd-error').style.display = 'block';
    $('sd-error').innerHTML = '<p style="font-size:16px;font-weight:600;color:var(--danger);">Lỗi kết nối</p>';
  });
}

// ═══════════════════════════════════════════════════════════════
// INIT — Start loading data on page load
// ═══════════════════════════════════════════════════════════════
loadData();

// ═══════════════════════════════════════════════════════════════
// RENDER FORM
// ═══════════════════════════════════════════════════════════════
function renderForm() {
  var p = currentProduct;
  $('sd-breadcrumb').textContent = (p.brand || '') + ' · ' + (p.name || '');
  var pageTitle = MODE === 'edit' ? 'Chỉnh sửa' : 'Bổ sung';
  document.title = pageTitle + ': ' + (p.name || 'Sản phẩm') + ' — Admin';

  // Status badge
  var badge = $('sd-status-badge');
  if (p.status === 'draft') {
    badge.style.display = 'inline-block';
    badge.style.background = 'rgba(245,158,11,0.12)';
    badge.style.color = '#d97706';
    badge.textContent = '⏳ Nháp';
  } else if (p.status === 'active') {
    badge.style.display = 'inline-block';
    badge.style.background = 'rgba(34,197,94,0.12)';
    badge.style.color = '#16a34a';
    badge.textContent = '✓ Đã kích hoạt';
  } else if (p.status === 'archived') {
    badge.style.display = 'inline-block';
    badge.style.background = 'rgba(107,114,128,0.12)';
    badge.style.color = '#6b7280';
    badge.textContent = '⏸ Đã ẩn';
  }

  // Main image
  renderMainImage();

  // Sub images
  renderSubImages();

  // Name
  $('sd-name').value = p.name || '';

  // Brands dropdown
  var brandHtml = '<option value="">-- Chọn thương hiệu --</option>';
  allBrands.forEach(function(b) {
    var selected = (p.brand && p.brand === b.name) || (p.brandId && (p.brandId._id || p.brandId) === b._id) ? ' selected' : '';
    brandHtml += '<option value="' + b._id + '"' + selected + '>' + escapeHtml(b.name) + '</option>';
  });
  $('sd-brand').innerHTML = brandHtml;

  // Categories
  selectedCatNames = typeof p.categories === 'string' ? p.categories.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : [];
  if (!selectedCatNames.length && Array.isArray(p.categories)) {
    selectedCatNames = p.categories.map(function(c) { return typeof c === 'string' ? c : (c.name || ''); }).filter(Boolean);
  }
  renderCategoryChips();

  // Tags
  var tagStr = p.tag || '';
  selectedTagSlugs = tagStr ? tagStr.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : [];
  renderTagChips();

  // Discount
  $('sd-discount').value = p.discountPercentage || '';

  // Variants
  var variants = Array.isArray(p.variants) ? p.variants : [];
  currentVariants = variants.map(function(v) {
    return { size: v.size || '', price: v.price || 0, quantityInStock: v.quantityInStock || 0, isDefault: v.isDefault || false, _id: v._id || null };
  });
  if (currentVariants.length === 0) {
    currentVariants.push({ size: '50ml', price: 0, quantityInStock: 0, isDefault: true, _id: null });
  }
  renderVariants();

  // Scent attributes
  var scentFields = [
    { key: 'longevity', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>', label: 'Độ lưu hương' },
    { key: 'sillage', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>', label: 'Độ tỏa hương' },
    { key: 'scentTrail', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>', label: 'Hương đặc trưng' },
    { key: 'style', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>', label: 'Phong cách' },
    { key: 'suitableFor', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>', label: 'Phù hợp' },
    { key: 'occasion', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>', label: 'Dịp' },
    { key: 'season', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>', label: 'Mùa' },
    { key: 'time', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/></svg>', label: 'Thời điểm' },
  ];
  var scentHtml = '';
  var isEditable = MODE === 'edit';
  scentFields.forEach(function(f) {
    var val = (p.specifications && p.specifications[f.key]) || p[f.key] || '';
    if (isEditable) {
      scentHtml += '<div class="scent-meta-item">' +
        '<span class="scent-meta-icon">' + f.icon + '</span>' +
        '<span class="scent-meta-label">' + f.label + '</span>' +
        '<input type="text" id="sd-' + f.key + '" value="' + escapeHtml(val) + '" placeholder="—" />' +
      '</div>';
    } else {
      scentHtml += '<div class="scent-meta-item">' +
        '<span class="scent-meta-icon">' + f.icon + '</span>' +
        '<span class="scent-meta-label">' + f.label + '</span>' +
        '<span class="scent-meta-value">' + escapeHtml(val || '—') + '</span>' +
      '</div>';
    }
  });
  $('sd-scent-meta').innerHTML = scentHtml || '<span style="color:var(--text-muted);font-size:12px;">Chưa có thuộc tính</span>';
}

// ═══════════════════════════════════════════════════════════════
// IMAGE RENDERING
// ═══════════════════════════════════════════════════════════════
function renderMainImage() {
  var isDeleted = deletedImageUrls.indexOf(currentProduct.image) !== -1;
  var mainUrl = uploadedMainImageUrl || (!isDeleted ? currentProduct.image : null);
  var preview = $('sd-image-preview');
  var delBtn = $('sd-delete-main-image');

  if (mainUrl) {
    preview.innerHTML = '<img src="' + escapeHtml(mainUrl) + '" alt="" />';
    delBtn.style.display = 'inline-flex';
  } else {
    preview.innerHTML = '<span style="color:var(--text-muted);font-size:12px;">Chưa có ảnh</span>';
    delBtn.style.display = 'none';
  }
}

function renderSubImages() {
  var container = $('sd-sub-images');
  var html = '';
  var allSubUrls = [];

  // Existing sub images (excluding main image, not deleted)
  if (Array.isArray(currentProduct.images)) {
    currentProduct.images.forEach(function(url) {
      if (url !== currentProduct.image && deletedImageUrls.indexOf(url) === -1) {
        allSubUrls.push(url);
      }
    });
  }

  // Newly uploaded sub images
  uploadedSubImages.forEach(function(si) {
    allSubUrls.push(si.url);
  });

  allSubUrls.forEach(function(url, idx) {
    html += '<div class="sub-image-row" data-url="' + escapeHtml(url) + '">' +
      '<div class="sub-img-preview"><img src="' + escapeHtml(url) + '" alt="" /></div>' +
      '<span style="flex:1;font-size:11px;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:150px;">' + escapeHtml(url.split('/').pop()) + '</span>' +
      '<button type="button" onclick="deleteSubImage(\'' + escapeHtml(url) + '\')" style="padding:4px 8px;border:none;background:transparent;color:var(--danger);cursor:pointer;font-size:16px;line-height:1;" title="Xóa ảnh phụ">&times;</button>' +
    '</div>';
  });

  container.innerHTML = html;
}

// ═══════════════════════════════════════════════════════════════
// IMAGE DELETE
// ═══════════════════════════════════════════════════════════════
function deleteMainImage() {
  if (!currentProduct.image) return;
  if (!confirm('Xóa ảnh chính này?')) return;

  var url = currentProduct.image;
  callDeleteImage(url, function() {
    if (uploadedMainImageUrl === url) {
      uploadedMainImageUrl = null;
    } else {
      deletedImageUrls.push(url);
    }
    renderMainImage();
    renderSubImages();
  });
}

function deleteSubImage(url) {
  if (!confirm('Xóa ảnh phụ này?')) return;

  // Check if it's a newly uploaded or existing image
  var found = false;
  uploadedSubImages = uploadedSubImages.filter(function(si) {
    if (si.url === url) { found = true; return false; }
    return true;
  });

  if (!found) {
    deletedImageUrls.push(url);
  }

  renderSubImages();

  // Call API
  callDeleteImage(url, function() {});
}

function callDeleteImage(url, cb) {
  fetch('/api/media/images', {
    method: 'DELETE',
    headers: H,
    body: JSON.stringify({ url: url, productId: PRODUCT_ID }),
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success && cb) cb();
      else console.warn('Xóa ảnh thất bại:', res.message);
    })
    .catch(function() {
      console.warn('Lỗi kết nối khi xóa ảnh');
    });
}

// ═══════════════════════════════════════════════════════════════
// CATEGORIES — Modal
// ═══════════════════════════════════════════════════════════════
function renderCategoryChips() {
  var html = selectedCatNames.map(function(name) {
    return '<span class="chip">' + escapeHtml(name) + '<span class="chip-remove" onclick="removeCategory(\'' + escapeHtml(name) + '\')">&times;</span></span>';
  }).join('');
  $('sd-selected-cats').innerHTML = html || '<span style="color:var(--text-muted);font-size:12px;">Chưa chọn danh mục</span>';
}

function removeCategory(name) {
  selectedCatNames = selectedCatNames.filter(function(n) { return n !== name; });
  renderCategoryChips();
}

function renderCategoryModalList() {
  var html = '';
  allCategories.forEach(function(c) {
    var checked = selectedCatNames.indexOf(c.name) !== -1 ? ' checked' : '';
    html += '<label class="modal-check-item"><input type="radio" name="product-category" value="' + escapeHtml(c.name) + '"' + checked + ' />' + escapeHtml(c.name) + '</label>';
  });
  $('cat-modal-list').innerHTML = html || '<span style="color:var(--text-muted);font-size:12px;">Chưa có danh mục nào</span>';
}

function openCategoryModal() {
  renderCategoryModalList();
  $('cat-modal').classList.add('active');
}

function closeCategoryModal() {
  $('cat-modal').classList.remove('active');
}

function saveCategoryModal() {
  var selectedRadio = document.querySelector('#cat-modal-list input[type="radio"]:checked');
  selectedCatNames = [];
  if (selectedRadio) {
    selectedCatNames.push(selectedRadio.value);
  }
  renderCategoryChips();
  closeCategoryModal();
}



// ═══════════════════════════════════════════════════════════════
// TAGS — Modal
// ═══════════════════════════════════════════════════════════════
function renderTagChips() {
  var html = selectedTagSlugs.map(function(slug) {
    var name = slug;
    var found = allTags.find(function(t) { return t.slug === slug; });
    if (found) name = found.name;
    return '<span class="chip">' + escapeHtml(name) + '<span class="chip-remove" onclick="removeTag(\'' + escapeHtml(slug) + '\')">&times;</span></span>';
  }).join('');
  $('sd-selected-tags').innerHTML = html || '<span style="color:var(--text-muted);font-size:12px;">Chưa chọn tags</span>';
}

function removeTag(slug) {
  selectedTagSlugs = selectedTagSlugs.filter(function(s) { return s !== slug; });
  renderTagChips();
}

function renderTagModalList() {
  var html = '';
  allTags.forEach(function(t) {
    var checked = selectedTagSlugs.indexOf(t.slug) !== -1 ? ' checked' : '';
    html += '<label class="modal-check-item"><input type="checkbox" value="' + escapeHtml(t.slug) + '"' + checked + ' onclick="onTagCheckboxClick(this)" />' + escapeHtml(t.name) + '</label>';
  });
  $('tag-modal-list').innerHTML = html || '<span style="color:var(--text-muted);font-size:12px;">Chưa có tags nào</span>';
}

function onTagCheckboxClick(el) {
  var checkedCount = document.querySelectorAll('#tag-modal-list input[type="checkbox"]:checked').length;
  if (checkedCount > 2) {
    el.checked = false;
    showToast('Chỉ được chọn tối đa 2 tags', 'warning');
  }
}

function openTagModal() {
  renderTagModalList();
  $('tag-modal').classList.add('active');
}

function closeTagModal() {
  $('tag-modal').classList.remove('active');
}

function saveTagModal() {
  var cbs = document.querySelectorAll('#tag-modal-list input[type="checkbox"]:checked');
  if (cbs.length < 2) {
    showToast('Vui lòng chọn tối thiểu 2 tags', 'warning');
    return;
  }
  selectedTagSlugs = [];
  cbs.forEach(function(cb) { selectedTagSlugs.push(cb.value); });
  renderTagChips();
  closeTagModal();
}

// ═══════════════════════════════════════════════════════════════
// VARIANTS
// ═══════════════════════════════════════════════════════════════
function renderVariants() {
  var html = '';
  currentVariants.forEach(function(v, i) {
    var formattedPrice = (v.price && Number(v.price) > 0) ? Number(v.price).toLocaleString('vi-VN') : '';
    var stockVal = (v.quantityInStock !== undefined && v.quantityInStock !== null && Number(v.quantityInStock) > 0) ? v.quantityInStock : '';
    html += '<div class="variant-row">' +
      '<input type="text" class="v-size" value="' + escapeHtml(v.size || '') + '" placeholder="Size" oninput="this.style.border=\'\';this.style.boxShadow=\'\';" onchange="updateVariant(' + i + ', \'size\', this.value)" />' +
      '<input type="text" class="v-price" value="' + formattedPrice + '" placeholder="Giá" oninput="handlePriceInput(this, ' + i + ')" />' +
      '<input type="number" class="v-stock" value="' + stockVal + '" placeholder="Tồn kho" min="0" onchange="updateVariant(' + i + ', \'quantityInStock\', Number(this.value))" />' +
      '<label class="v-default-label">' +
        '<input type="radio" name="v-default" class="v-default"' + (v.isDefault ? ' checked' : '') + ' onchange="setDefaultVariant(' + i + ')" /> Mặc định' +
      '</label>' +
      '<button type="button" onclick="removeVariant(' + i + ')" style="padding:4px 8px;border:none;background:transparent;color:var(--danger);cursor:pointer;font-size:16px;line-height:1;" title="Xóa biến thể">&times;</button>' +
    '</div>';
  });
  $('sd-variants-list').innerHTML = html || '<span style="color:var(--text-muted);font-size:12px;padding:8px;">Chưa có biến thể</span>';
}

function handlePriceInput(input, index) {
  var rawDigits = input.value.replace(/[^\d]/g, '');
  var num = Number(rawDigits) || 0;
  currentVariants[index].price = num;
  input.value = num > 0 ? num.toLocaleString('vi-VN') : '';
}

function addVariant() {
  currentVariants.push({ size: '', price: 0, quantityInStock: 0, isDefault: currentVariants.length === 0, _id: null });
  renderVariants();
}

function removeVariant(index) {
  if (currentVariants.length <= 1) return;
  var wasDefault = currentVariants[index].isDefault;
  currentVariants.splice(index, 1);
  if (wasDefault && currentVariants.length > 0) currentVariants[0].isDefault = true;
  renderVariants();
}

function updateVariant(index, field, value) {
  currentVariants[index][field] = value;
}

function setDefaultVariant(index) {
  currentVariants.forEach(function(v, i) { v.isDefault = i === index; });
}

// ═══════════════════════════════════════════════════════════════
// IMAGE UPLOAD
// ═══════════════════════════════════════════════════════════════
function getProductSlug() {
  var name = $('sd-name').value.trim() || currentProduct.name || 'product';
  return name
    .replace(/[^a-zA-Z0-9\u00C0-\u1EF9\-]/g, '-')
    .toLowerCase()
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '') || 'product';
}

function handleImageUpload(event, subIndex) {
  var file = event.target.files[0];
  if (!file) return;

  var statusEl = $('sd-upload-status');
  statusEl.textContent = 'Đang tải ảnh lên...';
  statusEl.style.color = 'var(--accent)';

  var slug = getProductSlug();
  var formData = new FormData();
  formData.append('image', file);
  if (subIndex !== null && subIndex !== undefined) {
    formData.append('subIndex', String(subIndex));
  }

  var queryStr = '?productSlug=' + encodeURIComponent(slug);
  if (subIndex !== null && subIndex !== undefined) {
    queryStr += '&subIndex=' + subIndex;
  }

  fetch('/api/media/upload-r2' + queryStr, {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + TOKEN },
    body: formData,
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success && res.data && res.data.url) {
        if (subIndex === null || subIndex === undefined) {
          // Main image
          uploadedMainImageUrl = res.data.url;
          renderMainImage();
          statusEl.textContent = '✓ Ảnh chính đã tải lên';
        } else {
          // Sub image
          uploadedSubImages.push({ index: subIndex, url: res.data.url });
          statusEl.textContent = '✓ Ảnh phụ đã tải lên';
          renderSubImages();
        }
        statusEl.style.color = '#16a34a';
      } else {
        statusEl.textContent = 'Lỗi: ' + (res.message || 'Không thể upload');
        statusEl.style.color = 'var(--danger)';
      }
    })
    .catch(function() {
      statusEl.textContent = 'Lỗi kết nối khi upload';
      statusEl.style.color = 'var(--danger)';
    });

  event.target.value = '';
}

function addSubImage() {
  subImageCount++;
  var idx = subImageCount - 1;

  var inputId = 'sd-sub-upload-' + idx;
  var row = document.createElement('div');
  row.id = 'sd-sub-row-' + idx;
  row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px;background:var(--bg);border-radius:8px;border:1px solid var(--border);';

  var preview = document.createElement('div');
  preview.id = 'sd-sub-preview-' + idx;
  preview.style.cssText = 'width:48px;height:48px;border-radius:6px;overflow:hidden;border:1px solid var(--border);background:var(--surface);flex-shrink:0;display:flex;align-items:center;justify-content:center;';
  preview.innerHTML = '<span style="font-size:10px;color:var(--text-muted);">#' + (idx+1) + '</span>';

  var fileInput = document.createElement('input');
  fileInput.type = 'file';
  fileInput.id = inputId;
  fileInput.accept = 'image/*';
  fileInput.style.display = 'none';
  fileInput.onchange = function(e) {
    handleImageUpload(e, idx);
    var f = e.target.files[0];
    if (f) {
      var reader = new FileReader();
      reader.onload = function(ev) {
        document.getElementById('sd-sub-preview-' + idx).innerHTML = '<img src="' + ev.target.result + '" alt="" style="width:100%;height:100%;object-fit:cover;" />';
      };
      reader.readAsDataURL(f);
    }
  };

  var btn = document.createElement('button');
  btn.type = 'button';
  btn.textContent = 'Chọn ảnh #' + (idx+1);
  btn.style.cssText = 'flex:1;padding:6px 12px;border:1px dashed var(--border);border-radius:6px;background:transparent;color:var(--text-muted);cursor:pointer;font-size:12px;text-align:left;';
  btn.onclick = function() { document.getElementById(inputId).click(); };

  var removeBtn = document.createElement('button');
  removeBtn.type = 'button';
  removeBtn.innerHTML = '&times;';
  removeBtn.style.cssText = 'padding:4px 8px;border:none;background:transparent;color:var(--danger);cursor:pointer;font-size:16px;line-height:1;';
  removeBtn.onclick = function() {
    uploadedSubImages = uploadedSubImages.filter(function(si) { return si.index !== idx; });
    document.getElementById('sd-sub-row-' + idx).remove();
  };

  row.appendChild(preview);
  row.appendChild(fileInput);
  row.appendChild(btn);
  row.appendChild(removeBtn);

  $('sd-sub-images').appendChild(row);
}

// ═══════════════════════════════════════════════════════════════
// SAVE
// ═══════════════════════════════════════════════════════════════
function saveProduct(activate) {
  var statusEl = $('sd-save-status');
  statusEl.textContent = 'Đang lưu...';
  statusEl.style.color = 'var(--accent)';

  var btnActivate = $('sd-btn-activate');
  btnActivate.disabled = true;
  btnActivate.style.opacity = '0.6';

  // Gather categories — service cần comma-separated names
  // (uses global selectedCatNames from modal)

  // Gather variants
  var formattedVariants = currentVariants.map(function(v, i) {
    return {
      size: v.size || '50ml',
      price: Number(v.price) || 0,
      quantityInStock: Number(v.quantityInStock || 0),
      isDefault: v.isDefault || i === 0,
    };
  });

  var variantStr = formattedVariants.map(function(v) {
    return v.size + ':' + v.price + ':' + v.quantityInStock;
  }).join(',');

  // Default variant stock
  var defaultVar = formattedVariants.find(function(v) { return v.isDefault; }) || formattedVariants[0];
  var quantityInStock = defaultVar ? defaultVar.quantityInStock : 0;

  // Build body
  var desc = quill ? quill.root.innerHTML.trim() : '';
  if (desc === '<p><br></p>' || desc === '<p></p>') desc = '';
  var body = {
    name: $('sd-name').value.trim(),
    description: desc,
    brand: $('sd-brand').value || undefined,
    categories: selectedCatNames.join(','),
    tag: selectedTagSlugs.join(', '),
    size: variantStr,
    variants: formattedVariants,
    quantityInStock: quantityInStock,
    status: activate ? 'active' : 'draft',
  };

  // Discount
  var discVal = $('sd-discount').value;
  if (discVal) body.discountPercentage = Number(discVal);

  // Scent attributes (always editable now)
  body.longevity = ($('sd-longevity') && $('sd-longevity').value) || undefined;
  body.sillage = ($('sd-sillage') && $('sd-sillage').value) || undefined;
  body.scentTrail = ($('sd-scentTrail') && $('sd-scentTrail').value) || undefined;
  body.style = ($('sd-style') && $('sd-style').value) || undefined;
  body.suitableFor = ($('sd-suitableFor') && $('sd-suitableFor').value) || undefined;
  body.occasion = ($('sd-occasion') && $('sd-occasion').value) || undefined;
  body.season = ($('sd-season') && $('sd-season').value) || undefined;
  body.time = ($('sd-time') && $('sd-time').value) || undefined;

  // Build images list: existing (not deleted) + new uploads
  var finalImages = [];

  // Main image
  if (uploadedMainImageUrl) {
    body.image = uploadedMainImageUrl;
    finalImages.push(uploadedMainImageUrl);
  } else if (currentProduct.image && deletedImageUrls.indexOf(currentProduct.image) === -1) {
    body.image = currentProduct.image;
    finalImages.push(currentProduct.image);
  }

  // Sub images (existing, not deleted)
  if (Array.isArray(currentProduct.images)) {
    currentProduct.images.forEach(function(url) {
      if (url !== currentProduct.image && deletedImageUrls.indexOf(url) === -1 && finalImages.indexOf(url) === -1) {
        finalImages.push(url);
      }
    });
  }

  // Newly uploaded sub images
  uploadedSubImages.forEach(function(si) {
    if (finalImages.indexOf(si.url) === -1) {
      finalImages.push(si.url);
    }
  });

  // Set images on body (except main image which is already tracked separately)
  body.images = finalImages.filter(function(url) { return url !== body.image; });

  // Validation
  var _errors = [];
  if (!body.name) _errors.push('Tên sản phẩm');
  if (!body.brand) _errors.push('Thương hiệu');
  if (selectedCatNames.length !== 1) _errors.push('Danh mục (phải chọn đúng 1)');
  var hasPrice = currentVariants.some(function(v) { return v.price > 0; });
  if (!hasPrice) _errors.push('Biến thể (cần ít nhất 1 có giá > 0)');
  if (_errors.length) {
    statusEl.textContent = 'Thiếu: ' + _errors.join(', ');
    statusEl.style.color = 'var(--danger)';
    btnActivate.disabled = false;
    btnActivate.style.opacity = '1';
    return;
  }

  var isNew = !PRODUCT_ID;
  var url = isNew ? '/api/products' : '/api/products/' + PRODUCT_ID;
  var method = isNew ? 'POST' : 'PATCH';
  fetch(url, { method: method, headers: H, body: JSON.stringify(body) })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success) {
        if (isNew && res.data && res.data._id) PRODUCT_ID = res.data._id;
        if (res.autoActivated || activate) {
          statusEl.textContent = '✅ Sản phẩm đã được kích hoạt! Đang chuyển trang...';
          statusEl.style.color = '#16a34a';
          setTimeout(function() {
            var toastType = activate ? 'success' : 'info';
            var toastMsg = activate ? 'Đã+kích+hoạt+sản+phẩm' : 'Đã+lưu+thay+đổi';
            var baseUrl = MODE === 'edit' ? '/admin/products' : '/admin/products/supplement';
            window.location.href = baseUrl + '?toast=' + toastMsg + '&type=' + toastType;
          }, 1200);
        } else {
          statusEl.textContent = '✓ Đã lưu thay đổi';
          statusEl.style.color = '#16a34a';
          setTimeout(function() { statusEl.textContent = ''; }, 3000);
        }
      } else {
        statusEl.textContent = 'Lỗi: ' + (res.message || 'Không thể lưu');
        statusEl.style.color = 'var(--danger)';
      }
      btnActivate.disabled = false;
      btnActivate.style.opacity = '1';
    })
    .catch(function() {
      statusEl.textContent = 'Lỗi kết nối';
      statusEl.style.color = 'var(--danger)';
      btnActivate.disabled = false;
      btnActivate.style.opacity = '1';
    });
}

<%- include('./partials/product-auto-fill') %>
</script>

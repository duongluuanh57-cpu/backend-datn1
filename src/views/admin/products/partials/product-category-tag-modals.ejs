<!-- ── Modal: Chọn danh mục ── -->
<div id="cat-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-header">
      <h4>Chọn danh mục</h4>
      <button type="button" onclick="closeCategoryModal()">&times;</button>
    </div>
    <div class="modal-body" id="cat-modal-body">
      <div id="cat-modal-list" style="display:flex;flex-direction:column;gap:6px;">
        <!-- radio buttons injected by JS -->
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" onclick="closeCategoryModal()" class="modal-btn-cancel">Hủy</button>
      <button type="button" onclick="saveCategoryModal()" class="modal-btn-save">Xác nhận</button>
    </div>
  </div>
</div>

<!-- ── Modal: Chọn tags ── -->
<div id="tag-modal" class="modal-overlay">
  <div class="modal-box">
    <div class="modal-header">
      <h4>Chọn tags</h4>
      <button type="button" onclick="closeTagModal()">&times;</button>
    </div>
    <div class="modal-body" id="tag-modal-body">
      <div id="tag-modal-list" style="display:flex;flex-direction:column;gap:6px;">
        <!-- checkboxes injected by JS -->
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" onclick="closeTagModal()" class="modal-btn-cancel">Hủy</button>
      <button type="button" onclick="saveTagModal()" class="modal-btn-save">Xác nhận</button>
    </div>
  </div>
</div>

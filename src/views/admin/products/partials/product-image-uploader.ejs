<!-- ── LEFT: Ảnh sản phẩm Component ── -->
<div class="dt-card" style="position:sticky;top:80px;">
  <h3 style="font-size:14px;font-weight:600;margin:0 0 12px;color:var(--text-primary);display:flex;align-items:center;gap:8px;">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    Ảnh sản phẩm
  </h3>
  
  <!-- Main image preview -->
  <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">Ảnh chính</div>
  <div id="sd-image-preview" style="width:100%;aspect-ratio:1;border-radius:12px;overflow:hidden;border:2px solid var(--accent);background:var(--bg);margin-bottom:8px;display:flex;align-items:center;justify-content:center;position:relative;">
    <span style="color:var(--text-muted);font-size:12px;">Chưa có ảnh</span>
  </div>
  
  <!-- Main image actions -->
  <div style="display:flex;gap:6px;margin-bottom:12px;">
    <input type="file" id="sd-image-upload" accept="image/*" style="display:none;" onchange="handleImageUpload(event, null)" />
    <button type="button" onclick="document.getElementById('sd-image-upload').click()" style="flex:1;display:flex;align-items:center;justify-content:center;gap:4px;padding:8px;border:2px dashed var(--accent);border-radius:8px;background:rgba(201,169,110,0.04);color:var(--accent);cursor:pointer;font-size:12px;font-weight:600;transition:all 0.2s;" onmouseover="this.style.background='rgba(201,169,110,0.1)'" onmouseout="this.style.background='rgba(201,169,110,0.04)'">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      Tải ảnh chính
    </button>
    <button type="button" id="sd-delete-main-image" onclick="deleteMainImage()" style="display:none;padding:8px 10px;border:1px solid var(--danger);border-radius:8px;background:rgba(239,68,68,0.06);color:var(--danger);cursor:pointer;font-size:12px;transition:all 0.2s;" onmouseover="this.style.background='rgba(239,68,68,0.12)'" onmouseout="this.style.background='rgba(239,68,68,0.06)'" title="Xóa ảnh chính">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
    </button>
  </div>

  <!-- Sub images -->
  <div style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">Ảnh phụ</div>
  <div id="sd-sub-images" style="display:flex;flex-direction:column;gap:8px;">
    <!-- sub image rows injected by JS -->
  </div>
  <button type="button" onclick="addSubImage()" style="width:100%;display:flex;align-items:center;justify-content:center;gap:4px;padding:8px;border:1px dashed var(--border);border-radius:8px;background:var(--bg);color:var(--text-muted);cursor:pointer;font-size:12px;font-weight:500;transition:all 0.2s;margin-top:8px;" onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Thêm ảnh phụ
  </button>
  <div id="sd-upload-status" style="margin-top:8px;font-size:11px;color:var(--text-muted);text-align:center;"></div>
</div>

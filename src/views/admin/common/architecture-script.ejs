<script>
(function () {
  /* ═══════════════════════════════════════════════
     MODEL DATA — 24 models, fields, types, refs
     ═══════════════════════════════════════════════ */
  var ZONES = [
    {
      name: 'Product Catalog', color: 'olive', icon: '&#9733;',
      models: [
        { key: 'Brand', coll: 'brands', desc: 'Thương hiệu sản phẩm', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'name',t:'String',req:1},{n:'logo',t:'String'},{n:'origin',t:'String'},{n:'status',t:'active|inactive'},{n:'featured',t:'Boolean'}
        ]},
        { key: 'Product', coll: 'products', desc: 'Sản phẩm chính — nước hoa', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'name',t:'String',req:1},{n:'brandId',t:'ObjectId',ref:'Brand'},{n:'variants',t:'[ObjectId]',ref:'ProductVariant'},
          {n:'categories',t:'[ObjectId]',ref:'Category'},{n:'description',t:'String'},{n:'image',t:'String'},{n:'status',t:'draft|active|archived'},
          {n:'discountPercentage',t:'Number'},{n:'soldCount',t:'Number'},{n:'viewCount',t:'Number'},{n:'embedding',t:'[Number] 768d'},
          {n:'longevity',t:'String'},{n:'sillage',t:'String'},{n:'scentTrail',t:'String'},
          {n:'style',t:'String'},{n:'suitableFor',t:'String'},{n:'occasion',t:'String'},{n:'season',t:'String'},{n:'time',t:'String'}
        ]},
        { key: 'ProductVariant', coll: 'product_variants', desc: 'Biến thể dung tích / giá', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'productId',t:'ObjectId',ref:'Product',req:1},{n:'size',t:'String',req:1},{n:'price',t:'Number',req:1},
          {n:'quantityInStock',t:'Number'},{n:'sku',t:'String'},{n:'isDefault',t:'Boolean'},{n:'sortOrder',t:'Number'}
        ]},
        { key: 'ProductImage', coll: 'product_images', desc: 'Ảnh sản phẩm', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'productId',t:'ObjectId',ref:'Product',req:1},{n:'url',t:'String',req:1}
        ]},
        { key: 'Category', coll: 'categories', desc: 'Danh mục sản phẩm', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'name',t:'String',req:1},{n:'slug',t:'String',req:1,uniq:1},{n:'status',t:'active|inactive'}
        ]},
        { key: 'Tag', coll: 'tags', desc: 'Tags phân loại', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'name',t:'String',req:1},{n:'slug',t:'String',req:1},{n:'status',t:'active|inactive'}
        ]},
        { key: 'ProductTag', coll: 'product_tags', desc: 'Bảng liên kết N:M Product ↔ Tag', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'productId',t:'ObjectId',ref:'Product',req:1},{n:'tagId',t:'ObjectId',ref:'Tag',req:1}
        ]},
      ]
    },
    {
      name: 'User & Auth', color: 'blue', icon: '&#9787;',
      models: [
        { key: 'User', coll: 'users', desc: 'Tài khoản người dùng', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'username',t:'String',req:1,uniq:1},{n:'email',t:'String',req:1,uniq:1},
          {n:'passwordHash',t:'String'},{n:'role',t:'USER|ADMIN'},{n:'memberTier',t:'MEMBER|Bac|Vang|KimCuong'},
          {n:'status',t:'active|inactive|suspended'},{n:'fullName',t:'String'},{n:'phoneNumber',t:'String'},
          {n:'gender',t:'MALE|FEMALE|OTHER'},{n:'oauthProvider',t:'google|github'},{n:'oauthId',t:'String'}
        ]},
        { key: 'UserAddress', coll: 'user_addresses', desc: 'Địa chỉ giao hàng', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'ObjectId',ref:'User',req:1},{n:'label',t:'String'},{n:'address',t:'String'},
          {n:'province',t:'String'},{n:'district',t:'String'},{n:'isDefault',t:'Boolean'}
        ]},
        { key: 'Cart', coll: 'carts', desc: 'Giỏ hàng (1 user = 1 cart)', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'ObjectId',ref:'User',req:1,uniq:1},{n:'totalAmount',t:'Number'},
          {n:'voucherCode',t:'String'},{n:'voucherDiscount',t:'Number'}
        ]},
        { key: 'CartItem', coll: 'cartitems', desc: 'Sản phẩm trong giỏ', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'cartId',t:'ObjectId',ref:'Cart',req:1},{n:'userId',t:'ObjectId',ref:'User',req:1},
          {n:'productId',t:'ObjectId',ref:'Product',req:1},{n:'name',t:'String',req:1},{n:'price',t:'Number',req:1},
          {n:'quantity',t:'Number',req:1},{n:'variantSize',t:'String'},{n:'image',t:'String'},{n:'brand',t:'String'}
        ]},
      ]
    },
    {
      name: 'Order & Payment', color: 'clay', icon: '&#9733;',
      models: [
        { key: 'Order', coll: 'orders', desc: 'Đơn hàng', fields: [
           {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'ObjectId',ref:'User'},{n:'shippingInfo',t:'Object',desc:'customerName/Phone/Address/Email/lat/lng/note'},
          {n:'itemsSubtotal',t:'Number'},{n:'totalAmount',t:'Number',req:1},{n:'shippingMethodId',t:'ObjectId',ref:'ShippingMethod'},{n:'voucherId',t:'ObjectId',ref:'Voucher'},{n:'trackingNumber',t:'String'},
          {n:'status',t:'pending|processing|shipped|delivered|cancelled'},{n:'paymentMethod',t:'cod|bank_transfer|...'},
          {n:'paymentStatus',t:'unpaid|paid|refunded'},{n:'paymentInfo',t:'Object'},{n:'cancelRequested',t:'Boolean'},{n:'cancelReason',t:'String (enum)'},{n:'deliveredAt',t:'Date'},{n:'cancelledAt',t:'Date'}
        ]},
        { key: 'ShippingMethod', coll: 'shipping_methods', desc: 'Phương thức giao hàng', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'name',t:'String',req:1},{n:'code',t:'String',req:1,uq:1},{n:'fee',t:'Number'},{n:'freeShipMinAmount',t:'Number'},{n:'estimatedDays',t:'String'},{n:'isActive',t:'Boolean'}
        ]},
        { key: 'OrderItem', coll: 'order_items', desc: 'Chi tiết đơn hàng', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'orderId',t:'ObjectId',ref:'Order',req:1},{n:'productId',t:'ObjectId',ref:'Product',req:1},
          {n:'name',t:'String',req:1},{n:'brand',t:'String'},{n:'quantity',t:'Number',req:1},{n:'price',t:'Number',req:1},
          {n:'image',t:'String'},{n:'variantSize',t:'String'}
        ]},
        { key: 'Voucher', coll: 'vouchers', desc: 'Mã giảm giá', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'code',t:'String',req:1,uniq:1},{n:'type',t:'percentage|fixed'},{n:'value',t:'Number',req:1},
          {n:'scope',t:'shop|customer'},{n:'userId',t:'ObjectId',ref:'User'},{n:'minOrderAmount',t:'Number'},
          {n:'maxDiscount',t:'Number'},{n:'maxUsage',t:'Number'},{n:'usedCount',t:'Number'},
          {n:'startDate',t:'Date',req:1},{n:'endDate',t:'Date',req:1},{n:'status',t:'active|inactive'}
        ]},
        { key: 'PendingPayment', coll: 'pending_payments', desc: 'Thanh toán chờ xử lý (TTL 60ph)', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'txnRef',t:'String',req:1,uniq:1},{n:'userId',t:'ObjectId',ref:'User',req:1},
          {n:'cartSnapshot',t:'Object'},{n:'shippingFee',t:'Number'},{n:'finalAmount',t:'Number',req:1},
          {n:'customerInfo',t:'Object'},{n:'status',t:'pending|completed|failed|expired'}
        ]},
        { key: 'Payment', coll: 'payments', desc: 'Giao dịch thanh toán', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'orderId',t:'ObjectId',ref:'Order',req:1},{n:'paymentMethodId',t:'ObjectId',ref:'PaymentMethod',req:1},
          {n:'method',t:'String',req:1},{n:'status',t:'pending|paid|failed|refunded'},
          {n:'transactionCode',t:'String'},{n:'txnRef',t:'String'},{n:'paidAt',t:'Date'},{n:'refundedAt',t:'Date'}
        ]},
        { key: 'PaymentMethod', coll: 'payment_methods', desc: 'Phương thức thanh toán', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'name',t:'String',req:1},{n:'code',t:'String',req:1,uniq:1},
          {n:'icon',t:'String'},{n:'isActive',t:'Boolean'},{n:'sortOrder',t:'Number'}
        ]},
      ]
    },
    {
      name: 'Engagement', color: 'gold', icon: '&#10084;',
      models: [
        { key: 'Review', coll: 'reviews', desc: 'Đánh giá sản phẩm', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'ObjectId',ref:'User',req:1},{n:'productId',t:'ObjectId',ref:'Product',req:1},
          {n:'orderItemId',t:'ObjectId',ref:'OrderItem',req:1},{n:'rating',t:'Number 1-5',req:1},{n:'comment',t:'String'},
          {n:'images',t:'[String]'},{n:'status',t:'visible|hidden'}
        ]},
        { key: 'Favorite', coll: 'favorites', desc: 'Sản phẩm yêu thích', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'ObjectId',ref:'User',req:1},{n:'productId',t:'ObjectId',ref:'Product',req:1}
        ]},
        { key: 'MiniGameSession', coll: 'mini_game_sessions', desc: 'Phiên chơi mini game', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'String'},{n:'gameType',t:'wheel|scratch|dice|quiz'},
          {n:'status',t:'playing|won|lost'},{n:'reward',t:'Object'},{n:'playedAt',t:'Date'},{n:'expiresAt',t:'Date'}
        ]},
      ]
    },
    {
      name: 'AI & Content', color: 'red', icon: '&#9881;',
      models: [
        { key: 'Content', coll: 'content', desc: 'Nội dung bài viết / SEO', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'title',t:'String',req:1},{n:'body',t:'String',req:1},
          {n:'embedding',t:'[Number] 768d',req:1},{n:'sourceFile',t:'String'},{n:'chunkIndex',t:'Number'},{n:'metadata',t:'Mixed'}
        ]},
        { key: 'AIFeedback', coll: 'aifeedbacks', desc: 'Phản hồi AI (semantic cache)', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'messageId',t:'String',req:1,uniq:1},{n:'question',t:'String',req:1},
          {n:'answer',t:'String',req:1},{n:'rating',t:'Number 1-5',req:1},{n:'embedding',t:'[Number] 768d'},{n:'userId',t:'String'}
        ]},
      ]
    },
    {
      name: 'System', color: 'purple', icon: '&#9881;',
      models: [
        { key: 'AuditLog', coll: 'auditlogs', desc: 'Nhật ký hoạt động admin', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'userId',t:'ObjectId',ref:'User',req:1},{n:'action',t:'String',req:1},
          {n:'resource',t:'String',req:1},{n:'metadata',t:'Mixed'},{n:'status',t:'SUCCESS|FAILURE'}
        ]},
        { key: 'DailySummaryReport', coll: 'daily_summary_reports', desc: 'Báo cáo doanh thu theo ngày', fields: [
          {n:'_id',t:'ObjectId',pk:1},{n:'date',t:'Date',req:1,uniq:1},{n:'totalRevenue',t:'Number'},
          {n:'totalOrders',t:'Number'},{n:'completedOrders',t:'Number'},{n:'cancelledRevenue',t:'Number'}
        ]},
      ]
    },
  ];

  var ALL_MODELS = [];
  ZONES.forEach(function(z) {
    z.models.forEach(function(m) { m.zone = z.name; m.color = z.color; ALL_MODELS.push(m); });
  });

  var MODEL_MAP = {};
  ALL_MODELS.forEach(function(m) { MODEL_MAP[m.key] = m; });

  var COLOR_HEX = { olive:'#788C5D', blue:'#5B7E96', clay:'#D97757', gold:'#C9A45C', red:'#B04A3F', purple:'#8B6DB0' };

  var ER_PAD = 14, ER_HDR = 28, ER_LINE = 16, ER_W = 180;
  var erScale = 1, erPanX = 0, erPanY = 0;
  var erDragging = false, erStartX = 0, erStartY = 0, erDragMoved = false;

  function erBoxHeight(m) { return ER_HDR + ER_PAD + m.fields.length * ER_LINE + ER_PAD; }

  var REL_DATA = [];

  function renderER() {
    var g = document.getElementById('erSvgContent');
    var html = '';

    var ROW_GAP = 30;
    var positions = {};

    var layoutOrder = [
      ['Brand','Product','ProductVariant','ProductImage'],
      ['Category','Tag','ProductTag'],
      ['User','UserAddress','Cart','CartItem'],
      ['Order','OrderItem','Voucher','PendingPayment'],
      ['Payment','PaymentMethod','Review','Favorite'],
      ['MiniGameSession','Content','AIFeedback','AuditLog','DailySummaryReport'],
    ];

    var curY = 40;
    layoutOrder.forEach(function(row) {
      var x = 40;
      var maxH = 0;
      row.forEach(function(key) {
        var m = MODEL_MAP[key]; if (!m) return;
        var h = erBoxHeight(m);
        positions[key] = { x: x, y: curY, w: ER_W, h: h };
        x += ER_W + 30;
        if (h > maxH) maxH = h;
      });
      curY += maxH + ROW_GAP;
    });

    var maxW = 0, maxH2 = 0;
    for (var k in positions) {
      if (positions[k].x + positions[k].w > maxW) maxW = positions[k].x + positions[k].w;
      if (positions[k].y + positions[k].h > maxH2) maxH2 = positions[k].y + positions[k].h;
    }
    document.getElementById('archERSvg').setAttribute('viewBox', '0 0 '+(maxW+60)+' '+(maxH2+60));

    REL_DATA = [];
    ALL_MODELS.forEach(function(m) {
      m.fields.forEach(function(f) {
        if (f.ref && positions[f.ref] && positions[m.key]) {
          var from = positions[m.key], to = positions[f.ref];
          var fx = from.x + from.w, fy = from.y + from.h/2;
          var tx = to.x, ty = to.y + to.h/2;
          if (fx < tx) { fx = from.x; tx = to.x + to.w; }
          var mx = (fx + tx) / 2;
          var my = (fy + ty) / 2;
          html += '<path class="er-rel" data-from="'+m.key+'" data-to="'+f.ref+'" d="M'+fx+','+fy+' C'+mx+','+fy+' '+mx+','+ty+' '+tx+','+ty+'" marker-end="url(#er-arr)"/>';
          REL_DATA.push({ from: m.key, to: f.ref });
        }
      });
    });

    layoutOrder.forEach(function(row) {
      row.forEach(function(key) {
        var m = MODEL_MAP[key]; if (!m) return;
        var p = positions[key]; if (!p) return;
        var h = erBoxHeight(m);
        var hdrColor = COLOR_HEX[m.color] || '#87867F';

        html += '<g class="er-model" data-model="'+key+'">';
        html += '<rect class="er-box" x="'+p.x+'" y="'+p.y+'" width="'+p.w+'" height="'+h+'"/>';
        html += '<rect x="'+p.x+'" y="'+p.y+'" width="'+p.w+'" height="'+ER_HDR+'" rx="8" fill="'+hdrColor+'" opacity="0.12"/>';
        html += '<rect x="'+p.x+'" y="'+(p.y+ER_HDR-2)+'" width="'+p.w+'" height="2" rx="1" fill="'+hdrColor+'" opacity="0.3"/>';
        html += '<text class="er-hdr" x="'+(p.x+ER_PAD)+'" y="'+(p.y+19)+'" fill="'+hdrColor+'">'+m.key+'</text>';
        html += '<text class="er-coll" x="'+(p.x+p.w-ER_PAD)+'" y="'+(p.y+18)+'" text-anchor="end">'+m.coll+'</text>';
        m.fields.forEach(function(f, fi) {
          var fy = p.y + ER_HDR + ER_PAD + fi * ER_LINE + 11;
          var cls = 'er-field';
          if (f.pk) cls += ' er-pk';
          else if (f.ref) cls += ' er-fk';
          html += '<text class="'+cls+'" x="'+(p.x+ER_PAD)+'" y="'+fy+'">'+f.n+'</text>';
          var typeStr = f.t;
          if (f.req) typeStr += ' *';
          if (f.ref) typeStr += ' →'+f.ref;
          if (f.uniq) typeStr += ' UQ';
          html += '<text class="er-type" x="'+(p.x+p.w-ER_PAD)+'" y="'+fy+'" text-anchor="end">'+typeStr+'</text>';
        });
        html += '</g>';
      });
    });

    g.innerHTML = html;

    g.querySelectorAll('.er-model').forEach(function(el) {
      el.addEventListener('mousedown', function(e) {
        erDragMoved = false;
      });
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        var key = el.getAttribute('data-model');
        selectModel(key);
      });
    });
  }

  var currentlySelected = null;

  function selectModel(key) {
    var g = document.getElementById('erSvgContent');
    var prevSel = g.querySelector('.er-model.sel');
    if (prevSel) prevSel.classList.remove('sel');
    g.querySelectorAll('.er-rel.highlighted').forEach(function(r) { r.classList.remove('highlighted'); });

    if (!key) return;
    currentlySelected = key;
    var el = g.querySelector('.er-model[data-model="'+key+'"]');
    if (el) el.classList.add('sel');

    g.querySelectorAll('.er-rel').forEach(function(r) {
      var from = r.getAttribute('data-from');
      var to = r.getAttribute('data-to');
      if (from === key || to === key) {
        r.classList.add('highlighted');
      }
    });

    showModelDetail(key);
  }

  function clearSelection() {
    var g = document.getElementById('erSvgContent');
    var prevSel = g.querySelector('.er-model.sel');
    if (prevSel) prevSel.classList.remove('sel');
    g.querySelectorAll('.er-rel.highlighted').forEach(function(r) { r.classList.remove('highlighted'); });
    currentlySelected = null;
    document.getElementById('archDetail').classList.remove('show');
  }

  function showModelDetail(key) {
    var m = MODEL_MAP[key]; if (!m) return;
    var card = document.getElementById('archDetail');
    document.getElementById('archDetailTitle').textContent = m.key;
    document.getElementById('archDetailMeta').textContent = m.coll + ' — ' + m.desc;

    var html = '<div class="arch-fields">';
    m.fields.forEach(function(f) {
      html += '<div class="arch-field-row">';
      html += '<span class="arch-field-name'+(f.pk?' arch-field-pk':'')+(f.ref?' arch-field-ref':'')+'">'+f.n+'</span>';
      var typeStr = f.t;
      if (f.req) typeStr += ' <span style="color:var(--clay);">*</span>';
      if (f.ref) typeStr += ' <span style="color:var(--blue);">→'+f.ref+'</span>';
      if (f.uniq) typeStr += ' <span style="color:var(--gold);">UQ</span>';
      html += '<span class="arch-field-type">'+typeStr+'</span>';
      html += '</div>';
    });
    html += '</div>';

    var refs = m.fields.filter(function(f){ return f.ref; });
    var refBy = ALL_MODELS.filter(function(om){ return om.key !== key && om.fields.some(function(f){ return f.ref === key; }); });
    if (refs.length || refBy.length) {
      html += '<div style="margin-top:12px;padding-top:8px;border-top:1px solid var(--line-soft);font-size:11px;">';
      if (refs.length) {
        html += '<div style="color:var(--muted);margin-bottom:4px;">References:</div>';
        refs.forEach(function(f){ html += '<div style="padding:2px 0;"><span style="color:var(--blue);">'+f.n+'</span> → <strong>'+f.ref+'</strong></div>'; });
      }
      if (refBy.length) {
        html += '<div style="color:var(--muted);margin:6px 0 4px;">Referenced by:</div>';
        refBy.forEach(function(om){ html += '<div style="padding:2px 0;"><strong>'+om.key+'</strong></div>'; });
      }
      html += '</div>';
    }

    document.getElementById('archDetailBody').innerHTML = html;
    card.classList.add('show');
  }

  document.getElementById('archThemeToggle').addEventListener('click', function() {
    var isDark = document.getElementById('archPage').classList.toggle('dark');
    localStorage.setItem('arch-theme', isDark ? 'dark' : 'light');
  });

  var erStage = document.getElementById('archERStage');
  var erContent = document.getElementById('erSvgContent');

  function erApplyTransform() {
    erContent.setAttribute('transform', 'translate('+erPanX+','+erPanY+') scale('+erScale+')');
    document.getElementById('erZoomVal').textContent = Math.round(erScale*100)+'%';
  }

  erStage.addEventListener('wheel', function(e) {
    e.preventDefault();
    var rect = erStage.getBoundingClientRect();
    var mx = e.clientX - rect.left, my = e.clientY - rect.top;
    var svg = document.getElementById('archERSvg');
    var vb = svg.viewBox.baseVal;
    var sx = vb.width/rect.width, sy = vb.height/rect.height;
    var svgX = mx*sx, svgY = my*sy;
    var old = erScale;
    var d = e.deltaY > 0 ? 0.9 : 1.1;
    erScale = Math.min(Math.max(erScale*d, 0.2), 5);
    var r = erScale/old;
    erPanX = svgX - r*(svgX - erPanX);
    erPanY = svgY - r*(svgY - erPanY);
    erApplyTransform();
  }, {passive:false});

  erStage.addEventListener('mousedown', function(e) {
    if (e.target.closest('.er-model') || e.target.closest('.arch-card')) return;
    erDragging = true; erDragMoved = false;
    erStartX = e.clientX; erStartY = e.clientY;
    erStage.classList.add('dragging');
  });
  window.addEventListener('mousemove', function(e) {
    if (!erDragging) return;
    var dx = e.clientX-erStartX, dy = e.clientY-erStartY;
    if (Math.abs(dx)>3||Math.abs(dy)>3) erDragMoved = true;
    var rect = erStage.getBoundingClientRect();
    var vb = document.getElementById('archERSvg').viewBox.baseVal;
    erPanX += dx*(vb.width/rect.width); erPanY += dy*(vb.height/rect.height);
    erStartX = e.clientX; erStartY = e.clientY;
    erApplyTransform();
  });
  window.addEventListener('mouseup', function() {
    if (erDragging) {
      erDragging = false;
      erStage.classList.remove('dragging');
    }
  });

  document.getElementById('erZoomIn').addEventListener('click', function(){erScale=Math.min(erScale*1.2,5);erApplyTransform();});
  document.getElementById('erZoomOut').addEventListener('click', function(){erScale=Math.max(erScale*0.8,0.2);erApplyTransform();});
  document.getElementById('erZoomReset').addEventListener('click', function(){erScale=1;erPanX=0;erPanY=0;erApplyTransform();});

  document.getElementById('archDetailClose').addEventListener('click', function() {
    clearSelection();
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.er-model') && !e.target.closest('.arch-card')) {
      clearSelection();
    }
  });

  renderER();
})();
</script>

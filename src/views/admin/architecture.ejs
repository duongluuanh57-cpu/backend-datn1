<div class="arch-page" id="archPage">
<script>
  (function () {
    var saved = localStorage.getItem('arch-theme');
    var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    document.getElementById('archPage').classList.toggle('dark', dark);
  })();
</script>
<style>
  .arch-page {
    --bg: #FAF9F5; --surface: #FFFFFF; --surface2: #F0EEE6;
    --ink: #141413; --body-text: #3D3D3A; --muted: #87867F;
    --line: #D1CFC5; --line-soft: #E6E3DA;
    --clay: #D97757; --clay-soft: rgba(217,119,87,0.10);
    --olive: #788C5D; --olive-soft: rgba(120,140,93,0.12);
    --gold: #C9A45C; --blue: #5B7E96; --blue-soft: rgba(91,126,150,0.10);
    --zone: rgba(20,20,19,0.025); --zone-line: #D1CFC5;
    --red: #B04A3F; --red-soft: rgba(176,74,63,0.08);
    --purple: #8B6DB0; --purple-soft: rgba(139,109,176,0.10);
    --serif: ui-serif, Georgia, "Times New Roman", serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    background: var(--bg); color: var(--body-text); font-family: var(--sans);
    display: flex; flex-direction: column;
    margin: -16px; padding: 0; min-height: calc(100vh - 120px);
  }
  .arch-page.dark {
    --bg: #141413; --surface: #1F1F1D; --surface2: #2A2A28;
    --ink: #FAF9F5; --body-text: #D1CFC5; --muted: #87867F;
    --line: #3D3D3A; --line-soft: #2A2A28;
    --clay: #E48A6E; --clay-soft: rgba(228,138,110,0.14);
    --olive: #9DB07C; --olive-soft: rgba(157,176,124,0.16);
    --gold: #D4B36F; --blue: #7FA3BC; --blue-soft: rgba(127,163,188,0.14);
    --zone: rgba(250,249,245,0.03); --zone-line: #3D3D3A;
    --red: #D0685E; --red-soft: rgba(208,104,94,0.12);
    --purple: #B08DD0; --purple-soft: rgba(176,141,208,0.14);
  }
  .arch-page * { box-sizing: border-box; }

  /* ── top bar ── */
  .arch-bar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 12px 20px; border-bottom: 1px solid var(--line-soft); flex: none; z-index: 10;
  }
  .arch-bar h1 { font-family: var(--serif); font-weight: 500; font-size: 19px; color: var(--ink); letter-spacing: -0.01em; margin:0; }
  .arch-bar .sub { font-family: var(--mono); font-size: 10.5px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; }
  .arch-spacer { flex: 1; }
  #archThemeToggle {
    font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em;
    padding: 5px 10px; border: 1px solid var(--line); border-radius: 6px;
    background: transparent; color: var(--muted); cursor: pointer;
  }
  #archThemeToggle:hover { color: var(--ink); border-color: var(--muted); }

  /* ── zoom indicator ── */
  .arch-zoom-bar {
    position: absolute; bottom: 16px; right: 16px; z-index: 20;
    display: flex; align-items: center; gap: 6px;
    font-family: var(--mono); font-size: 11px; color: var(--muted);
  }
  .arch-zoom-bar button {
    width: 28px; height: 28px; border: 1px solid var(--line); border-radius: 6px;
    background: var(--surface); color: var(--muted); cursor: pointer; font-size: 14px;
    display: flex; align-items: center; justify-content: center; transition: all .15s;
  }
  .arch-zoom-bar button:hover { color: var(--ink); border-color: var(--muted); }
  .arch-zoom-bar .arch-zoom-val { min-width: 40px; text-align: center; }

  /* ── view container ── */
  .arch-view { display: none; flex: 1; min-height: 0; }
  .arch-view.active { display: flex; flex-direction: column; }

  /* ── ER Diagram ── */
  .arch-er { flex: 1; position: relative; overflow: hidden; cursor: grab; }
  .arch-er.dragging { cursor: grabbing; }
  .arch-er svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .er-model { cursor: pointer; }
  .er-model rect.er-box { fill: var(--surface); stroke: var(--line); stroke-width: 1.5; rx: 8; transition: stroke .15s, filter .15s; }
  .er-model:hover rect.er-box { stroke: var(--muted); filter: drop-shadow(0 2px 8px rgba(0,0,0,0.06)); }
  .er-model.sel rect.er-box { stroke: var(--clay) !important; stroke-width: 2; }
  .er-model .er-hdr { font-family: var(--sans); font-size: 13px; font-weight: 700; fill: var(--ink); }
  .er-model .er-coll { font-family: var(--mono); font-size: 9px; fill: var(--muted); letter-spacing: 0.04em; }
  .er-model .er-field { font-family: var(--mono); font-size: 10px; fill: var(--body-text); }
  .er-model .er-type { font-family: var(--mono); font-size: 9px; fill: var(--muted); }
  .er-model .er-pk { fill: var(--gold); }
  .er-model .er-fk { fill: var(--blue); cursor: pointer; }
  .er-model .er-fk:hover { fill: var(--clay); }
  .er-rel { stroke: var(--muted); stroke-width: 1.2; fill: none; opacity: 0.4; transition: opacity .35s ease, stroke .35s ease, stroke-width .35s ease; }
  .er-rel:hover { opacity: 0.7; stroke: var(--clay); }
  .er-rel.highlighted { opacity: 1; stroke: var(--clay); stroke-width: 2.5; }
  .er-rel-label { font-family: var(--mono); font-size: 9px; fill: var(--muted); }

  /* ── floating card ── */
  .arch-card {
    position: absolute; max-width: 380px; z-index: 15;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px 18px; box-shadow: 0 6px 24px rgba(0,0,0,0.08);
  }
  .arch-card .arch-close {
    position: absolute; top: 8px; right: 10px; background: none; border: none;
    color: var(--muted); cursor: pointer; font-size: 16px; line-height: 1;
  }
  .arch-card .arch-close:hover { color: var(--ink); }
  #archDetail { right: 16px; top: 16px; width: 360px; display: none; }
  #archDetail.show { display: block; }
  #archDetail h3 { font-family: var(--serif); font-weight: 500; font-size: 16px; color: var(--ink); margin-bottom: 2px; }
  #archDetail .arch-meta { font-family: var(--mono); font-size: 10.5px; color: var(--muted); margin-bottom: 8px; }
  #archDetail .arch-fields { margin-top: 8px; }
  #archDetail .arch-field-row {
    display: flex; align-items: center; gap: 8px; padding: 3px 0;
    font-size: 12px; border-bottom: 1px solid var(--line-soft);
  }
  #archDetail .arch-field-row:last-child { border-bottom: none; }
  #archDetail .arch-field-name { font-family: var(--mono); font-weight: 500; color: var(--ink); min-width: 100px; }
  #archDetail .arch-field-type { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  #archDetail .arch-field-ref { font-family: var(--mono); font-size: 10px; color: var(--blue); }
  #archDetail .arch-field-pk { color: var(--gold); font-size: 9px; }
  #archDetail code { font-family: var(--mono); font-size: 11.5px; color: var(--clay); background: var(--clay-soft); padding: 1px 4px; border-radius: 3px; }
</style>

<div class="arch-bar">
  <div>
    <h1>Kiến trúc Hệ thống</h1>
    <div class="sub">L'essence Backend — Database Models & Relationships</div>
  </div>
  <div class="arch-spacer"></div>
  <button id="archThemeToggle">Theme</button>
</div>

<!-- ═══ ER DIAGRAM ═══ -->
<div class="arch-view active" id="archER">
  <div class="arch-er" id="archERStage">
    <svg viewBox="0 0 1400 1100" preserveAspectRatio="xMidYMid meet" id="archERSvg">
      <defs>
        <marker id="er-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--muted)"/>
        </marker>
        <marker id="er-arr-highlight" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--clay)"/>
        </marker>
      </defs>
      <g id="erSvgContent"></g>
    </svg>
    <div class="arch-zoom-bar">
      <button id="erZoomOut">&minus;</button>
      <span class="arch-zoom-val" id="erZoomVal">100%</span>
      <button id="erZoomIn">+</button>
      <button id="erZoomReset">&#8634;</button>
    </div>
  </div>
</div>

<div class="arch-card" id="archDetail">
  <button class="arch-close" id="archDetailClose">&times;</button>
  <h3 id="archDetailTitle"></h3>
  <div class="arch-meta" id="archDetailMeta"></div>
  <div id="archDetailBody"></div>
</div>
</div>

<%- include('admin/partials/architecture-script') %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-4">
    <h4 class="text-base font-semibold text-gray-900 flex items-center gap-2">
      Doanh thu & đơn hàng
      <button class="w-6 h-6 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 text-xs font-bold flex items-center justify-center" onclick="openHelp('revenue')" title="Tìm hiểu thêm">?</button>
    </h4>
    
    <!-- Custom Calendar Popup Trigger -->
    <div class="flex items-center gap-3">
      <div class="relative" id="revenueDatePickerWrapper">
        <button id="btnOpenRevenueCalendar" class="flex items-center gap-2 px-3 py-2 bg-white border border-gray-200 hover:border-gray-300 rounded-lg text-xs font-medium text-gray-700 shadow-sm transition-all cursor-pointer">
          <svg style="width:14px;height:14px;color:#9ca3af;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span id="lblRevenueDateRange">Chọn khoảng ngày</span>
          <svg style="width:12px;height:12px;color:#6b7280;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        
        <!-- Custom Calendar Dropdown Popup -->
        <div id="revenueCalendarPopup" class="absolute right-0 mt-2 bg-white rounded-xl shadow-xl border border-gray-200 p-4 z-50 hidden" style="width: 290px;">
        <!-- Calendar Header -->
        <div class="flex items-center justify-between mb-3">
          <button id="btnRevPrevMonth" type="button" class="p-1 hover:bg-gray-100 rounded text-gray-600 cursor-pointer">
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <span id="lblRevMonthYear" class="text-xs font-bold text-gray-800"></span>
          <button id="btnRevNextMonth" type="button" class="p-1 hover:bg-gray-100 rounded text-gray-600 cursor-pointer">
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
        
        <!-- Weekdays Header -->
        <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-gray-400 mb-2">
          <div>T2</div><div>T3</div><div>T4</div><div>T5</div><div>T6</div><div>T7</div><div class="text-red-500">CN</div>
        </div>
        
        <!-- Calendar Days Grid -->
        <div id="gridRevCalendarDays" class="grid grid-cols-7 gap-1 text-center text-xs"></div>
        
        <!-- Calendar Footer -->
        <div class="flex justify-end gap-2 mt-4 pt-3 border-t border-gray-100">
          <button id="btnRevCancelCalendar" type="button" class="px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-[10px] font-bold rounded cursor-pointer">Hủy</button>
          <button id="btnRevApplyCalendar" type="button" class="px-2.5 py-1 bg-gold-400 hover:bg-gold-500 text-white text-[10px] font-bold rounded cursor-pointer">Áp dụng</button>
        </div>
      </div> <!-- Closes revenueCalendarPopup -->
    </div> <!-- Closes revenueDatePickerWrapper -->
    
    <!-- Clear Filter Button -->
    <a id="revenue-clear-filter" href="#" class="filter-clear" onclick="resetRevenueFilters(event)">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      Xoá lọc
    </a>
  </div> <!-- Closes flex items-center gap-3 -->
</div> <!-- Closes header row -->
  
  <canvas id="chartRevenue7d" style="max-height:260px;"></canvas>
</div> <!-- Closes main card container -->
<%#
  AI auto-fill & fill-missing for product forms
  Requires: $, H, allBrands, allCategories, allTags, selectedCatNames, selectedTagSlugs, currentVariants, quill, PRODUCT_ID
%>
// ═══════════════════════════════════════════════════════════════
// AI FILL MISSING — only fills fields that are empty/incomplete
// ═══════════════════════════════════════════════════════════════
function fillMissing() {
  var btn = $('sd-btn-fill');
  var statusEl = $('sd-save-status');

  if (!PRODUCT_ID) {
    statusEl.textContent = 'Lưu sản phẩm trước rồi mới AI điền lại';
    statusEl.style.color = 'var(--danger)';
    setTimeout(function() { statusEl.textContent = ''; }, 3000);
    return;
  }

  // ── Check what's already filled ──
  var hasName = !!$('sd-name').value.trim();
  var hasBrand = !!$('sd-brand').value;
  var hasCategories = selectedCatNames.length >= 2;
  var hasTags = selectedTagSlugs.length >= 2;
  var hasDesc = quill && quill.root.innerHTML.trim() && quill.root.innerHTML.trim() !== '<p><br></p>' && quill.root.innerHTML.trim() !== '<p></p>';
  var hasVariants = currentVariants.some(function(v) { return v.size && v.price > 0; });

  // If everything is already filled, skip
  if (hasName && hasBrand && hasCategories && hasTags && hasDesc && hasVariants) {
    statusEl.textContent = '✅ Sản phẩm đã đủ thông tin, không cần AI điền';
    statusEl.style.color = '#16a34a';
    setTimeout(function() { statusEl.textContent = ''; }, 3000);
    return;
  }

  btn.disabled = true;
  btn.style.opacity = '0.6';
  statusEl.textContent = '⏳ AI đang xử lý...';
  statusEl.style.color = '#8b5cf6';

  fetch('/api/ai/admin/product-fill-missing', {
    method: 'POST',
    headers: H,
    body: JSON.stringify({ productId: PRODUCT_ID }),
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      btn.disabled = false;
      btn.style.opacity = '1';

      if (!res.success) {
        statusEl.textContent = 'Lỗi: ' + (res.message || 'AI không thể xử lý');
        statusEl.style.color = 'var(--danger)';
        return;
      }

      var data = res.data;
      if (!data || Object.keys(data).length === 0) {
        statusEl.textContent = res.message || 'Không có trường nào cần điền';
        statusEl.style.color = '#16a34a';
        return;
      }

      var filled = 0;

      // Name — only if empty
      if (!hasName && data.name) {
        $('sd-name').value = data.name;
        filled++;
      }

      // Brand — only if empty
      if (!hasBrand && data.brand && allBrands.length) {
        var foundBrand = allBrands.find(function(b) { return b.name.toLowerCase() === data.brand.toLowerCase(); });
        if (foundBrand) {
          $('sd-brand').value = foundBrand._id;
          filled++;
        }
      }

      // Categories — only if < 2
      if (!hasCategories && data.categories) {
        var newCats = data.categories.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
        newCats.forEach(function(name) {
          if (selectedCatNames.indexOf(name) === -1) {
            selectedCatNames.push(name);
            filled++;
          }
        });
        renderCategoryChips();
      }

      // Tags — only if < 2
      if (!hasTags && data.tags) {
        var newTags = data.tags.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
        newTags.forEach(function(name) {
          var slug = name.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
          if (selectedTagSlugs.indexOf(slug) === -1) {
            selectedTagSlugs.push(slug);
            filled++;
          }
        });
        // Ensure at least 2 tags
        if (selectedTagSlugs.length < 2) {
          var defaults = allTags.filter(function(t) { 
            return t.slug === 'san-pham-moi' || t.slug === 'hot' || t.slug === 'trending';
          });
          defaults.forEach(function(t) {
            if (selectedTagSlugs.length >= 2) return;
            if (selectedTagSlugs.indexOf(t.slug) === -1) selectedTagSlugs.push(t.slug);
          });
          if (selectedTagSlugs.length < 2) {
            allTags.forEach(function(t) {
              if (selectedTagSlugs.length >= 2) return;
              if (selectedTagSlugs.indexOf(t.slug) === -1) selectedTagSlugs.push(t.slug);
            });
          }
        }
        renderTagChips();
      }

      // Description (Quill) — only if empty
      if (!hasDesc && data.description) {
        if (quill) {
          quill.root.innerHTML = data.description;
          filled++;
        }
      }

      // Variants — only if no real variants
      if (!hasVariants && data.variants && Array.isArray(data.variants) && data.variants.length > 0) {
        currentVariants = data.variants.map(function(v) {
          return { size: v.size || '50ml', price: v.price || 0, quantityInStock: v.quantityInStock || 0, isDefault: false, _id: null };
        });
        if (currentVariants.length > 0) currentVariants[0].isDefault = true;
        renderVariants();
        filled++;
      }

      // Scent attributes — only if empty
      var scentKeys = ['longevity', 'sillage', 'scentTrail', 'style', 'suitableFor', 'occasion', 'season', 'time'];
      scentKeys.forEach(function(key) {
        if (data[key] && (!$('sd-' + key) || !$('sd-' + key).value)) {
          var el = $('sd-' + key);
          if (el) {
            el.value = data[key];
            filled++;
          }
        }
      });

      statusEl.textContent = '✅ AI đã điền ' + filled + ' trường';
      statusEl.style.color = '#16a34a';
      setTimeout(function() { statusEl.textContent = ''; }, 4000);
    })
    .catch(function() {
      btn.disabled = false;
      btn.style.opacity = '1';
      statusEl.textContent = 'Lỗi kết nối đến AI';
      statusEl.style.color = 'var(--danger)';
    });
}

// ═══════════════════════════════════════════════════════════════
// AUTO-FILL PRODUCT FROM NAME
// ═══════════════════════════════════════════════════════════════
var AUTO_FILL_BUSY = false;

function autoFillProduct(name) {
  if (AUTO_FILL_BUSY) return;
  var statusEl = $('sd-save-status');
  statusEl.textContent = '⏳ AI đang tạo thông tin...';
  statusEl.style.color = '#8b5cf6';
  AUTO_FILL_BUSY = true;

  var availableBrands = allBrands.map(function(b) { return b.name; });
  var availableCategories = allCategories.map(function(c) { return c.name; });
  var availableTags = allTags.map(function(t) { return t.name; });

  fetch('/api/ai/generate-product', {
    method: 'POST',
    headers: H,
    body: JSON.stringify({
      name: name,
      availableBrands: availableBrands,
      availableCategories: availableCategories,
      availableTags: availableTags,
    }),
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      AUTO_FILL_BUSY = false;
      if (!res.success) {
        statusEl.textContent = 'Lỗi: ' + (res.message || 'AI không thể xử lý');
        statusEl.style.color = 'var(--danger)';
        return;
      }
      fillForm(res.data);
      statusEl.textContent = '✅ AI đã điền thông tin';
      statusEl.style.color = '#16a34a';
      setTimeout(function() { statusEl.textContent = ''; }, 4000);
    })
    .catch(function() {
      AUTO_FILL_BUSY = false;
      statusEl.textContent = 'Lỗi kết nối đến AI';
      statusEl.style.color = 'var(--danger)';
    });
}

function calcRandomDiscount(price, tagName) {
  var tagSlug = '';
  if (tagName) {
    var found = allTags.find(function(t) { return t.name.toLowerCase() === tagName.toLowerCase(); });
    if (found) tagSlug = found.slug;
  }

  var min = 0, max = 0;
  if (tagSlug === 'giam-gia') {
    min = 20; max = 50;
  } else if (tagSlug === 'limited') {
    min = 0; max = 5;
  } else if (tagSlug === 'san-pham-moi') {
    min = 5; max = 15;
  } else if (tagSlug === 'trending') {
    min = 0; max = 5;
  } else {
    if (price >= 1000000) { min = 5; max = 10; }
    else { min = 0; max = 5; }
  }
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function fillForm(data) {
  if (!data) return;

  // Brand
  if (data.brand && allBrands.length) {
    var foundBrand = allBrands.find(function(b) { return b.name.toLowerCase() === data.brand.toLowerCase(); });
    if (foundBrand) $('sd-brand').value = foundBrand._id;
  }

  // Categories (dedup)
  if (data.category) {
    selectedCatNames = [...new Set(data.category.split(',').map(function(s) { return s.trim(); }).filter(Boolean))];
    renderCategoryChips();
  }

  // Tags (tối thiểu 2 tags)
  if (data.tag) {
    var tagNames = data.tag.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
    var selected = [];
    tagNames.forEach(function(tagName) {
      var foundTag = allTags.find(function(t) { return t.name.toLowerCase() === tagName.toLowerCase(); });
      if (foundTag && selected.indexOf(foundTag.slug) === -1) {
        selected.push(foundTag.slug);
      }
    });
    // Ensure at least 2 tags
    if (selected.length < 2) {
      // Try to add default tags like "san-pham-moi" or any available
      var defaults = allTags.filter(function(t) { 
        return t.slug === 'san-pham-moi' || t.slug === 'hot' || t.slug === 'trending';
      });
      defaults.forEach(function(t) {
        if (selected.length >= 2) return;
        if (selected.indexOf(t.slug) === -1) selected.push(t.slug);
      });
      // If still not enough, add first available tags
      if (selected.length < 2) {
        allTags.forEach(function(t) {
          if (selected.length >= 2) return;
          if (selected.indexOf(t.slug) === -1) selected.push(t.slug);
        });
      }
    }
    selectedTagSlugs = selected;
    renderTagChips();
  }

  // Description (Quill)
  if (data.description && quill) {
    quill.root.innerHTML = data.description;
  }

  // Variants from size string "50ml:100000, 100ml:200000"
  if (data.size) {
    var parts = data.size.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
    if (parts.length) {
      currentVariants = parts.map(function(p, i) {
        var sp = p.split(':');
        return {
          size: sp[0] ? sp[0].trim() : '50ml',
          price: sp[1] ? Number(sp[1]) : 0,
          quantityInStock: Math.floor(Math.random() * 50) + 10,
          isDefault: i === 0,
          _id: null,
        };
      });
      renderVariants();
    }
  }

  // Price from first variant
  var defaultVar = currentVariants.find(function(v) { return v.isDefault; }) || currentVariants[0];
  var price = defaultVar ? defaultVar.price : 0;

  // Discount
  var tagName = data.tag ? data.tag.split(',')[0].trim() : '';
  var discount = calcRandomDiscount(price, tagName);
  $('sd-discount').value = discount;

  // Discount dates
  if (discount > 0) {
    var now = new Date();
    var startDate = new Date(now.getTime() + Math.random() * 3 * 86400000);
    var endDate = new Date(startDate.getTime() + (7 + Math.floor(Math.random() * 7)) * 86400000);
    $('sd-discount-start').value = startDate.toISOString().split('T')[0];
    $('sd-discount-end').value = endDate.toISOString().split('T')[0];
  } else {
    $('sd-discount-start').value = '';
    $('sd-discount-end').value = '';
  }

  // Scent attributes
  var scentKeys = ['longevity', 'sillage', 'scentTrail', 'style', 'suitableFor', 'occasion', 'season', 'time'];
  scentKeys.forEach(function(key) {
    if (data[key]) {
      var el = $('sd-' + key);
      if (el) el.value = data[key];
    }
  });
}

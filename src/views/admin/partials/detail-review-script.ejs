<script>
var REVIEW_ID = '<%= reviewId %>';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

var ASPECT_LABELS = { quality: 'Chất lượng', longevity: 'Độ lưu hương', scent: 'Mùi hương', value: 'Giá trị', packaging: 'Bao bì', other: 'Khác' };

<%- include('admin/partials/shared-js-utils') %>

function renderStars(rating) {
  var s = '';
  for (var i = 1; i <= 5; i++) { s += i <= rating ? '<span class="rd-star">★</span>' : '<span class="rd-star-empty">★</span>'; }
  return s + ' <span style="font-size:13px;color:var(--text-muted);">(' + rating + ')</span>';
}

fetch('/api/reviews/detail/' + REVIEW_ID, { headers: H })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (!res.success || !res.data) {
      $('detail-loading').style.display = 'none';
      $('detail-error').style.display = 'block';
      $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy đánh giá</p><p style="margin-top:8px;font-size:13px;">Đánh giá có thể đã bị xóa hoặc không tồn tại.</p>';
      return;
    }
    var r = res.data;
    $('detail-breadcrumb').textContent = 'Đánh giá ' + (r.rating || '') + ' sao';
    document.title = 'Đánh giá — Admin';

    var statusBadge = r.status === 'visible'
      ? '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(34,197,94,0.12);color:#22c55e;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;"></span>Hiển thị</span>'
      : '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(239,68,68,0.12);color:#ef4444;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;"></span>Ẩn</span>';

    var anonBadge = r.isAnonymous ? '<span style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(148,163,184,0.12);color:#94a3b8;">Ẩn danh</span>' : '';
    var productName = (r.productId && r.productId.name) ? escapeHtml(r.productId.name) : '—';
    var userName = (r.userId && (r.userId.name || r.userId.email)) ? escapeHtml(r.userId.name || r.userId.email) : '—';
    var userEmail = (r.userId && r.userId.email) ? escapeHtml(r.userId.email) : '—';

    var aspectsHtml = '';
    if (r.aspects && r.aspects.length > 0) {
      aspectsHtml = '<div class="rd-card"><h3>Đánh giá chi tiết</h3><table class="rd-aspect-table"><thead><tr><th>Khía cạnh</th><th>Đánh giá</th><th>Nhận xét</th></tr></thead><tbody>';
      r.aspects.forEach(function(a) {
        aspectsHtml += '<tr><td style="font-weight:500;">' + escapeHtml(ASPECT_LABELS[a.name] || a.name) + '</td><td>' + renderStars(a.rating) + '</td><td>' + escapeHtml(a.comment || '') + '</td></tr>';
      });
      aspectsHtml += '</tbody></table></div>';
    }

    var overallHtml = (r.overallComment || r.comment)
      ? '<div class="rd-card"><h3>Nhận xét chung</h3><p style="font-size:14px;line-height:1.6;color:var(--text-primary);white-space:pre-wrap;">' + escapeHtml(r.overallComment || r.comment) + '</p></div>'
      : '';

    var imagesHtml = '';
    if (r.images && r.images.length > 0) {
      imagesHtml = '<div class="rd-card"><h3>Hình ảnh (' + r.images.length + ')</h3><div class="rd-gallery" style="display:flex;gap:8px;flex-wrap:wrap;">';
      r.images.forEach(function(img) {
        imagesHtml += '<img src="' + escapeHtml(img) + '" alt="" onclick="window.open(\'' + escapeHtml(img) + '\',\'_blank\')" onerror="this.style.display=\'none\'" />';
      });
      imagesHtml += '</div></div>';
    }

    var moderateBtnText = r.status === 'visible' ? 'Ẩn đánh giá này' : 'Hiện đánh giá này';
    var moderateBtnStyle = r.status === 'visible' ? 'background:#ef4444;color:#fff;' : 'background:#22c55e;color:#fff;';

    var html =
      '<div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;">' +
        '<div style="flex:1;min-width:280px;">' +
          '<h2 style="font-size:20px;font-weight:700;color:var(--text-primary);margin:0 0 16px;line-height:1.3;">' + renderStars(r.rating) + '</h2>' +
          '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:16px;">' + statusBadge + anonBadge + '</div>' +
          '<div style="display:flex;flex-direction:column;gap:8px;font-size:13px;">' +
            '<div><span style="color:var(--text-muted);min-width:100px;display:inline-block;">Sản phẩm:</span> <strong>' + productName + '</strong></div>' +
            '<div><span style="color:var(--text-muted);min-width:100px;display:inline-block;">Người dùng:</span> <strong>' + userName + '</strong> <span style="color:var(--text-muted);">' + userEmail + '</span></div>' +
            '<div><span style="color:var(--text-muted);min-width:100px;display:inline-block;">Ngày tạo:</span> ' + fmtDate(r.createdAt) + '</div>' +
            '<div><span style="color:var(--text-muted);min-width:100px;display:inline-block;">Cập nhật:</span> ' + fmtDate(r.updatedAt) + '</div>' +
            '<div><span style="color:var(--text-muted);min-width:100px;display:inline-block;">ID:</span> <span style="font-family:monospace;font-size:12px;">' + r._id + '</span></div>' +
          '</div>' +
          '<div style="margin-top:20px;">' +
            '<form method="POST" action="/admin/reviews/' + r._id + '/moderate" style="display:inline;">' +
              '<button type="submit" style="border:none;padding:10px 20px;border-radius:8px;font-weight:600;font-size:13px;cursor:pointer;' + moderateBtnStyle + '">' + moderateBtnText + '</button>' +
            '</form>' +
          '</div>' +
        '</div>' +
      '</div>' +
      overallHtml + aspectsHtml + imagesHtml;

    $('detail-loading').style.display = 'none';
    $('detail-content').style.display = 'block';
    $('detail-content').innerHTML = html;
  })
  .catch(function() {
    $('detail-loading').style.display = 'none';
    $('detail-error').style.display = 'block';
    $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Lỗi kết nối</p><p style="margin-top:8px;font-size:13px;">Không thể tải chi tiết đánh giá. Vui lòng thử lại.</p>';
  });
</script>

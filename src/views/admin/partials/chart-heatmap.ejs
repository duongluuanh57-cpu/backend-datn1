<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6" id="heatmapSection">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
    <h4 class="text-base font-semibold text-gray-900 flex items-center gap-2">
      Bản đồ nhiệt khung giờ vàng
      <button class="w-6 h-6 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 text-xs font-bold flex items-center justify-center" onclick="openHelp('heatmap')" title="Tìm hiểu thêm">?</button>
    </h4>
    <div class="flex gap-3 items-center flex-wrap">
      <div class="custom-select" id="heatmapBrandFilter" style="min-width:180px;">
        <button class="custom-select-trigger" type="button">
          <span class="custom-select-label">Chọn thương hiệu</span>
          <svg class="custom-select-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="custom-select-dropdown">
          <div class="custom-select-search-wrap"><input class="custom-select-search" type="text" placeholder="Tìm thương hiệu..."></div>
          <div class="custom-select-items"></div>
        </div>
      </div>
      <div class="metric-switcher" id="heatmapMetricSwitcher">
        <button class="metric-btn" data-metric="add_to_cart">Thêm giỏ hàng</button>
        <button class="metric-btn" data-metric="reach_checkout">Thanh toán</button>
        <button class="metric-btn active" data-metric="purchase">Mua hàng</button>
      </div>
    </div>
  </div>
  <div id="heatmapContainer" style="min-height:200px;"><p class="text-gray-400 text-center py-10">Đang tải...</p></div>
  <div id="heatmapLegend" class="mt-3"></div>
</div>
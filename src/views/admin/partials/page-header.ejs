<%#
  Shared page header — breadcrumb + back link + optional action button.
  Variables:
    backHref        — href of "Quay lại danh sách" link
    backLabel       — text of back link (default: 'Quay lại danh sách')
    breadcrumbId    — id of the <span> that JS will populate (optional)
    breadcrumbText  — static text if no JS populates it (optional)
    actionBtnId     — id of the action button/link (optional)
    actionBtnHref   — href (for <a> tag); if absent, renders <button>
    actionBtnLabel  — button label text
    actionBtnStyle  — extra inline style on action btn (optional)
    showActionBtn   — boolean (default false — JS will show it when data loads)
%>
<div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;flex-wrap:wrap;">
  <a href="<%= backHref %>"
     onclick="if(window.history.length>1){window.history.back();return false;}"
     style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;font-weight:500;padding:6px 12px;border-radius:8px;border:1px solid var(--border);"
     onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'"
     onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border)'">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <%= typeof backLabel !== 'undefined' ? backLabel : 'Quay lại danh sách' %>
  </a>
  <span style="color:var(--text-muted);">/</span>
  <% if (typeof breadcrumbId !== 'undefined' && breadcrumbId) { %>
    <span id="<%= breadcrumbId %>" style="color:var(--text-primary);font-weight:600;font-size:14px;"><%= typeof breadcrumbText !== 'undefined' ? breadcrumbText : 'Đang tải...' %></span>
  <% } else if (typeof breadcrumbText !== 'undefined') { %>
    <span style="color:var(--text-primary);font-weight:600;font-size:14px;"><%= breadcrumbText %></span>
  <% } %>
  <% if (typeof actionBtnId !== 'undefined' && actionBtnId) { %>
  <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
    <% if (typeof actionBtnHref !== 'undefined') { %>
    <a id="<%= actionBtnId %>"
       href="<%= typeof actionBtnHref !== 'undefined' ? actionBtnHref : '#' %>"
       style="<%= typeof showActionBtn !== 'undefined' && showActionBtn ? 'display:inline-flex;' : 'display:none;' %>align-items:center;gap:6px;padding:8px 16px;border-radius:8px;border:1px solid var(--accent);color:var(--accent);font-size:12px;font-weight:600;text-decoration:none;transition:all 0.2s;white-space:nowrap;<%= typeof actionBtnStyle !== 'undefined' ? actionBtnStyle : '' %>"
       onmouseover="this.style.background='rgba(201,169,110,0.06)'"
       onmouseout="this.style.background='transparent'">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <%= typeof actionBtnLabel !== 'undefined' ? actionBtnLabel : 'Chỉnh sửa' %>
    </a>
    <% } %>
  </div>
  <% } %>
</div>

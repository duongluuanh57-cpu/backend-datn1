<style>
  #brand-edit .dt-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;}
  #brand-edit .supp-form-group{display:flex;flex-direction:column;gap:6px;}
  #brand-edit .supp-form-group label{font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;}
  #brand-edit .supp-form-group input[type="text"],
  #brand-edit .supp-form-group select{
    padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:14px;color:var(--text-primary);
    background:var(--bg);outline:none;transition:border-color 0.2s;font-family:inherit;
  }
  #brand-edit .supp-form-group input[type="text"]:focus,
  #brand-edit .supp-form-group select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(201,169,110,0.1);}
</style>

<script>
var BRAND_ID = '<%= brandId || "" %>';
var IS_NEW = '<%= (typeof IS_NEW !== "undefined" && IS_NEW) ? true : false %>' === 'true';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };
var currentLogoUrl = '';

function $(id) { return document.getElementById(id); }
function escapeHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]||m; });
}

if (!IS_NEW && BRAND_ID) {
  fetch('/api/brands/' + BRAND_ID, { headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success || !res.data) {
        $('be-loading').style.display = 'none';
        $('be-error').style.display = 'block';
        $('be-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy thương hiệu</p><p style="margin-top:8px;font-size:13px;color:var(--text-muted);">Thương hiệu có thể đã bị xóa hoặc không tồn tại.</p>';
        return;
      }
      var b = res.data;
      $('be-breadcrumb').textContent = 'Chỉnh sửa · ' + (b.name || '');
      document.title = 'Chỉnh sửa ' + (b.name || 'Thương hiệu') + ' — Admin';
      $('be-name').value = b.name || '';
      $('be-origin').value = b.origin || '';
      $('be-status').value = b.status || 'active';
      $('be-featured').checked = !!b.featured;
      currentLogoUrl = b.logo || '';
      if (currentLogoUrl) { updateLogoPreview(currentLogoUrl); }
      $('be-loading').style.display = 'none';
      $('be-form').style.display = 'block';
    })
    .catch(function() {
      $('be-loading').style.display = 'none';
      $('be-error').style.display = 'block';
    });
}

function handleLogoUpload(event) {
  var file = event.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) { updateLogoPreview(e.target.result); };
  reader.readAsDataURL(file);
  var formData = new FormData();
  formData.append('file', file);
  $('be-upload-status').textContent = 'Đang tải lên...';
  $('be-upload-status').style.color = 'var(--text-muted)';
  fetch('/api/media/upload', { method: 'POST', headers: { 'Authorization': 'Bearer ' + TOKEN }, body: formData })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success && res.data && res.data.url) {
        currentLogoUrl = res.data.url;
        updateLogoPreview(currentLogoUrl);
        $('be-upload-status').textContent = '✅ Đã tải logo lên';
        $('be-upload-status').style.color = '#22c55e';
        $('be-delete-logo').style.display = 'flex';
      } else {
        $('be-upload-status').textContent = '❌ Lỗi tải lên: ' + (res.message || '');
        $('be-upload-status').style.color = '#ef4444';
      }
    })
    .catch(function() {
      $('be-upload-status').textContent = '❌ Lỗi kết nối';
      $('be-upload-status').style.color = '#ef4444';
    });
}

function updateLogoPreview(url) {
  if (!url) {
    $('be-logo-preview').innerHTML = '<span style="color:var(--text-muted);font-size:12px;">Chưa có logo</span>';
    $('be-delete-logo').style.display = 'none';
    return;
  }
  $('be-logo-preview').innerHTML = '<img src="' + escapeHtml(url) + '" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display=\'none\'" />';
  $('be-delete-logo').style.display = 'flex';
}

function deleteLogo() {
  currentLogoUrl = '';
  updateLogoPreview('');
  $('be-upload-status').textContent = 'Đã xóa logo';
  $('be-upload-status').style.color = 'var(--text-muted)';
}

function saveBrand() {
  var name = $('be-name').value.trim();
  if (!name) { showToast('Vui lòng nhập tên thương hiệu', 'error'); $('be-name').focus(); return; }
  var data = { name: name, origin: $('be-origin').value.trim(), status: $('be-status').value, featured: $('be-featured').checked };
  if (currentLogoUrl) { data.logo = currentLogoUrl; }
  var btn = $('be-btn-save');
  btn.disabled = true; btn.style.opacity = '0.6';
  $('be-save-status').textContent = 'Đang lưu...'; $('be-save-status').style.color = 'var(--text-muted)';
  var url = IS_NEW ? '/api/brands' : '/api/brands/' + BRAND_ID;
  var method = IS_NEW ? 'POST' : 'PATCH';
  fetch(url, { method: method, headers: { 'Authorization': 'Bearer ' + TOKEN, 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      btn.disabled = false; btn.style.opacity = '1';
      if (res.success) {
        $('be-save-status').textContent = '✅ Đã lưu!'; $('be-save-status').style.color = '#22c55e';
        if (IS_NEW) {
          var newId = res.data && (res.data._id || res.data.id);
          $('be-breadcrumb').textContent = 'Thêm thương hiệu · ' + escapeHtml(name);
          document.title = 'Thêm thương hiệu ' + name + ' — Admin';
          if (newId) { BRAND_ID = newId; }
          showToast('Đã tạo thương hiệu thành công!', 'success');
        } else {
          $('be-breadcrumb').textContent = 'Chỉnh sửa · ' + escapeHtml(name);
          document.title = 'Chỉnh sửa ' + name + ' — Admin';
          showToast('Đã cập nhật thương hiệu thành công!', 'success');
        }
      } else {
        $('be-save-status').textContent = '❌ ' + (res.message || 'Lỗi'); $('be-save-status').style.color = '#ef4444';
        showToast(res.message || ('Không thể ' + (IS_NEW ? 'tạo' : 'cập nhật') + ' thương hiệu'), 'error');
      }
    })
    .catch(function() {
      btn.disabled = false; btn.style.opacity = '1';
      $('be-save-status').textContent = '❌ Lỗi kết nối'; $('be-save-status').style.color = '#ef4444';
      showToast('Lỗi kết nối đến server', 'error');
    });
}
</script>

<script>window.__API_TOKEN__='<%= apiToken %>';</script>

<div id="flash-sale-list-app">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
    <div>
      <h2 style="font-size:20px;font-weight:700;margin:0 0 4px;color:var(--text-primary);">Sự kiện Flash Sale</h2>
      <p style="font-size:13px;color:var(--text-muted);margin:0;">Quản lý các chương trình Flash Sale khung giờ vàng</p>
    </div>
    <a href="/admin/flash-sales/create" style="display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border-radius:10px;background:var(--accent);color:#fff;font-weight:600;font-size:13px;text-decoration:none;box-shadow:0 4px 14px rgba(201,169,110,0.3);">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Tạo đợt Flash Sale mới
    </a>
  </div>

  <!-- Filters -->
  <div class="filter-bar" style="margin-bottom:20px;">
    <div class="filter-row">
      <div class="filter-search-wrap">
        <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="fs-search" class="filter-search" placeholder="Tìm tên sự kiện...">
      </div>
      <div class="filter-select-wrap">
        <select id="fs-status-filter" class="filter-select">
          <option value="all">Tất cả trạng thái</option>
          <option value="active">Đang diễn ra (Active)</option>
          <option value="scheduled">Sắp diễn ra (Scheduled)</option>
          <option value="ended">Đã kết thúc (Ended)</option>
          <option value="inactive">Đã ẩn (Inactive)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- List table -->
  <div class="table-card">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width:60px;">STT</th>
          <th>Tên sự kiện Flash Sale</th>
          <th>Thời gian bắt đầu</th>
          <th>Thời gian kết thúc</th>
          <th>Số sản phẩm</th>
          <th>Trạng thái</th>
          <th style="text-align:right;">Thao tác</th>
        </tr>
      </thead>
      <tbody id="fs-tbody">
        <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">Đang tải...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

function fmtDT(d) {
  if (!d) return '—';
  return new Date(d).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
}

function loadFlashSales() {
  var search = document.getElementById('fs-search').value.trim();
  var status = document.getElementById('fs-status-filter').value;
  var url = '/api/flash-sales/admin?search=' + encodeURIComponent(search) + '&status=' + encodeURIComponent(status);

  fetch(url, { headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success || !res.data) {
        document.getElementById('fs-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--danger);">Lỗi tải dữ liệu</td></tr>';
        return;
      }
      var items = res.data;
      if (items.length === 0) {
        document.getElementById('fs-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">Chưa có đợt Flash Sale nào</td></tr>';
        return;
      }
      var html = '';
      items.forEach(function(item, idx) {
        var statusBadges = {
          active: '<span style="background:rgba(34,197,94,0.15);color:#22c55e;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Đang diễn ra</span>',
          scheduled: '<span style="background:rgba(234,179,8,0.15);color:#eab308;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Sắp diễn ra</span>',
          ended: '<span style="background:rgba(148,163,184,0.15);color:#94a3b8;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Đã kết thúc</span>',
          inactive: '<span style="background:rgba(239,68,68,0.15);color:#ef4444;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Tắt</span>',
        };
        html += '<tr onclick="window.location.href=\'/admin/flash-sales/' + item._id + '/edit\'" style="cursor:pointer;" onmouseover="this.style.background=\'rgba(201,169,110,0.06)\'" onmouseout="this.style.background=\'transparent\'">' +
          '<td>' + (idx + 1) + '</td>' +
          '<td><strong style="color:var(--text-primary);">' + escapeHtml(item.name) + '</strong></td>' +
          '<td>' + fmtDT(item.startDate) + '</td>' +
          '<td>' + fmtDT(item.endDate) + '</td>' +
          '<td><span style="font-weight:600;color:var(--accent);">' + (item.items ? item.items.length : 0) + ' SP</span></td>' +
          '<td>' + (statusBadges[item.status] || item.status) + '</td>' +
          '<td style="text-align:right;" onclick="event.stopPropagation();">' +
            '<button onclick="deleteFlashSale(\'' + item._id + '\')" style="background:none;border:none;color:var(--danger);cursor:pointer;font-weight:600;padding:4px 8px;border-radius:6px;" onmouseover="this.style.background=\'rgba(239,68,68,0.1)\'" onmouseout="this.style.background=\'transparent\'">Xóa</button>' +
          '</td>' +
        '</tr>';
      });
      document.getElementById('fs-tbody').innerHTML = html;
    })
    .catch(function() {
      document.getElementById('fs-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--danger);">Lỗi kết nối</td></tr>';
    });
}

function deleteFlashSale(id) {
  if (!confirm('Bạn có chắc chắn muốn xóa sự kiện Flash Sale này?')) return;
  fetch('/api/flash-sales/admin/' + id, { method: 'DELETE', headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success) {
        showToast('Đã xóa thành công', 'success');
        loadFlashSales();
      } else {
        showToast(res.message || 'Không thể xóa', 'error');
      }
    });
}

document.getElementById('fs-search').addEventListener('input', loadFlashSales);
document.getElementById('fs-status-filter').addEventListener('change', loadFlashSales);
loadFlashSales();
</script>

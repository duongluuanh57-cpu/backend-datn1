<script>window.__API_TOKEN__='<%= apiToken %>';</script>

<div id="flash-sale-list-app">
  <!-- Filter Bar (2 rows, styled like Category / Voucher filter bar) -->
  <div class="filter-bar" style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
    <!-- Row 1: Ô tìm kiếm + Nút Tạo đợt Flash Sale mới -->
    <div class="filter-row filter-row-1" style="display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;">
      <div class="filter-search-wrap" style="flex:1;width:100%;">
        <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="fs-search" class="filter-search" placeholder="Tìm tên sự kiện..." style="width:100%;">
      </div>
      <div>
        <a href="/admin/flash-sales/create" class="btn-create-product" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:var(--accent);color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:all 0.2s;box-shadow:0 2px 8px rgba(201,169,110,0.25);" onmouseover="this.style.filter='brightness(1.1)'" onmouseout="this.style.filter='none'">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Thêm sự kiện mới
        </a>
      </div>
    </div>

    <!-- Row 2: Lọc Trạng thái + Nút Xóa Lọc + Tổng sự kiện -->
    <div class="filter-row filter-row-2" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding-top:4px;width:100%;">
      <div class="filter-select-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <select id="fs-status-filter" class="filter-select">
          <option value="all">Trạng thái</option>
          <option value="active">Đang diễn ra</option>
          <option value="scheduled">Sắp diễn ra</option>
          <option value="ended">Đã kết thúc</option>
          <option value="inactive">Đã ẩn</option>
        </select>
      </div>

      <a id="fs-clear-search" href="#" class="filter-clear" style="display:none;" onclick="event.preventDefault();clearFsFilters();">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        Xoá lọc
      </a>

      <div class="filter-actions" style="margin-left:auto;display:flex;align-items:center;">
        <span class="filter-total">Tổng sự kiện: <b id="fs-total-count">0</b></span>
      </div>
    </div>
  </div>

  <!-- List table -->
  <div class="table-card">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width:60px;">STT</th>
          <th>Tên sự kiện Flash Sale</th>
          <th>Thời gian bắt đầu</th>
          <th>Thời gian kết thúc</th>
          <th>Số sản phẩm</th>
          <th>Trạng thái</th>
          <th style="text-align:right;">Thao tác</th>
        </tr>
      </thead>
      <tbody id="fs-tbody">
        <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">Đang tải...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

function fmtDT(d) {
  if (!d) return '—';
  return new Date(d).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
}

function clearFsFilters() {
  document.getElementById('fs-search').value = '';
  document.getElementById('fs-status-filter').value = 'all';
  loadFlashSales();
}

function loadFlashSales() {
  var search = document.getElementById('fs-search').value.trim();
  var status = document.getElementById('fs-status-filter').value;

  var clearBtn = document.getElementById('fs-clear-search');
  if (clearBtn) {
    if (search || status !== 'all') clearBtn.style.display = 'inline-flex';
    else clearBtn.style.display = 'none';
  }

  var url = '/api/flash-sales/admin?search=' + encodeURIComponent(search) + '&status=' + encodeURIComponent(status);

  fetch(url, { headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success || !res.data) {
        document.getElementById('fs-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--danger);">Lỗi tải dữ liệu</td></tr>';
        document.getElementById('fs-total-count').textContent = '0';
        return;
      }
      var items = res.data;
      document.getElementById('fs-total-count').textContent = items.length;
      if (items.length === 0) {
        document.getElementById('fs-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">Chưa có đợt Flash Sale nào</td></tr>';
        return;
      }
      var html = '';
      items.forEach(function(item, idx) {
        var statusBadges = {
          active: '<span style="background:rgba(34,197,94,0.15);color:#22c55e;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Đang diễn ra</span>',
          scheduled: '<span style="background:rgba(234,179,8,0.15);color:#eab308;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Sắp diễn ra</span>',
          ended: '<span style="background:rgba(148,163,184,0.15);color:#94a3b8;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Đã kết thúc</span>',
          inactive: '<span style="background:rgba(239,68,68,0.15);color:#ef4444;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:600;">Tắt</span>',
        };
        html += '<tr onclick="window.location.href=\'/admin/flash-sales/' + item._id + '\'" style="cursor:pointer;" onmouseover="this.style.background=\'rgba(201,169,110,0.06)\'" onmouseout="this.style.background=\'transparent\'">' +
          '<td>' + (idx + 1) + '</td>' +
          '<td><strong style="color:var(--text-primary);">' + escapeHtml(item.name) + '</strong></td>' +
          '<td>' + fmtDT(item.startDate) + '</td>' +
          '<td>' + fmtDT(item.endDate) + '</td>' +
          '<td><span style="font-weight:600;color:var(--accent);">' + (item.items ? item.items.length : 0) + ' SP</span></td>' +
          '<td>' + (statusBadges[item.status] || item.status) + '</td>' +
          '<td style="text-align:right;" onclick="event.stopPropagation();">' +
            '<div class="row-actions-cell" style="display:flex;align-items:center;justify-content:flex-end;gap:6px;">' +
              '<a href="/admin/flash-sales/' + item._id + '/edit" class="btn-action-icon edit-btn" title="Chỉnh sửa" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);transition:all 0.2s;" onmouseover="this.style.color=\'#3b82f6\';this.style.borderColor=\'#3b82f6\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
                '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>' +
              '</a>' +
              '<button type="button" class="btn-action-icon delete-btn" title="Xóa" onclick="deleteFlashSale(\'' + item._id + '\')" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color=\'#ef4444\';this.style.borderColor=\'#ef4444\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
                '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
              '</button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      });
      document.getElementById('fs-tbody').innerHTML = html;
    })
    .catch(function() {
      document.getElementById('fs-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--danger);">Lỗi kết nối</td></tr>';
      document.getElementById('fs-total-count').textContent = '0';
    });
}

function deleteFlashSale(id) {
  if (!confirm('Bạn có chắc chắn muốn xóa sự kiện Flash Sale này?')) return;
  fetch('/api/flash-sales/admin/' + id, { method: 'DELETE', headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success) {
        showToast('Đã xóa thành công', 'success');
        loadFlashSales();
      } else {
        showToast(res.message || 'Không thể xóa', 'error');
      }
    });
}

document.getElementById('fs-search').addEventListener('input', loadFlashSales);
document.getElementById('fs-status-filter').addEventListener('change', loadFlashSales);
loadFlashSales();
</script>

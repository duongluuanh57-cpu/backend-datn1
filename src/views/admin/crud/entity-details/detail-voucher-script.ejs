<script>
var VOUCHER_ID = '<%= voucherId %>';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

<%- include('../../common/shared-js-utils') %>

fetch('/api/vouchers/' + VOUCHER_ID, { headers: H })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (!res.success || !res.data) {
      $('detail-loading').style.display = 'none';
      $('detail-error').style.display = 'block';
      $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy mã giảm giá</p><p style="margin-top:8px;font-size:13px;">Mã giảm giá có thể đã bị xóa hoặc không tồn tại.</p>';
      return;
    }
    var v = res.data;
    $('detail-breadcrumb').textContent = v.code || '';
    document.title = (v.code || 'Mã giảm giá') + ' — Admin';

    var editBtn = document.getElementById('edit-voucher-btn');
    if (editBtn) { editBtn.style.display = 'inline-flex'; editBtn.href = '/admin/vouchers/' + v._id + '/edit' + window.location.search; }

    var statusBadge = v.status === 'active'
      ? '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(34,197,94,0.12);color:#22c55e;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;"></span>Hoạt động</span>'
      : '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(239,68,68,0.12);color:#ef4444;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;"></span>Ẩn</span>';

    var scopeLabels = { all: 'Toàn sàn', membership: 'Hạng thành viên', minigame: 'Mini games' };
    var typeLabels = { percentage: 'Giảm theo phần trăm (%)', fixed: 'Giảm số tiền cố định (đ)' };
    var categoryLabels = { discount: 'Giảm giá tiền / phần trăm', freeship: 'Miễn phí vận chuyển (Freeship)' };

    var html =
      '<div class="dt-card">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:16px;">' +
          '<div>' +
            '<h2 style="font-size:24px;font-weight:700;color:var(--text-primary);margin:0 0 8px;font-family:monospace;">' + escapeHtml(v.code) + '</h2>' +
            '<div style="font-size:13px;color:var(--text-muted);">' + (scopeLabels[v.applicableTo] || v.applicableTo) + '</div>' +
          '</div>' +
          '<div>' + statusBadge + '</div>' +
        '</div>' +
        '<div class="info-grid">' +
          '<div class="info-item"><span class="info-label">Phân loại Voucher</span><span class="info-value" style="font-weight:600;color:var(--accent);">' + (categoryLabels[v.voucherCategory] || 'Giảm giá tiền / phần trăm') + '</span></div>';

    if (v.voucherCategory !== 'freeship') {
      html +=
          '<div class="info-item"><span class="info-label">Loại giảm giá</span><span class="info-value">' + (typeLabels[v.type] || v.type) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Giá trị</span><span class="info-value" style="font-size:16px;color:var(--accent);font-weight:700;">' + (v.type === 'percentage' ? v.value + '%' : fmtCurrency(v.value)) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Giảm giá tối đa</span><span class="info-value">' + (v.type === 'percentage' ? (v.maxDiscount ? fmtCurrency(v.maxDiscount) : 'Không giới hạn') : '—') + '</span></div>';
    }

    html +=
          '<div class="info-item"><span class="info-label">Đơn hàng tối thiểu</span><span class="info-value">' + fmtCurrency(v.minOrderAmount) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Số lượt sử dụng tối đa</span><span class="info-value">' + (v.maxUsage === 0 ? 'Không giới hạn' : v.maxUsage.toLocaleString()) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Số lượt đã dùng</span><span class="info-value">' + (v.usedCount || 0).toLocaleString() + '</span></div>';

    if (v.applicableTo === 'membership') {
      html += '<div class="info-item"><span class="info-label">Hạng thành viên tối thiểu</span><span class="info-value">' + escapeHtml(v.minTier || 'Không yêu cầu') + '</span></div>';
    }

    html +=
          '<div class="info-item"><span class="info-label">Mã ID hệ thống</span><span class="info-value" style="font-family:monospace;font-size:12px;">' + v._id + '</span></div>' +
          '<div class="info-item"><span class="info-label">Ngày bắt đầu</span><span class="info-value">' + fmtDateTime(v.startDate) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Ngày kết thúc</span><span class="info-value">' + fmtDateTime(v.endDate) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Ngày tạo</span><span class="info-value">' + fmtDate(v.createdAt) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Cập nhật lần cuối</span><span class="info-value">' + fmtDate(v.updatedAt) + '</span></div>' +
        '</div>' +
      '</div>';

    $('detail-loading').style.display = 'none';
    $('detail-content').style.display = 'block';
    $('detail-content').innerHTML = html;
  })
  .catch(function() {
    $('detail-loading').style.display = 'none';
    $('detail-error').style.display = 'block';
    $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Lỗi kết nối</p><p style="margin-top:8px;font-size:13px;">Không thể tải thông tin mã giảm giá. Vui lòng thử lại.</p>';
  });
</script>

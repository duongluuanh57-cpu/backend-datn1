<style>
  #brand-edit .dt-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;}
  #brand-edit .supp-form-group{display:flex;flex-direction:column;gap:6px;}
  #brand-edit .supp-form-group label{font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;}
  #brand-edit .supp-form-group input[type="text"],
  #brand-edit .supp-form-group select{
    padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:14px;color:var(--text-primary);
    background:var(--bg);outline:none;transition:border-color 0.2s;font-family:inherit;
  }
  #brand-edit .supp-form-group input[type="text"]:focus,
  #brand-edit .supp-form-group select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(201,169,110,0.1);}
</style>

<script>
<%- include('../../common/shared-js-utils') %>
var BRAND_ID = '<%= brandId || "" %>';
var IS_NEW = '<%= (typeof IS_NEW !== "undefined" && IS_NEW) ? true : false %>' === 'true';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };
var currentLogoUrl = '';

function updateBrandStatusToggle(checked) {
  var statusInput = $('be-status');
  var textEl = $('be-status-text');
  var sliderEl = $('be-status-slider');
  var thumbEl = $('be-status-thumb');
  if (checked) {
    if (statusInput) statusInput.value = 'active';
    if (textEl) { textEl.textContent = 'Hoạt động'; textEl.style.color = '#22c55e'; }
    if (sliderEl) sliderEl.style.background = '#22c55e';
    if (thumbEl) thumbEl.style.transform = 'translateX(20px)';
  } else {
    if (statusInput) statusInput.value = 'inactive';
    if (textEl) { textEl.textContent = 'Ẩn'; textEl.style.color = 'var(--text-muted)'; }
    if (sliderEl) sliderEl.style.background = 'var(--border)';
    if (thumbEl) thumbEl.style.transform = 'translateX(0)';
  }
}

var allExistingBrands = [];
function fetchAllExistingBrands() {
  fetch('/api/brands', { headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      allExistingBrands = res.data && res.data.items ? res.data.items : (res.data || []);
    }).catch(function() {});
}

function checkDuplicateName(nameVal) {
  var warningEl = $('be-name-dup-warning');
  if (!warningEl) return false;
  if (!nameVal) {
    warningEl.style.display = 'none';
    return false;
  }
  var norm = nameVal.toLowerCase().trim();
  var isDup = allExistingBrands.some(function(b) {
    if (!IS_NEW && (b._id === BRAND_ID || b.id === BRAND_ID)) return false;
    return (b.name || '').toLowerCase().trim() === norm;
  });

  if (isDup) {
    warningEl.style.display = 'block';
  } else {
    warningEl.style.display = 'none';
  }
  return isDup;
}

var autoFillTimer = null;

function wireAutoFill() {
  var nameEl = $('be-name');
  var slugEl = $('be-slug');
  var originEl = $('be-origin');
  if (!nameEl) return;

  fetchAllExistingBrands();

  if (slugEl) {
    slugEl.addEventListener('input', function() { this.dataset.edited = 'true'; });
  }
  if (originEl) {
    originEl.addEventListener('input', function() { this.dataset.edited = 'true'; });
  }

  nameEl.addEventListener('input', function() {
    var val = this.value.trim();
    if (slugEl && !slugEl.dataset.edited) {
      slugEl.value = slugify(val);
    }
    clearTimeout(autoFillTimer);
    autoFillTimer = setTimeout(function() {
      checkDuplicateName(val);
      autoFillOrigin(val);
    }, 700);
  });

  nameEl.addEventListener('blur', function() {
    var val = this.value.trim();
    clearTimeout(autoFillTimer);
    checkDuplicateName(val);
    autoFillOrigin(val);
  });
}

function autoFillOrigin(nameVal) {
  var originEl = $('be-origin');
  var badgeEl = $('be-ai-badge');
  if (!originEl || originEl.dataset.edited) return;
  if (!nameVal || nameVal.trim().length < 2) return;

  var norm = nameVal.toLowerCase().trim();

  // Thông báo Toast AI đang xử lý
  showToast('✨ AI đang tự động điền thông tin...', 'info');

  var found = BRAND_ORIGIN_MAP[norm];
  if (!found && norm.length >= 3) {
    for (var k in BRAND_ORIGIN_MAP) {
      if (k === norm || norm.indexOf(k) !== -1 || k.indexOf(norm) !== -1) {
        found = BRAND_ORIGIN_MAP[k];
        break;
      }
    }
  }

  // Fallback thông minh nếu thương hiệu mới không có trong từ điển mẫu
  if (!found) {
    if (norm.indexOf('lab') !== -1 || norm.indexOf('co') !== -1 || norm.indexOf('inc') !== -1) {
      found = 'Mỹ';
    } else if (norm.indexOf('maison') !== -1 || norm.indexOf('paris') !== -1 || norm.indexOf('parfum') !== -1) {
      found = 'Pháp';
    }
  }

  if (found) {
    originEl.value = found;
    if (badgeEl) badgeEl.style.display = 'inline-flex';
    setTimeout(function() {
      showToast('✨ AI đã điền xuất xứ (' + found + ') và slug!', 'success');
    }, 300);
  } else {
    setTimeout(function() {
      showToast('✨ AI đã tạo slug tự động!', 'success');
    }, 300);
  }
}

if (!IS_NEW && BRAND_ID) {
  fetch('/api/brands/' + BRAND_ID, { headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success || !res.data) {
        $('be-loading').style.display = 'none';
        $('be-error').style.display = 'block';
        $('be-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy thương hiệu</p><p style="margin-top:8px;font-size:13px;color:var(--text-muted);">Thương hiệu có thể đã bị xóa hoặc không tồn tại.</p>';
        return;
      }
      var b = res.data;
      $('be-breadcrumb').textContent = 'Chỉnh sửa · ' + (b.name || '');
      document.title = 'Chỉnh sửa ' + (b.name || 'Thương hiệu') + ' — Admin';
      $('be-name').value = b.name || '';
      if ($('be-slug')) { $('be-slug').value = b.slug || slugify(b.name || ''); }
      $('be-origin').value = b.origin || '';
      var statusVal = b.status || 'active';
      var isChecked = statusVal === 'active';
      $('be-status-toggle').checked = isChecked;
      updateBrandStatusToggle(isChecked);
      $('be-featured').checked = !!b.featured;
      currentLogoUrl = b.logo || '';
      if (currentLogoUrl) { updateLogoPreview(currentLogoUrl); }
      wireAutoFill();
      $('be-loading').style.display = 'none';
      $('be-form').style.display = 'block';
    })
    .catch(function() {
      $('be-loading').style.display = 'none';
      $('be-error').style.display = 'block';
    });
} else {
  document.addEventListener('DOMContentLoaded', function() {
    wireAutoFill();
    if ($('be-status-toggle')) {
      $('be-status-toggle').checked = true;
      updateBrandStatusToggle(true);
    }
  });
}

function handleLogoUpload(event) {
  var file = event.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) { updateLogoPreview(e.target.result); };
  reader.readAsDataURL(file);
  var formData = new FormData();
  formData.append('file', file);
  $('be-upload-status').textContent = 'Đang tải lên...';
  $('be-upload-status').style.color = 'var(--text-muted)';
  fetch('/api/media/upload', { method: 'POST', headers: { 'Authorization': 'Bearer ' + TOKEN }, body: formData })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success && res.data && res.data.url) {
        currentLogoUrl = res.data.url;
        updateLogoPreview(currentLogoUrl);
        $('be-upload-status').textContent = '✅ Đã tải logo lên';
        $('be-upload-status').style.color = '#22c55e';
        $('be-delete-logo').style.display = 'flex';
      } else {
        $('be-upload-status').textContent = '❌ Lỗi tải lên: ' + (res.message || '');
        $('be-upload-status').style.color = '#ef4444';
      }
    })
    .catch(function() {
      $('be-upload-status').textContent = '❌ Lỗi kết nối';
      $('be-upload-status').style.color = '#ef4444';
    });
}

function updateLogoPreview(url) {
  if (!url) {
    $('be-logo-preview').innerHTML = '<span style="color:var(--text-muted);font-size:12px;">Chưa có logo</span>';
    $('be-delete-logo').style.display = 'none';
    return;
  }
  $('be-logo-preview').innerHTML = '<img src="' + escapeHtml(url) + '" alt="" style="width:100%;height:100%;object-fit:contain;" onerror="this.style.display=\'none\'" />';
  $('be-delete-logo').style.display = 'flex';
}

function deleteLogo() {
  currentLogoUrl = '';
  updateLogoPreview('');
  $('be-upload-status').textContent = 'Đã xóa logo';
  $('be-upload-status').style.color = 'var(--text-muted)';
}

function saveBrand() {
  var name = $('be-name').value.trim();
  if (!name) { showToast('Vui lòng nhập tên thương hiệu', 'error'); $('be-name').focus(); return; }
  if (checkDuplicateName(name)) {
    showToast('Tên thương hiệu đã tồn tại trên hệ thống!', 'error');
    $('be-name').focus();
    return;
  }
  var slugVal = ($('be-slug') && $('be-slug').value.trim()) ? $('be-slug').value.trim() : slugify(name);
  var data = { name: name, slug: slugVal, origin: $('be-origin').value.trim(), status: $('be-status').value, featured: $('be-featured').checked };
  if (currentLogoUrl) { data.logo = currentLogoUrl; }
  var btn = $('be-btn-save');
  btn.disabled = true; btn.style.opacity = '0.6';
  $('be-save-status').textContent = 'Đang lưu...'; $('be-save-status').style.color = 'var(--text-muted)';
  var url = IS_NEW ? '/api/brands' : '/api/brands/' + BRAND_ID;
  var method = IS_NEW ? 'POST' : 'PATCH';
  fetch(url, { method: method, headers: { 'Authorization': 'Bearer ' + TOKEN, 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      btn.disabled = false; btn.style.opacity = '1';
      if (res.success) {
        $('be-save-status').textContent = '✅ Đã lưu!'; $('be-save-status').style.color = '#22c55e';
        if (IS_NEW) {
          showToast('Đã tạo thương hiệu thành công!', 'success');
        } else {
          showToast('Đã cập nhật thương hiệu thành công!', 'success');
        }
        setTimeout(function() {
          window.location.href = '/admin/brands';
        }, 600);
      } else {
        $('be-save-status').textContent = '❌ ' + (res.message || 'Lỗi'); $('be-save-status').style.color = '#ef4444';
        showToast(res.message || ('Không thể ' + (IS_NEW ? 'tạo' : 'cập nhật') + ' thương hiệu'), 'error');
      }
    })
    .catch(function() {
      btn.disabled = false; btn.style.opacity = '1';
      $('be-save-status').textContent = '❌ Lỗi kết nối'; $('be-save-status').style.color = '#ef4444';
      showToast('Lỗi kết nối đến server', 'error');
    });
}
</script>

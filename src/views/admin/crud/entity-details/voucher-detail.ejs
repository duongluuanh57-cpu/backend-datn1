<div id="voucher-detail">
  <style>
    #voucher-detail .dt-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
    #voucher-detail .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    #voucher-detail .info-item { display: flex; flex-direction: column; gap: 4px; }
    #voucher-detail .info-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    #voucher-detail .info-value { font-size: 14px; color: var(--text-primary); font-weight: 500; }
  </style>

  <%- include('../../common/page-header', {
    backHref: '/admin/vouchers',
    breadcrumbId: 'detail-breadcrumb',
    actionBtnId: 'edit-voucher-btn',
    actionBtnHref: '#',
    actionBtnLabel: 'Chỉnh sửa'
  }) %>

  <%- include('../../common/page-loading', {
    loadingId: 'detail-loading',
    errorId: 'detail-error',
    loadingText: 'Đang tải thông tin mã giảm giá...'
  }) %>

  <div id="detail-content" style="display:none;"></div>
</div>

<%- include('./detail-voucher-script') %>

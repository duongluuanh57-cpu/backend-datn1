<script>
var CATEGORY_ID = '<%= categoryId %>';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

<%- include('../../common/shared-js-utils') %>

fetch('/api/categories/' + CATEGORY_ID, { headers: H })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (!res.success || !res.data) {
      $('detail-loading').style.display = 'none';
      $('detail-error').style.display = 'block';
      $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy danh mục</p><p style="margin-top:8px;font-size:13px;">Danh mục có thể đã bị xóa hoặc không tồn tại.</p>';
      return;
    }
    var c = res.data;
    $('detail-breadcrumb').textContent = c.name || '';
    document.title = (c.name || 'Danh mục') + ' — Admin';

    var editBtn = document.getElementById('edit-category-btn');
    if (editBtn) { editBtn.style.display = 'inline-flex'; editBtn.href = '/admin/categories/' + c._id + '/edit'; }

    var statusBadge = c.status === 'active'
      ? '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(34,197,94,0.12);color:#22c55e;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;"></span>Hoạt động</span>'
      : '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(239,68,68,0.12);color:#ef4444;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;"></span>Ẩn</span>';

    var html =
      '<div style="display:grid;grid-template-columns:1fr;gap:24px;align-items:start;">' +
        '<div>' +
          '<h2 style="font-size:22px;font-weight:700;color:var(--text-primary);margin:0 0 16px;line-height:1.3;">' + escapeHtml(c.name) + '</h2>' +
          '<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;">' + statusBadge + '</div>' +
          '<div style="display:flex;flex-direction:column;gap:10px;font-size:13px;">' +
            '<div style="display:flex;gap:12px;"><span style="color:var(--text-muted);min-width:110px;">Slug:</span> <span style="font-family:monospace;background:var(--surface);padding:2px 8px;border-radius:4px;border:1px solid var(--border);">' + escapeHtml(c.slug || '—') + '</span></div>' +
            '<div style="display:flex;gap:12px;"><span style="color:var(--text-muted);min-width:110px;">ID:</span> <span style="font-family:monospace;font-size:12px;">' + c._id + '</span></div>' +
            '<div style="display:flex;gap:12px;"><span style="color:var(--text-muted);min-width:110px;">Ngày tạo:</span> ' + fmtDate(c.createdAt) + '</div>' +
            '<div style="display:flex;gap:12px;"><span style="color:var(--text-muted);min-width:110px;">Cập nhật:</span> ' + fmtDate(c.updatedAt) + '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

    $('detail-loading').style.display = 'none';
    $('detail-content').style.display = 'block';
    $('detail-content').innerHTML = html;
  })
  .catch(function() {
    $('detail-loading').style.display = 'none';
    $('detail-error').style.display = 'block';
    $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Lỗi kết nối</p><p style="margin-top:8px;font-size:13px;">Không thể tải thông tin danh mục. Vui lòng thử lại.</p>';
  });
</script>

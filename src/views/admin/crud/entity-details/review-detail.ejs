<div id="review-detail">
  <style>
    .rd-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;margin-top:24px;}
    .rd-card h3{font-size:15px;font-weight:600;margin:0 0 12px;color:var(--text-primary);}
    .rd-aspect-table{width:100%;border-collapse:collapse;font-size:13px;}
    .rd-aspect-table th,.rd-aspect-table td{padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);}
    .rd-aspect-table th{color:var(--text-muted);font-weight:500;font-size:12px;text-transform:uppercase;letter-spacing:0.5px;}
    .rd-star{color:#f59e0b;font-size:16px;}
    .rd-star-empty{color:var(--border);font-size:16px;}
    .rd-gallery img{width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:transform 0.2s;}
    .rd-gallery img:hover{transform:scale(1.1);}
  </style>

  <%- include('../../common/page-header', {
    backHref: '/admin/reviews',
    breadcrumbId: 'detail-breadcrumb'
  }) %>

  <%- include('../../common/page-loading', {
    loadingId: 'detail-loading',
    errorId: 'detail-error',
    loadingText: 'Đang tải chi tiết đánh giá...'
  }) %>

  <div id="detail-content" style="display:none;"></div>
</div>

<%- include('./detail-review-script') %>
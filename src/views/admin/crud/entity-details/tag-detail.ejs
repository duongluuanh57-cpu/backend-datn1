<div id="tag-detail">
  <style>
    .product-list-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:8px;border:1px solid var(--border);background:var(--bg);transition:all 0.2s;}
    .product-list-item:hover{border-color:var(--accent);background:rgba(201,169,110,0.04);}
    .product-list-item img{width:40px;height:40px;object-fit:cover;border-radius:6px;background:var(--surface);}
    .product-list-info{flex:1;min-width:0;}
    .product-list-info .name{font-size:13px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .product-list-info .price{font-size:12px;color:var(--text-muted);margin-top:2px;}
    .product-list-link{text-decoration:none;color:inherit;display:flex;align-items:center;gap:12px;flex:1;min-width:0;}
  </style>

  <%- include('../../common/page-header', {
    backHref: '/admin/tags',
    breadcrumbId: 'detail-breadcrumb',
    actionBtnId: 'edit-tag-btn',
    actionBtnHref: '#',
    actionBtnLabel: 'Chỉnh sửa'
  }) %>

  <%- include('../../common/page-loading', {
    loadingId: 'detail-loading',
    errorId: 'detail-error',
    loadingText: 'Đang tải thông tin tag...'
  }) %>

  <div id="detail-content" style="display:none;"></div>
</div>

<%- include('./detail-tag-script') %>
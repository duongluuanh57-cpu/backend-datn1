<div id="voucher-edit">
  <!-- ── Header ── -->
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;flex-wrap:wrap;">
    <a href="/admin/vouchers" onclick="if(window.history.length>1){window.history.back();return false;}" style="display:inline-flex;align-items:center;gap:6px;color:var(--text-muted);text-decoration:none;font-size:13px;font-weight:500;padding:6px 12px;border-radius:8px;border:1px solid var(--border);" onmouseover="this.style.color='var(--accent)';this.style.borderColor='var(--accent)'" onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border)'">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Quay lại danh sách
    </a>
    <span style="color:var(--text-muted);">/</span>
    <span id="ve-breadcrumb" style="color:var(--text-primary);font-weight:600;font-size:14px;"><%= IS_NEW ? 'Thêm mã giảm giá mới' : 'Đang tải...' %></span>
    <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
      <span id="ve-save-status" style="font-size:12px;"></span>
      <button type="button" id="ve-btn-save" onclick="saveVoucher()"
        style="display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border:none;border-radius:8px;background:var(--accent);color:#fff;cursor:pointer;font-size:12px;font-weight:600;transition:all 0.2s;box-shadow:0 2px 8px rgba(201,169,110,0.25);white-space:nowrap;"
        onmouseover="this.style.filter='brightness(1.1)'" onmouseout="this.style.filter=''">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        <%= IS_NEW ? 'Tạo mã' : 'Lưu thay đổi' %>
      </button>
    </div>
  </div>

  <% if (!IS_NEW) { %>
  <%- include('../../common/page-loading', { loadingId: 've-loading', errorId: 've-error', loadingText: 'Đang tải thông tin mã giảm giá...' }) %>
  <% } %>

  <!-- ── Form ── -->
  <div id="ve-form" style="<%= IS_NEW ? 'display:block;' : 'display:none;' %>">
    <form id="voucher-edit-form" onsubmit="event.preventDefault();">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;align-items:start;">

        <!-- LEFT: Basic settings -->
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="dt-card">
            <h3 style="font-size:14px;font-weight:600;margin:0 0 16px;color:var(--text-primary);">Thông tin cơ bản</h3>
            <div style="display:flex;flex-direction:column;gap:12px;">
              <div class="supp-form-group">
                <label>Mã giảm giá (Code)</label>
                <input type="text" id="ve-code" placeholder="VD: GIARE50K" style="text-transform:uppercase;" <%= !IS_NEW ? 'disabled style="background:var(--bg-muted);"' : '' %> />
              </div>
              <div class="supp-form-group">
                <label>Phân loại Voucher</label>
                <select id="ve-voucherCategory" onchange="toggleVoucherCategoryFields()">
                  <option value="discount">Giảm giá tiền / phần trăm</option>
                  <option value="freeship">Miễn phí vận chuyển (Freeship)</option>
                </select>
              </div>
              <div id="discount-fields-container" style="display:flex;flex-direction:column;gap:12px;">
                <div class="supp-form-group">
                  <label>Loại giảm giá</label>
                  <select id="ve-type" onchange="toggleTypeFields()">
                    <option value="fixed">Số tiền cố định (đ)</option>
                    <option value="percentage">Phần trăm (%)</option>
                  </select>
                </div>
                <div class="supp-form-group"><label>Giá trị giảm</label><input type="text" id="ve-value" placeholder="VD: 50.000đ" /></div>
                <div class="supp-form-group" id="max-discount-group" style="display:none;"><label>Mức giảm tối đa (đ)</label><input type="text" id="ve-maxDiscount" placeholder="Để trống nếu không giới hạn" /></div>
              </div>
            </div>
          </div>

          <div class="dt-card">
            <h3 style="font-size:14px;font-weight:600;margin:0 0 16px;color:var(--text-primary);">Thời hạn hoạt động</h3>
            <div style="display:flex;flex-direction:column;gap:12px;">
              <div class="supp-form-group"><label>Ngày bắt đầu</label><input type="datetime-local" id="ve-startDate" /></div>
              <div class="supp-form-group"><label>Ngày kết thúc</label><input type="datetime-local" id="ve-endDate" /></div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Scope and Limits -->
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="dt-card">
            <h3 style="font-size:14px;font-weight:600;margin:0 0 16px;color:var(--text-primary);">Điều kiện & Giới hạn</h3>
            <div style="display:flex;flex-direction:column;gap:12px;">
              <div class="supp-form-group">
                <label>Phân loại (Áp dụng cho)</label>
                <select id="ve-applicableTo" onchange="toggleScopeFields()">
                  <option value="all">Toàn sàn (all)</option>
                  <option value="membership">Hạng thành viên (membership)</option>
                  <option value="minigame">Mini games (minigame)</option>
                </select>
              </div>
              <div class="supp-form-group" id="min-tier-group" style="display:none;">
                <label>Hạng tối thiểu</label>
                <select id="ve-minTier">
                  <option value="">Không yêu cầu</option>
                  <option value="MEMBER">MEMBER</option>
                  <option value="Bac">Bạc</option>
                  <option value="Vang">Vàng</option>
                  <option value="KimCuong">Kim Cương</option>
                </select>
              </div>
              <div class="supp-form-group"><label>Giá trị đơn hàng tối thiểu (đ)</label><input type="text" id="ve-minOrderAmount" placeholder="VD: 100.000đ" /></div>
              <div class="supp-form-group"><label>Số lượt sử dụng tối đa</label><input type="number" id="ve-maxUsage" placeholder="Để trống nếu không giới hạn" min="0" /></div>
              <div class="supp-form-group">
                <label>Trạng thái</label>
                <select id="ve-status"><option value="active">Hoạt động</option><option value="inactive">Ẩn</option></select>
              </div>
            </div>
          </div>
        </div>

      </div>
    </form>
  </div>
</div>

<%- include('./edit-voucher-script') %>

<script>
var FLASH_SALE_ID = '<%= flashSaleId %>';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

<%- include('../../common/shared-js-utils') %>

fetch('/api/flash-sales/admin/' + FLASH_SALE_ID, { headers: H })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (!res.success || !res.data) {
      $('detail-loading').style.display = 'none';
      $('detail-error').style.display = 'block';
      $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy đợt Flash Sale</p><p style="margin-top:8px;font-size:13px;">Chương trình Flash Sale có thể đã bị xóa hoặc không tồn tại.</p>';
      return;
    }
    var fs = res.data;
    var nameStr = fs.name || 'Sự kiện Flash Sale';
    $('detail-breadcrumb').textContent = nameStr;
    document.title = nameStr + ' — Chi tiết Flash Sale';

    var editBtn = document.getElementById('edit-flash-sale-btn');
    if (editBtn) {
      editBtn.style.display = 'inline-flex';
      editBtn.href = '/admin/flash-sales/' + fs._id + '/edit';
    }

    var statusBadges = {
      active: '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12.5px;font-weight:600;background:rgba(34,197,94,0.12);color:#22c55e;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;"></span>Đang diễn ra</span>',
      scheduled: '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12.5px;font-weight:600;background:rgba(234,179,8,0.12);color:#eab308;"><span style="width:6px;height:6px;border-radius:50%;background:#eab308;"></span>Sắp diễn ra</span>',
      ended: '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12.5px;font-weight:600;background:rgba(148,163,184,0.12);color:#94a3b8;"><span style="width:6px;height:6px;border-radius:50%;background:#94a3b8;"></span>Đã kết thúc</span>',
      inactive: '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12.5px;font-weight:600;background:rgba(239,68,68,0.12);color:#ef4444;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;"></span>Đã tắt</span>',
    };

    var items = fs.items || [];

    var html =
      '<div class="dt-card">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:16px;flex-wrap:wrap;gap:12px;">' +
          '<div>' +
            '<h2 style="font-size:22px;font-weight:700;color:var(--text-primary);margin:0 0 6px;">' + escapeHtml(nameStr) + '</h2>' +
            '<div style="font-size:13px;color:var(--text-muted);">' + (fs.description ? escapeHtml(fs.description) : 'Không có mô tả phụ') + '</div>' +
          '</div>' +
          '<div>' + (statusBadges[fs.status] || fs.status) + '</div>' +
        '</div>' +
        '<div class="info-grid">' +
          '<div class="info-item"><span class="info-label">Thời gian bắt đầu</span><span class="info-value" style="font-weight:600;color:var(--accent);">' + fmtDateTime(fs.startDate) + '</span></div>' +
          '<div class="info-item"><span class="info-label">Thời gian kết thúc</span><span class="info-value" style="font-weight:600;color:var(--accent);">' + fmtDateTime(fs.endDate) + '</span></div>' +
          '<div class="info-item"><span class="info-label">% Giảm mặc định</span><span class="info-value" style="font-size:16px;color:#22c55e;font-weight:700;">' + (fs.extraDiscountPercentage || 10) + '%</span></div>' +
          '<div class="info-item"><span class="info-label">Số sản phẩm áp dụng</span><span class="info-value" style="font-weight:600;">' + items.length + ' sản phẩm</span></div>' +
          '<div class="info-item"><span class="info-label">Mã ID hệ thống</span><span class="info-value" style="font-family:monospace;font-size:12px;">' + fs._id + '</span></div>' +
          '<div class="info-item"><span class="info-label">Ngày tạo</span><span class="info-value">' + fmtDate(fs.createdAt) + '</span></div>' +
        '</div>' +
      '</div>';

    // ── Table Card: Danh sách sản phẩm ──
    html += '<div class="dt-card" style="padding:20px 24px;">' +
      '<h3 style="font-size:15px;font-weight:600;margin:0 0 16px;display:flex;align-items:center;gap:8px;">' +
        '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>' +
        'Danh sách sản phẩm áp dụng (' + items.length + ')' +
      '</h3>';

    if (items.length === 0) {
      html += '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;">Chưa có sản phẩm nào được gán vào đợt Flash Sale này.</div>';
    } else {
      html += '<div style="width:100%;overflow:hidden;"><table style="width:100%;border-collapse:collapse;font-size:12px;table-layout:fixed;"><thead><tr style="border-bottom:2px solid var(--border);">' +
        '<th style="text-align:left;padding:8px 4px;color:var(--text-muted);font-weight:600;text-transform:uppercase;font-size:10.5px;width:6%;">STT</th>' +
        '<th style="text-align:left;padding:8px 4px;color:var(--text-muted);font-weight:600;text-transform:uppercase;font-size:10.5px;width:40%;">Sản phẩm</th>' +
        '<th style="text-align:right;padding:8px 4px;color:var(--text-muted);font-weight:600;text-transform:uppercase;font-size:10.5px;width:18%;">Giá gốc</th>' +
        '<th style="text-align:center;padding:8px 4px;color:var(--text-muted);font-weight:600;text-transform:uppercase;font-size:10.5px;width:16%;">Mức giảm (%)</th>' +
        '<th style="text-align:right;padding:8px 4px;color:var(--text-muted);font-weight:600;text-transform:uppercase;font-size:10.5px;width:20%;">Giá Flash Sale</th>' +
      '</tr></thead><tbody>';

      items.forEach(function(item, idx) {
        var p = item.productId || item;
        var pName = escapeHtml(p.name || 'Sản phẩm');
        var pImg = p.image || (p.images && p.images[0]) || '';
        var basePrice = p.price || 0;
        var discPct = item.extraDiscountPercentage !== undefined ? item.extraDiscountPercentage : (fs.extraDiscountPercentage || 10);
        var finalPrice = Math.round(basePrice * (1 - discPct / 100));

        var imgHtml = pImg
          ? '<img src="' + escapeHtml(pImg) + '" alt="" style="width:34px;height:34px;object-fit:cover;border-radius:6px;border:1px solid var(--border);flex-shrink:0;" onerror="this.style.display=\'none\'" />'
          : '<div style="width:34px;height:34px;border-radius:6px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>';

        html += '<tr style="border-bottom:1px solid var(--border);">' +
          '<td style="padding:10px 4px;color:var(--text-muted);">' + (idx + 1) + '</td>' +
          '<td style="padding:10px 4px;">' +
            '<div style="display:flex;align-items:center;gap:8px;min-width:0;">' +
              imgHtml +
              '<span style="font-weight:500;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;flex:1;min-width:0;" title="' + pName + '">' + pName + '</span>' +
            '</div>' +
          '</td>' +
          '<td style="padding:10px 4px;text-align:right;color:var(--text-muted);">' + fmtCurrency(basePrice) + '</td>' +
          '<td style="padding:10px 4px;text-align:center;"><span style="background:rgba(239,68,68,0.12);color:#ef4444;padding:2px 8px;border-radius:12px;font-weight:600;font-size:11.5px;">-' + discPct + '%</span></td>' +
          '<td style="padding:10px 4px;text-align:right;font-weight:700;color:#22c55e;font-size:12.5px;">' + fmtCurrency(finalPrice) + '</td>' +
        '</tr>';
      });

      html += '</tbody></table></div>';
    }

    html += '</div>';

    $('detail-loading').style.display = 'none';
    $('detail-content').style.display = 'block';
    $('detail-content').innerHTML = html;
  })
  .catch(function() {
    $('detail-loading').style.display = 'none';
    $('detail-error').style.display = 'block';
    $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Lỗi kết nối</p><p style="margin-top:8px;font-size:13px;">Không thể tải thông tin đợt Flash Sale. Vui lòng thử lại.</p>';
  });
</script>

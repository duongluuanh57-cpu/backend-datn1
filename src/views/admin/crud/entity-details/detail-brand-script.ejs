<script>
var BRAND_ID = '<%= brandId %>';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

<%- include('../../common/shared-js-utils') %>

fetch('/api/brands/' + BRAND_ID, { headers: H })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (!res.success || !res.data) {
      $('detail-loading').style.display = 'none';
      $('detail-error').style.display = 'block';
      $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy thương hiệu</p><p style="margin-top:8px;font-size:13px;">Thương hiệu có thể đã bị xóa hoặc không tồn tại.</p>';
      return;
    }
    var b = res.data;
    $('detail-breadcrumb').textContent = b.name || '';
    document.title = (b.name || 'Thương hiệu') + ' — Admin';

    var statusBadge = b.status === 'active'
      ? '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(34,197,94,0.12);color:#22c55e;"><span style="width:6px;height:6px;border-radius:50%;background:#22c55e;"></span>Hoạt động</span>'
      : '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(239,68,68,0.12);color:#ef4444;"><span style="width:6px;height:6px;border-radius:50%;background:#ef4444;"></span>Ẩn</span>';

    var featuredBadge = b.featured
      ? '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(201,169,110,0.12);color:var(--accent);">★ Nổi bật</span>'
      : '<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600;background:var(--surface);color:var(--text-muted);border:1px solid var(--border);">Thường</span>';

    var logoHtml = b.logo
      ? '<img src="'+escapeHtml(b.logo)+'" alt="" style="width:96px;height:96px;object-fit:contain;border-radius:12px;background:var(--surface);border:1px solid var(--border);" onerror="this.src=PLACEHOLDER_SVG" />'
      : '<div style="width:96px;height:96px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:28px;font-weight:700;">'+escapeHtml((b.name||'?')[0])+'</div>';

    var html = '<div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;">'+
      '<div style="flex-shrink:0;">'+logoHtml+'</div>'+
      '<div style="flex:1;min-width:240px;">'+
        '<h2 style="font-size:22px;font-weight:700;color:var(--text-primary);margin:0 0 12px;line-height:1.3;">'+escapeHtml(b.name)+'</h2>'+
        '<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px;">'+
          statusBadge+featuredBadge+
        '</div>'+
        '<div style="display:flex;flex-direction:column;gap:8px;font-size:13px;">'+
          '<div><span style="color:var(--text-muted);min-width:90px;display:inline-block;">Xuất xứ:</span> <strong>'+(b.origin ? escapeHtml(b.origin) : '—')+'</strong></div>'+
          '<div><span style="color:var(--text-muted);min-width:90px;display:inline-block;">Số sản phẩm:</span> <strong>'+(b.productCount !== undefined ? (b.productCount || 0).toLocaleString('vi-VN') : '—')+'</strong></div>'+
          '<div><span style="color:var(--text-muted);min-width:90px;display:inline-block;">ID:</span> <span style="font-family:monospace;font-size:12px;">'+b._id+'</span></div>'+
          '<div><span style="color:var(--text-muted);min-width:90px;display:inline-block;">Ngày tạo:</span> '+fmtDate(b.createdAt)+'</div>'+
          '<div><span style="color:var(--text-muted);min-width:90px;display:inline-block;">Cập nhật:</span> '+fmtDate(b.updatedAt)+'</div>'+
        '</div>'+
      '</div>'+
    '</div>';

    var editBtn = document.getElementById('edit-brand-btn');
    if (editBtn) {
      editBtn.style.display = 'inline-flex';
      editBtn.href = '/admin/brands/' + b._id + '/edit';
    }

    $('detail-loading').style.display = 'none';
    $('detail-content').style.display = 'block';
    $('detail-content').innerHTML = html;
  })
  .catch(function() {
    $('detail-loading').style.display = 'none';
    $('detail-error').style.display = 'block';
    $('detail-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Lỗi kết nối</p><p style="margin-top:8px;font-size:13px;">Không thể tải thông tin thương hiệu. Vui lòng thử lại.</p>';
  });
</script>

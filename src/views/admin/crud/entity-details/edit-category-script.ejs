<style>
  #category-edit .dt-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;}
  #category-edit .supp-form-group{display:flex;flex-direction:column;gap:6px;}
  #category-edit .supp-form-group label{font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;}
  #category-edit .supp-form-group input[type="text"],
  #category-edit .supp-form-group input[type="number"],
  #category-edit .supp-form-group select{
    padding:10px 14px;border:1px solid var(--border);border-radius:8px;font-size:14px;color:var(--text-primary);
    background:var(--bg);outline:none;transition:border-color 0.2s;font-family:inherit;
  }
  #category-edit .supp-form-group input:focus,
  #category-edit .supp-form-group select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(201,169,110,0.1);}
</style>

<script>
<%- include('../../common/shared-js-utils') %>
var CATEGORY_ID = '<%= categoryId || "" %>';
var IS_NEW = '<%= (typeof IS_NEW !== "undefined" && IS_NEW) ? true : false %>' === 'true';
var TOKEN = '<%= apiToken %>';
var H = { 'Authorization': 'Bearer ' + TOKEN };

function wireSlugAuto() {
  $('ce-name').addEventListener('input', function() {
    var slugEl = $('ce-slug');
    if (!slugEl.dataset.edited) { slugEl.value = slugify(this.value); }
  });
  $('ce-slug').addEventListener('input', function() { this.dataset.edited = 'true'; });
}

function updateCategoryStatusToggle(checked) {
  var statusInput = $('ce-status');
  var textEl = $('ce-status-text');
  var sliderEl = $('ce-status-slider');
  var thumbEl = $('ce-status-thumb');
  if (checked) {
    if (statusInput) statusInput.value = 'active';
    if (textEl) { textEl.textContent = 'Hoạt động'; textEl.style.color = '#22c55e'; }
    if (sliderEl) sliderEl.style.background = '#22c55e';
    if (thumbEl) thumbEl.style.transform = 'translateX(20px)';
  } else {
    if (statusInput) statusInput.value = 'inactive';
    if (textEl) { textEl.textContent = 'Ẩn'; textEl.style.color = 'var(--text-muted)'; }
    if (sliderEl) sliderEl.style.background = 'var(--border)';
    if (thumbEl) thumbEl.style.transform = 'translateX(0)';
  }
}

if (!IS_NEW && CATEGORY_ID) {
  fetch('/api/categories/' + CATEGORY_ID, { headers: H })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success || !res.data) {
        $('ce-loading').style.display = 'none';
        $('ce-error').style.display = 'block';
        $('ce-error').innerHTML = '<p style="font-size:16px;font-weight:600;">Không tìm thấy danh mục</p>';
        return;
      }
      var c = res.data;
      $('ce-breadcrumb').textContent = 'Chỉnh sửa · ' + (c.name || '');
      document.title = 'Chỉnh sửa ' + (c.name || 'Danh mục') + ' — Admin';
      $('ce-name').value = c.name || '';
      $('ce-slug').value = c.slug || '';
      var statusVal = c.status || 'active';
      var isChecked = statusVal === 'active';
      $('ce-status-toggle').checked = isChecked;
      updateCategoryStatusToggle(isChecked);
      wireSlugAuto();
      $('ce-loading').style.display = 'none';
      $('ce-form').style.display = 'block';
    })
    .catch(function() { $('ce-loading').style.display = 'none'; $('ce-error').style.display = 'block'; });
} else {
  wireSlugAuto();
  document.addEventListener('DOMContentLoaded', function() {
    if ($('ce-status-toggle')) {
      $('ce-status-toggle').checked = true;
      updateCategoryStatusToggle(true);
    }
  });
}

function saveCategory() {
  var name = $('ce-name').value.trim();
  if (!name) { showToast('Vui lòng nhập tên danh mục', 'error'); $('ce-name').focus(); return; }
  var data = { name: name, slug: $('ce-slug').value.trim(), status: $('ce-status').value };
  var btn = $('ce-btn-save');
  btn.disabled = true; btn.style.opacity = '0.6';
  $('ce-save-status').textContent = 'Đang lưu...'; $('ce-save-status').style.color = 'var(--text-muted)';
  var url = IS_NEW ? '/api/categories' : '/api/categories/' + CATEGORY_ID;
  var method = IS_NEW ? 'POST' : 'PATCH';
  fetch(url, { method: method, headers: { 'Authorization': 'Bearer ' + TOKEN, 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      btn.disabled = false; btn.style.opacity = '1';
      if (res.success) {
        $('ce-save-status').textContent = '✅ Đã lưu!'; $('ce-save-status').style.color = '#22c55e';
        if (IS_NEW) {
          showToast('Đã tạo danh mục thành công!', 'success');
        } else {
          showToast('Đã cập nhật danh mục thành công!', 'success');
        }
        setTimeout(function() {
          window.location.href = '/admin/categories';
        }, 600);
      } else {
        $('ce-save-status').textContent = '❌ ' + (res.message || 'Lỗi'); $('ce-save-status').style.color = '#ef4444';
        showToast(res.message || 'Không thể lưu danh mục', 'error');
      }
    })
    .catch(function() {
      btn.disabled = false; btn.style.opacity = '1';
      showToast('Lỗi kết nối đến server', 'error');
    });
}
</script>

// ── Inline status popup ──
var STATUS_POPUP = null;
var STATUS_POPUP_TRIGGER = null;

function toggleStatusPopup(btn, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  if (STATUS_POPUP && STATUS_POPUP_TRIGGER === btn) {
    closeStatusPopup();
    return;
  }
  openStatusPopup(btn);
}

function openStatusPopup(btn) {
  closeStatusPopup();
  var opts = [];
  try { opts = JSON.parse(btn.getAttribute('data-opts')) || []; } catch (err) { opts = []; }
  var current = '';
  var m = btn.className.match(/status-(\S+)/);
  current = m ? m[1] : '';

  var popup = document.createElement('div');
  popup.className = 'status-dd-popup';
  var html = '';
  opts.forEach(function(o) {
    var active = o.v === current ? ' active' : '';
    html += '<button type="button" class="status-dd-item' + active + '" data-status="' + o.v + '" onclick="pickStatus(this, event)">' +
      '<span class="status-dd-dot status-' + o.v + '"></span>' + escapeHtml(o.l) + '</button>';
  });
  popup.innerHTML = html;

  STATUS_POPUP_TRIGGER = btn;
  btn.classList.add('open');
  document.body.appendChild(popup);

  var r = btn.getBoundingClientRect();
  popup.style.left = r.left + 'px';
  popup.style.top = (r.bottom + 6) + 'px';
  if (r.bottom + popup.offsetHeight + 12 > window.innerHeight) {
    popup.style.top = (r.top - popup.offsetHeight - 6) + 'px';
  }
  // Keep within viewport horizontally
  if (r.left + popup.offsetWidth > window.innerWidth - 8) {
    popup.style.left = Math.max(8, window.innerWidth - popup.offsetWidth - 8) + 'px';
  }
  popup.classList.add('open');
  STATUS_POPUP = popup;
}

function pickStatus(item, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  var btn = STATUS_POPUP_TRIGGER;
  var status = item.getAttribute('data-status');
  var label = item.textContent.trim();
  closeStatusPopup();
  if (btn) changeEntityStatus(btn, btn.getAttribute('data-id'), status, btn.getAttribute('data-api'), label);
}

function closeStatusPopup() {
  if (STATUS_POPUP) {
    STATUS_POPUP.remove();
    STATUS_POPUP = null;
  }
  if (STATUS_POPUP_TRIGGER) {
    STATUS_POPUP_TRIGGER.classList.remove('open');
    STATUS_POPUP_TRIGGER = null;
  }
}


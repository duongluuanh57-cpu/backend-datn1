    voucherScopeEl.value = APPLICABLE_TO;
    voucherScopeEl.addEventListener('change', function() {
      APPLICABLE_TO = this.value;
      PAGE = 1;
      crudFetch();
    });
  }

  // 4. Voucher sort filter (including outOfUsage)
  var voucherSortEl = document.getElementById('crud-voucher-sort-filter');
  if (voucherSortEl) {
    voucherSortEl.value = SORT;
    voucherSortEl.addEventListener('change', function() {
      SORT = this.value;
      PAGE = 1;
      crudFetch();
    });
  }

  // Move clear search link into voucher filters row
  var clearBtn = document.getElementById('crud-clear-search');
  if (clearBtn && voucherFilters) {
    voucherFilters.appendChild(clearBtn);
  }
}

document.getElementById('crud-tbody').innerHTML = skeletonRows(5, C.columns.length);
crudFetch();

</script>
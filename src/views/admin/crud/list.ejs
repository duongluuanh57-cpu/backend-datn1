// ── Render table ──
function renderTable(items) {
  ALL_ITEMS = items || [];
  var tbody = document.getElementById('crud-tbody');
  if (!items || items.length === 0) {
    tbody.innerHTML = '<tr><td colspan="99" style="text-align:center;padding:40px;color:var(--text-muted);">Không có dữ liệu</td></tr>';
    updateBulkBar();
    return;
  }
  var html = '';
  items.forEach(function(row, idx) {
    var sel = SELECTED.has(row._id) ? ' selected' : '';
    var checked = SELECTED.has(row._id) ? ' checked' : '';
    html += '<tr data-id="' + row._id + '" class="' + sel + '">';
    if (showCheckboxes) {
      html += '<td class="checkbox-col" onclick="event.stopPropagation()"><input type="checkbox" ' + checked + ' onchange="toggleSelectOne(\'' + row._id + '\', this.checked)"></td>';
    }
    C.columns.forEach(function(col) {
      html += '<td>' + cellContent(row, col, idx) + '</td>';
    });
    html += '</tr>';
  });
  tbody.innerHTML = html;

  // Make rows clickable (navigate to detail)
  if (C.detailEndpoint) {
    tbody.querySelectorAll('tr[data-id]').forEach(function(tr) {
      tr.style.cursor = 'pointer';
      tr.addEventListener('click', function(e) {
        // Ignore clicks on checkbox
        if (e.target.tagName === 'INPUT') return;
        location.href = C.detailEndpoint.replace(':id', tr.getAttribute('data-id'));
      });
    });
  }

  updateSelectAllCb();
  updateBulkBar();
}

function renderPagination() {
  var el = document.getElementById('crud-pagination');
  if (!TOTAL_PAGES || TOTAL_PAGES <= 1) { el.innerHTML = ''; return; }
  var html = '';
  html += '<button class="pg-btn' + (PAGE <= 1 ? ' pg-disabled' : '') + '" onclick="if(' + PAGE + '>1)crudGoPage(' + (PAGE - 1) + ')"' + (PAGE <= 1 ? ' disabled' : '') + '>&lsaquo;</button>';
  var pages = [];
  if (TOTAL_PAGES <= 7) {
    for (var i = 1; i <= TOTAL_PAGES; i++) pages.push(i);
  } else {
    pages.push(1);
    if (PAGE > 3) pages.push('...');
    for (var j = Math.max(2, PAGE - 1); j <= Math.min(TOTAL_PAGES - 1, PAGE + 1); j++) pages.push(j);
    if (PAGE < TOTAL_PAGES - 2) pages.push('...');
    pages.push(TOTAL_PAGES);
  }
  pages.forEach(function(p) {
    if (p === '...') {
      html += '<span class="pg-ellipsis">...</span>';
    } else {
      html += '<button class="pg-btn' + (p === PAGE ? ' pg-active' : '') + '" onclick="crudGoPage(' + p + ')">' + p + '</button>';
    }
  });
  html += '<button class="pg-btn' + (PAGE >= TOTAL_PAGES ? ' pg-disabled' : '') + '" onclick="if(' + PAGE + '<' + TOTAL_PAGES + ')crudGoPage(' + (PAGE + 1) + ')"' + (PAGE >= TOTAL_PAGES ? ' disabled' : '') + '>&rsaquo;</button>';
  el.innerHTML = html;
}

var currentFetchController = null;

function crudFetch() {
  if (currentFetchController) {
    try { currentFetchController.abort(); } catch (e) {}
  }
  currentFetchController = typeof AbortController !== 'undefined' ? new AbortController() : null;
  var fetchSignal = currentFetchController ? currentFetchController.signal : undefined;

  var sep = (C.apiEndpoint && C.apiEndpoint.indexOf('?') !== -1) ? '&' : '?';
  var url = C.apiEndpoint + sep + 'page=' + PAGE + '&limit=' + LIMIT;

  if (SEARCH) url += '&search=' + encodeURIComponent(SEARCH);
  if (CATEGORY) url += '&category=' + encodeURIComponent(CATEGORY);
  if (BRAND) url += '&brand=' + encodeURIComponent(BRAND);
  if (STOCK) url += '&stock=' + encodeURIComponent(STOCK);
  if (SORT) url += '&sortBy=' + encodeURIComponent(SORT);
  if (STATUS) url += '&status=' + encodeURIComponent(STATUS);
  if (PRICE_MIN) url += '&minPrice=' + encodeURIComponent(PRICE_MIN);
  if (PRICE_MAX) url += '&maxPrice=' + encodeURIComponent(PRICE_MAX);
  if (CANCEL_REQUESTED) url += '&cancelRequested=' + encodeURIComponent(CANCEL_REQUESTED);
  if (ORDER_START_DATE) url += '&startDate=' + encodeURIComponent(ORDER_START_DATE);
  if (ORDER_END_DATE) url += '&endDate=' + encodeURIComponent(ORDER_END_DATE);
  if (ORIGIN) url += '&origin=' + encodeURIComponent(ORIGIN);
  if (APPLICABLE_TO) url += '&applicableTo=' + encodeURIComponent(APPLICABLE_TO);
  if (typeof VOUCHER_TYPE !== 'undefined' && VOUCHER_TYPE) url += '&type=' + encodeURIComponent(VOUCHER_TYPE);
  if (C.entityName === 'review' && REVIEW_RATING) url += '&rating=' + encodeURIComponent(REVIEW_RATING);
  if (typeof TAG !== 'undefined' && TAG) url += '&tag=' + encodeURIComponent(TAG);
  document.getElementById('crud-tbody').innerHTML = skeletonRows(5, C.columns.length);

  fetch(url, { signal: fetchSignal, headers: { 'Authorization': 'Bearer ' + window.__API_TOKEN__ } })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      currentFetchController = null;
      if (!res.success) { document.getElementById('crud-tbody').innerHTML = '<tr><td colspan="99" style="text-align:center;padding:40px;color:var(--danger);">Lỗi tải dữ liệu</td></tr>'; return; }
      var data = res.data !== undefined ? res.data : res;
      var items = C.itemsPath ? deepGet(data, C.itemsPath) : data;
      var total = C.totalPath ? deepGet(data, C.totalPath) : (data && data.total);
      var totalPages = C.totalPagesPath ? deepGet(data, C.totalPagesPath) : (data && data.totalPages);
      if (!items && Array.isArray(data)) items = data;
      if (!total && items) total = items.length;
      if (!totalPages && total) totalPages = Math.ceil(total / LIMIT);
      TOTAL_PAGES = totalPages || 1;
      document.getElementById('crud-total').textContent = total || 0;
      var totalLabel = document.getElementById('crud-total-label');
      if (totalLabel) {
        var labels = { product:'Tổng sản phẩm', brand:'Tổng thương hiệu', category:'Tổng danh mục', tag:'Tổng tag', order:'Tổng đơn hàng', review:'Tổng đánh giá', voucher:'Tổng mã giảm giá', user:'Tổng người dùng' };
        totalLabel.textContent = labels[C.entityName] || 'Tổng cộng';
      }
      // Update bulk bar label
      var bulkCountEl = document.getElementById('bulk-count');
      if (bulkCountEl) {
        var bulkLabels = { product:'sản phẩm', brand:'thương hiệu', category:'danh mục', tag:'tag', order:'đơn hàng', review:'đánh giá', voucher:'mã giảm giá', user:'người dùng' };
        var entityLabel = bulkLabels[C.entityName] || 'mục';
        bulkCountEl.dataset.entityLabel = entityLabel;
      }
      renderTable(items || []);
      renderPagination();
      
      // Show product filters
      if (C.entityName === 'product') {
        var catFilter = document.getElementById('crud-category-filter');
        if (catFilter) catFilter.style.display = 'inline-block';
        var createBtnWrap = document.getElementById('crud-create-btn-wrap');
        if (createBtnWrap) createBtnWrap.style.display = 'block';
      }
      // Cập nhật tiêu đề cột linh hoạt cho đơn hàng (Lý do hủy / Trạng thái thanh toán)
      if (C.entityName === 'order') {
        var ths = document.querySelectorAll('#crud-thead th');
        ths.forEach(function(th) {
          if (th.getAttribute('data-col-render') === 'cancelReason' || th.textContent.includes('Lý do hủy') || th.textContent.includes('Trạng thái thanh toán') || th.textContent.includes('Trạng thái TT')) {
            th.textContent = (STATUS === 'cancelled') ? 'Lý do hủy' : 'Trạng thái thanh toán';
          }
        });
      }

      syncUrl();
    })
    .catch(function(err) {
      if (err && err.name === 'AbortError') {
        // Hủy request cũ do bấm quá nhanh - bỏ qua im lặng không hiện lỗi
        return;
      }
      currentFetchController = null;
      document.getElementById('crud-tbody').innerHTML = '<tr><td colspan="99" style="text-align:center;padding:40px;color:var(--danger);">Lỗi kết nối</td></tr>';
    });
}

function crudSearch() {
  SEARCH = document.getElementById('crud-search').value.trim();
  PAGE = 1;

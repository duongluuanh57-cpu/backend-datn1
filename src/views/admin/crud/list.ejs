             '<span class="product-name" style="font-weight:600;color:var(--text-primary);font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;" title="' + name + '">' + name + '</span>' +
             '<span class="product-sku" style="font-size:11px;color:var(--text-muted);font-family:monospace;letter-spacing:0.5px;">SKU: ' + sku + '</span>' +
           '</div>';
  }
  if (col.render === 'productCategory') {
    var brandName = row.brandId?.name || (row.brandId && typeof row.brandId === 'object' ? row.brandId.name : '') || row.brandName || row.brand || '';
    var categories = '';
    if (Array.isArray(row.categories)) {
      categories = row.categories.map(function(c) { return typeof c === 'string' ? c : (c.name || ''); }).filter(Boolean).join(', ');
    } else if (typeof row.categories === 'string') {
      categories = row.categories;
    }
    var parts = [];
    if (categories) parts.push('<span class="cat-tag" style="font-size:12px;font-weight:500;color:var(--text-primary);">' + escapeHtml(categories) + '</span>');
    if (brandName) parts.push('<span class="brand-tag" style="font-size:11px;color:var(--text-muted);background:var(--border);padding:2px 6px;border-radius:4px;font-weight:500;">' + escapeHtml(brandName) + '</span>');
    return '<div style="display:flex;flex-direction:column;gap:4px;align-items:flex-start;">' + parts.join('') + '</div>';
  }

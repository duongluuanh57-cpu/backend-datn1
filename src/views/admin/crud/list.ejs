  var reviewRatingEl = document.getElementById('crud-review-rating-filter');
  if (reviewRatingEl) {
    reviewRatingEl.value = REVIEW_RATING;
    reviewRatingEl.addEventListener('change', function() {
      REVIEW_RATING = this.value;
      PAGE = 1;
      crudFetch();
    });
  }
}

// ── Voucher-specific filter initialization ──
if (C.entityName === 'voucher') {
  var voucherFilters = document.getElementById('crud-voucher-filters');
  if (voucherFilters) voucherFilters.style.display = 'flex';

  var voucherScopeEl = document.getElementById('crud-voucher-scope-filter');
  if (voucherScopeEl) {
    voucherScopeEl.value = APPLICABLE_TO;
    voucherScopeEl.addEventListener('change', function() {
      APPLICABLE_TO = this.value;
      PAGE = 1;
      crudFetch();
    });
  }
}

document.getElementById('crud-tbody').innerHTML = skeletonRows(5, C.columns.length);
crudFetch();

</script>
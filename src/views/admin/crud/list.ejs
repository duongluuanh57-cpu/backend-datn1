function changeProductFlashSale(btn, productId, flashSaleId, extraDiscount, label) {
  btn.disabled = true;
  var oldText = btn.textContent;

  fetch('/api/flash-sales/assign-product', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + API_TOKEN
    },
    body: JSON.stringify({
      productId: productId,
      flashSaleId: flashSaleId,
      extraDiscountPercentage: extraDiscount
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    btn.disabled = false;
    if (res.success) {
      if (flashSaleId) {
        btn.textContent = label.replace(/^[\u2715\u26a1]\s*/, '') + ' (-' + extraDiscount + '%)';
        btn.className = 'filter-status-select status-active';
        btn.setAttribute('data-fsid', flashSaleId);
      } else {
        btn.textContent = '+ Gán sự kiện';
        btn.className = 'filter-status-select status-draft';
        btn.setAttribute('data-fsid', '');
      }
      showToast(res.message || 'Cập nhật sự kiện Flash Sale thành công!', 'success');
    } else {
      btn.textContent = oldText;
      showToast(res.message || 'Lỗi cập nhật sự kiện', 'error');
    }
  })
  .catch(function(err) {
    btn.disabled = false;
    btn.textContent = oldText;
    showToast('Lỗi kết nối máy chủ', 'error');
  });
}

document.addEventListener('click', function(e) {

  if (priceMinEl) priceMinEl.value = '';
  var priceMaxEl = document.getElementById('crud-price-max');
  if (priceMaxEl) priceMaxEl.value = '';
  // Reset order filters
  CANCEL_REQUESTED = '';
  var crBtn = document.getElementById('crud-cancel-request-btn');
  if (crBtn) crBtn.classList.remove('active');
  ORDER_START_DATE = '';
  var startDateEl = document.getElementById('crud-order-start-date');
  if (startDateEl) startDateEl.value = '';
  ORDER_END_DATE = '';
  var endDateEl = document.getElementById('crud-order-end-date');

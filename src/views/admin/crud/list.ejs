<%# Generic CRUD List Template — client-side fetch with bulk actions %>
<script>window.__API_TOKEN__='<%= apiToken %>';window.__ADMIN_CONFIG__=<%- config %>;</script>

<div id="crud-app">
  <!-- ── Combined Brand, Category & Tag Tab Switcher ── -->
  <div id="brand-cat-tabs" style="display:none;margin-bottom:16px;">
    <div style="position:relative;display:inline-flex;gap:4px;background:var(--surface, #fff);padding:4px;border-radius:12px;border:1px solid var(--border, #e2e8f0);box-shadow:0 2px 8px rgba(0,0,0,0.04);">
      <!-- Animated Active Pill -->
      <div id="tab-active-pill" style="position:absolute;top:4px;bottom:4px;left:4px;width:0;border-radius:8px;background:var(--accent, #c9a96e);transition:all 0.35s cubic-bezier(0.34, 1.35, 0.64, 1);box-shadow:0 2px 8px rgba(201,169,110,0.3);z-index:1;pointer-events:none;"></div>

      <a href="/admin/brands" id="tab-brand-link" class="tab-item-link" style="position:relative;z-index:2;display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:color 0.25s, transform 0.15s;color:var(--text-muted, #64748b);" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        Thương hiệu
      </a>
      <a href="/admin/categories" id="tab-cat-link" class="tab-item-link" style="position:relative;z-index:2;display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:color 0.25s, transform 0.15s;color:var(--text-muted, #64748b);" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        Danh mục
      </a>
      <a href="/admin/tags" id="tab-tag-link" class="tab-item-link" style="position:relative;z-index:2;display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:color 0.25s, transform 0.15s;color:var(--text-muted, #64748b);" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='none'">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        Tags
      </a>
    </div>
  </div>

  <!-- ── Filter Bar Component ── -->
  <%- include('./crud-filter-bar') %>

  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead><tr id="crud-thead"></tr></thead>
      <tbody id="crud-tbody">
      </tbody>
    </table>
  </div>

  <div id="crud-pagination" style="display:flex;justify-content:center;gap:6px;margin-top:20px;"></div>
</div>

<!-- ── Bulk action bar (toast) ── -->
<div id="bulk-bar" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);display:none;align-items:center;gap:12px;background:#1e1e2e;color:#fff;padding:10px 20px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.3);z-index:1000;font-size:14px;">
  <span id="bulk-count">0 sản phẩm đã chọn</span>
  <button onclick="bulkDelete()" id="bulk-delete-btn" style="background:#ef4444;color:#fff;border:none;padding:6px 16px;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px;"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>Xóa</button>
  <button onclick="clearBulkSelection()" style="background:none;border:1px solid rgba(255,255,255,0.3);color:rgba(255,255,255,0.7);padding:6px 12px;border-radius:8px;cursor:pointer;font-size:13px;">✕ Bỏ chọn</button>
</div>



<script>
var C = window.__ADMIN_CONFIG__;

// Khôi phục trạng thái từ URL
var URL_PARAMS = new URLSearchParams(window.location.search);
var PAGE = parseInt(URL_PARAMS.get('page'), 10) || 1;
var SEARCH = URL_PARAMS.get('search') || '';
var CATEGORY = URL_PARAMS.get('category') || '';
var BRAND = URL_PARAMS.get('brand') || '';
var STOCK = URL_PARAMS.get('stock') || '';
var SORT = URL_PARAMS.get('sortBy') || '';
var STATUS = URL_PARAMS.get('status') || '';
var PRICE_MIN = URL_PARAMS.get('minPrice') || '';
var PRICE_MAX = URL_PARAMS.get('maxPrice') || '';
var CANCEL_REQUESTED = URL_PARAMS.get('cancelRequested') || '';
var ORDER_START_DATE = URL_PARAMS.get('startDate') || '';
var ORDER_END_DATE = URL_PARAMS.get('endDate') || '';
var ORIGIN = URL_PARAMS.get('origin') || '';
var REVIEW_RATING = URL_PARAMS.get('rating') || '';
var APPLICABLE_TO = URL_PARAMS.get('applicableTo') || '';
var VOUCHER_TYPE = URL_PARAMS.get('type') || '';
var TAG = URL_PARAMS.get('tag') || '';
var LIMIT = 30;
var TOTAL_PAGES = 1;
var ALL_ITEMS = [];       // current page items (with _id)
var SELECTED = new Set(); // set of selected _id

// ── Lưu/khôi phục trạng thái lọc (localStorage theo từng entity) ──
var LS_FILTER_KEY = 'crud-filters-' + (C.entityName || 'entity');
var HAS_URL_FILTERS = (PAGE > 1) || SEARCH || CATEGORY || BRAND || STOCK || SORT || STATUS || PRICE_MIN || PRICE_MAX || CANCEL_REQUESTED || ORDER_START_DATE || ORDER_END_DATE || ORIGIN || REVIEW_RATING || APPLICABLE_TO || VOUCHER_TYPE;
if (!HAS_URL_FILTERS) {
  try {
    var savedF = JSON.parse(localStorage.getItem(LS_FILTER_KEY) || 'null');
    if (savedF) {
      if (savedF.page > 1) PAGE = savedF.page;
      if (savedF.search) SEARCH = savedF.search;
      if (savedF.category) CATEGORY = savedF.category;
      if (savedF.brand) BRAND = savedF.brand;
      if (savedF.stock) STOCK = savedF.stock;
      if (savedF.sortBy) SORT = savedF.sortBy;
      if (savedF.status) STATUS = savedF.status;
      if (savedF.minPrice) PRICE_MIN = savedF.minPrice;
      if (savedF.maxPrice) PRICE_MAX = savedF.maxPrice;
      if (savedF.cancelRequested) CANCEL_REQUESTED = savedF.cancelRequested;
      if (savedF.startDate) ORDER_START_DATE = savedF.startDate;
      if (savedF.endDate) ORDER_END_DATE = savedF.endDate;
      if (savedF.origin) ORIGIN = savedF.origin;
      if (savedF.rating) REVIEW_RATING = savedF.rating;
      if (savedF.applicableTo) APPLICABLE_TO = savedF.applicableTo;
    }
  } catch (e) {}
}

<%- include('../common/utils') %>

var COLORS = { pending:'#f59e0b', processing:'#3b82f6', shipped:'#8b5cf6', delivered:'#22c55e', cancelled:'#ef4444' };
var STATUS_LABELS = { pending:'Chờ XN', processing:'Đang XL', shipped:'Đang giao hàng', delivered:'Hoàn thành', cancelled:'Đã hủy' };

document.getElementById('crud-search').placeholder = C.searchPlaceholder || 'Tìm kiếm...';
document.getElementById('crud-search').value = SEARCH;
document.getElementById('crud-search').addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); crudSearch(); } });

function syncUrl() {
  var p = new URLSearchParams();
  if (PAGE > 1) p.set('page', PAGE);
  if (SEARCH) p.set('search', SEARCH);
  if (CATEGORY) p.set('category', CATEGORY);
  if (BRAND) p.set('brand', BRAND);
  if (STOCK) p.set('stock', STOCK);
  if (SORT) p.set('sortBy', SORT);
  if (STATUS) p.set('status', STATUS);
  if (PRICE_MIN) p.set('minPrice', PRICE_MIN);
  if (PRICE_MAX) p.set('maxPrice', PRICE_MAX);
  if (CANCEL_REQUESTED) p.set('cancelRequested', CANCEL_REQUESTED);
  if (ORDER_START_DATE) p.set('startDate', ORDER_START_DATE);
  if (ORDER_END_DATE) p.set('endDate', ORDER_END_DATE);
  if (ORIGIN) p.set('origin', ORIGIN);
  if (REVIEW_RATING) p.set('rating', REVIEW_RATING);
  if (APPLICABLE_TO) p.set('applicableTo', APPLICABLE_TO);
  if (VOUCHER_TYPE) p.set('type', VOUCHER_TYPE);
  var qs = p.toString();
  var url = window.location.pathname + (qs ? '?' + qs : '');
  history.replaceState(null, '', url);
  try {
    localStorage.setItem(LS_FILTER_KEY, JSON.stringify({
      page: PAGE, search: SEARCH, category: CATEGORY, brand: BRAND, stock: STOCK,
      sortBy: SORT, status: STATUS, minPrice: PRICE_MIN, maxPrice: PRICE_MAX,
      cancelRequested: CANCEL_REQUESTED, startDate: ORDER_START_DATE, endDate: ORDER_END_DATE,
      origin: ORIGIN, rating: REVIEW_RATING, applicableTo: APPLICABLE_TO, type: VOUCHER_TYPE, tag: TAG
    }));
  } catch (e) {}

  // ── Show/hide clear filters button dynamically ──
  var hasFilters = !!(SEARCH || CATEGORY || BRAND || STOCK || STATUS || SORT || PRICE_MIN || PRICE_MAX || CANCEL_REQUESTED || ORDER_START_DATE || ORDER_END_DATE || ORIGIN || REVIEW_RATING || APPLICABLE_TO || VOUCHER_TYPE);
  var clearBtn = document.getElementById('crud-clear-search');
  if (clearBtn) {
    if (hasFilters) clearBtn.classList.add('show');
    else clearBtn.classList.remove('show');
  }
}

// ── Build header with checkbox column ──
var thead = document.getElementById('crud-thead');
var showCheckboxes = C.entityName === 'product';

if (showCheckboxes) {
  var thCheck = document.createElement('th');
  thCheck.className = 'checkbox-col';
  var cbAll = document.createElement('input');
  cbAll.type = 'checkbox';
  cbAll.title = 'Chọn tất cả';
  cbAll.onchange = function() { toggleSelectAll(this.checked); };
  thCheck.appendChild(cbAll);
  thead.appendChild(thCheck);
}

C.columns.forEach(function(c) {
  var th = document.createElement('th');
  th.textContent = c.label;
  if (c.render) th.setAttribute('data-col-render', c.render);
  thead.appendChild(th);
});

function skeletonRows(count, cols) {
  var h = '';
  for (var r = 0; r < count; r++) {
    h += '<tr>';
    if (showCheckboxes) {
      h += '<td style="border:none;padding:10px 14px;"><div class="skeleton" style="width:16px;height:16px;border-radius:4px;"></div></td>';
    }
    for (var c = 0; c < cols; c++) {
      var w = 50 + Math.floor(Math.random() * 40);
      h += '<td style="border:none;padding:10px 14px;"><div class="skeleton" style="width:' + w + '%;height:14px;border-radius:4px;"></div></td>';
    }
    h += '</tr>';
  }
  return h;
}

function v(val, fallback) { return (val !== undefined && val !== null && val !== '') ? val : (fallback || '—'); }

function fmtCurrency(n) { return fmt(n) + 'đ'; }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('vi-VN') : '—'; }
function fmtDateTime(d) { return d ? new Date(d).toLocaleString('vi-VN') : '—'; }

function cellContent(row, col, idx) {
  if (col.key === 'index' || col.render === 'rowIndex') {
    return (PAGE - 1) * LIMIT + idx + 1;
  }
  var val = deepGet(row, col.key);
  if ((val === null || val === undefined || val === '') && col.key === 'shippingInfo.customerName') {
    val = row.customerName || deepGet(row, 'userId.username') || deepGet(row, 'userId.email') || 'Khách hàng';
  }
  if (col.format === 'currency') return fmtCurrency(val);
  if (col.format === 'date') return fmtDate(val);
  if (col.format === 'dateTime') return fmtDateTime(val);

  if (col.render === 'status') {
    var s = val || '';
    var label = (col.statusMap && col.statusMap[s]) || s || (col.fallbackStatus || 'Ẩn');
    var badgeClass = 'badge-status ' + (s || 'archived');
    return '<span class="' + badgeClass + '">' + label + '</span>';
  }
  if (col.render === 'orderStatus') {
    var s = val || '';
    var label = STATUS_LABELS[s] || s;
    var color = COLORS[s] || '#94a3b8';
    return '<span style="color:' + color + '">' + label + '</span>';
  }
  if (col.render === 'role') {
    var rc = { ADMIN: '#ef4444', USER: '#22c55e' };
    return '<span style="color:' + (rc[val] || '#94a3b8') + '">' + v(val) + '</span>';
  }
  if (col.render === 'voucherValue') {
    if (row.type === 'percentage') return (Number(row.value) || 0) + '%';
    return fmtCurrency(row.value);
  }
  if (col.render === 'voucherApplicableTo') {
    var mapping = { all: 'Toàn sàn', membership: 'Thành viên', minigame: 'Mini games' };
    var label = mapping[val] || 'Toàn sàn';
    var color = val === 'membership' ? '#3b82f6' : (val === 'minigame' ? '#8b5cf6' : '#22c55e');
    return '<span style="color:' + color + '; font-weight: 600;">' + label + '</span>';
  }
  if (col.render === 'voucherActions') {
    var editUrl = (C.editEndpoint || C.detailEndpoint || '').replace(':id', row._id);
    var deleteUrl = C.deleteEndpoint ? C.deleteEndpoint.replace(':id', row._id) : '';
    var codeName = escapeHtml(row.code || row._id || '').replace(/'/g, "\\'");
    var deleteOnClick = 'deleteItemConfirm(\'' + row._id + '\', \'' + codeName + '\', \'' + deleteUrl + '\', event)';
    return '<div class="row-actions-cell" style="display:flex;align-items:center;justify-content:flex-end;gap:6px;" onclick="event.stopPropagation()">' +
             '<a href="' + editUrl + '" class="btn-action-icon edit-btn" title="Chỉnh sửa" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);transition:all 0.2s;" onmouseover="this.style.color=\'#3b82f6\';this.style.borderColor=\'#3b82f6\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
               '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>' +
             '</a>' +
             '<button type="button" class="btn-action-icon delete-btn" title="Xóa" onclick="' + deleteOnClick + '" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color=\'#ef4444\';this.style.borderColor=\'#ef4444\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
               '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
             '</button>' +
           '</div>';
  }
  if (col.render === 'brandLogo') {
    var logoUrl = row.logo || val || '';
    var name = escapeHtml(row.name || '');
    var origin = escapeHtml(row.origin || '');
    var imgHtml = logoUrl 
      ? '<img src="' + escapeHtml(logoUrl) + '" alt="" style="width:36px;height:36px;object-fit:contain;border-radius:6px;border:1px solid var(--border);background:#fff;padding:2px;" onerror="this.style.display=\'none\'" />'
      : '<div style="width:36px;height:36px;border-radius:6px;background:var(--border);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--text-muted);font-size:14px;">' + (name ? name.charAt(0).toUpperCase() : 'B') + '</div>';
    
    return '<div style="display:flex;align-items:center;gap:10px;">' +
             imgHtml +
             '<div style="display:flex;flex-direction:column;gap:2px;">' +
               '<span style="font-weight:600;color:var(--text-primary);font-size:13.5px;">' + name + '</span>' +
               (origin ? '<span style="font-size:11px;color:var(--text-muted);">' + origin + '</span>' : '') +
             '</div>' +
           '</div>';
  }
  if (col.render === 'brandProductCount') {
    var cnt = Number(val || row.productCount || row.productsCount || 0);
    var brandId = row._id || '';
    var filterUrl = '/admin/products?brand=' + encodeURIComponent(brandId);
    return '<a href="' + filterUrl + '" style="font-weight:600;color:var(--accent);font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:4px;" title="Xem các sản phẩm của thương hiệu này" onmouseover="this.style.textDecoration=\'underline\'" onmouseout="this.style.textDecoration=\'none\'">' +
             cnt + ' sản phẩm' +
             '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
           '</a>';
  }
  if (col.render === 'brandActions') {
    var editUrl = (C.editEndpoint || C.detailEndpoint || '').replace(':id', row._id);
    var deleteUrl = C.deleteEndpoint ? C.deleteEndpoint.replace(':id', row._id) : '';
    var deleteOnClick = 'deleteItemConfirm(\'' + row._id + '\', \'' + escapeHtml(row.name || '').replace(/'/g, "\\'") + '\', \'' + deleteUrl + '\', event)';
    return '<div class="row-actions-cell" style="display:flex;align-items:center;justify-content:flex-end;gap:6px;" onclick="event.stopPropagation()">' +
             '<a href="' + editUrl + '" class="btn-action-icon edit-btn" title="Chỉnh sửa" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);transition:all 0.2s;" onmouseover="this.style.color=\'#3b82f6\';this.style.borderColor=\'#3b82f6\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
               '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>' +
             '</a>' +
             '<button type="button" class="btn-action-icon delete-btn" title="Xóa" onclick="' + deleteOnClick + '" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color=\'#ef4444\';this.style.borderColor=\'#ef4444\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
               '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
             '</button>' +
           '</div>';
  }
  if (col.render === 'categoryProductCount') {
    var cnt = Number(val || row.productCount || row.productsCount || 0);
    var catId = row._id || '';
    var filterUrl = '/admin/products?category=' + encodeURIComponent(catId);
    return '<a href="' + filterUrl + '" style="font-weight:600;color:var(--accent);font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:4px;" title="Xem các sản phẩm của danh mục này" onmouseover="this.style.textDecoration=\'underline\'" onmouseout="this.style.textDecoration=\'none\'">' +
             cnt + ' sản phẩm' +
             '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
           '</a>';
  }
  if (col.render === 'categoryActions') {
    var editUrl = (C.editEndpoint || C.detailEndpoint || '').replace(':id', row._id);
    var deleteUrl = C.deleteEndpoint ? C.deleteEndpoint.replace(':id', row._id) : '';
    var deleteOnClick = 'deleteItemConfirm(\'' + row._id + '\', \'' + escapeHtml(row.name || '').replace(/'/g, "\\'") + '\', \'' + deleteUrl + '\', event)';
    return '<div class="row-actions-cell" style="display:flex;align-items:center;justify-content:flex-end;gap:6px;" onclick="event.stopPropagation()">' +
             '<a href="' + editUrl + '" class="btn-action-icon edit-btn" title="Chỉnh sửa" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);transition:all 0.2s;" onmouseover="this.style.color=\'#3b82f6\';this.style.borderColor=\'#3b82f6\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
               '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>' +
             '</a>' +
             '<button type="button" class="btn-action-icon delete-btn" title="Xóa" onclick="' + deleteOnClick + '" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);color:var(--text-muted);background:var(--bg);cursor:pointer;transition:all 0.2s;" onmouseover="this.style.color=\'#ef4444\';this.style.borderColor=\'#ef4444\'" onmouseout="this.style.color=\'var(--text-muted)\';this.style.borderColor=\'var(--border)\'">' +
               '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
             '</button>' +
           '</div>';
  }

  ORDER_END_DATE = '';
  var endDateEl = document.getElementById('crud-order-end-date');
  if (endDateEl) endDateEl.value = '';
  var orderStatusEl = document.getElementById('crud-order-status-filter');
  if (orderStatusEl) orderStatusEl.value = '';

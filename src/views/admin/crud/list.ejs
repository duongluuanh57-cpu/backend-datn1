  if (col.render === 'productThumbnail') {
    if (!val) return '<div class="product-thumb-empty" style="width:40px;height:40px;border-radius:6px;background:var(--border);display:inline-block;"></div>';
    return '<img src="' + escapeHtml(val) + '" alt="" class="product-thumb-img" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid var(--border);background:#fff;" onerror="this.src=\'/assets/images/placeholder.jpg\'" />';
  }
  if (col.render === 'productInfo') {

  // ── Multi-select brand state ──
var BRAND_IDS = BRAND ? BRAND.split(',').filter(Boolean) : [];
var BRAND_DATA = [];

function toggleBrandDropdown() {
  var dd = document.getElementById('crud-brand-dropdown');
  if (!dd) return;
  dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
}

function updateBrandLabel() {
  var label = document.getElementById('crud-brand-label');
  if (!label) return;
  if (BRAND_IDS.length === 0) {
    label.textContent = 'Tất cả thương hiệu';
  } else if (BRAND_IDS.length === 1) {
    var found = BRAND_DATA.find(function(b) { return b._id === BRAND_IDS[0]; });
    label.textContent = found ? found.name : '1 thương hiệu';
  } else {
    label.textContent = 'Đã chọn ' + BRAND_IDS.length + ' thương hiệu';
  }
}

function renderBrandOptions(filter) {
  var container = document.getElementById('crud-brand-options');
  if (!container) return;
  container.innerHTML = '';
  var keyword = (filter || '').toLowerCase().trim();
  var list = keyword ? BRAND_DATA.filter(function(b) { return b.name.toLowerCase().indexOf(keyword) !== -1; }) : BRAND_DATA;
  list.forEach(function(b) {
    var div = document.createElement('div');
    div.className = 'filter-multi-option';
    var cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.checked = BRAND_IDS.indexOf(b._id) !== -1;
    cb.onchange = function() {
      if (cb.checked) {
        if (BRAND_IDS.indexOf(b._id) === -1) BRAND_IDS.push(b._id);
      } else {
        BRAND_IDS = BRAND_IDS.filter(function(id) { return id !== b._id; });
      }
      updateBrandLabel();
      BRAND = BRAND_IDS.join(',');
      PAGE = 1;
      crudFetch();
    };
    div.appendChild(cb);
    var span = document.createElement('span');
    span.textContent = b.name;
    span.style.cssText = 'overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0;';
    div.appendChild(span);
    container.appendChild(div);
  });
}

function filterBrandOptions(val) {
  renderBrandOptions(val);
}


<%# Generic CRUD List Template — client-side fetch with bulk actions %>
<script>window.__API_TOKEN__='<%= apiToken %>';window.__ADMIN_CONFIG__=<%- config %>;</script>

<div id="crud-app">
  <!-- ── Filter Bar (Compact, Flowbite-style) ── -->
  <div id="crud-filter-bar" class="filter-bar">
    <!-- Row 1: Search + Quick filters -->
    <div class="filter-row filter-row-1">
      <div class="filter-search-wrap">
        <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="crud-search" class="filter-search" placeholder="">
      </div>

      <!-- Brand dropdown (product only) -->
      <div id="crud-brand-filter" class="filter-multi-select" style="display:none;">
        <button class="filter-multi-btn" onclick="event.stopPropagation();toggleBrandDropdown()">
          <svg class="filter-btn-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span id="crud-brand-label">Thương hiệu</span>
          <svg class="filter-btn-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="crud-brand-dropdown" class="filter-multi-dropdown" style="display:none;">
          <div class="filter-multi-options" id="crud-brand-options"></div>
        </div>
      </div>

      <!-- Category dropdown (product only) -->
      <div id="crud-category-filter" class="filter-multi-select" style="display:none;">
        <button class="filter-multi-btn" onclick="event.stopPropagation();toggleCategoryDropdown()">
          <svg class="filter-btn-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span id="crud-category-label">Danh mục</span>
          <svg class="filter-btn-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="crud-category-dropdown" class="filter-multi-dropdown" style="display:none;">
          <div class="filter-multi-options" id="crud-category-options"></div>
        </div>
      </div>

      <!-- Stock filter (product only) -->
      <div class="filter-select-wrap" style="display:none;" id="crud-stock-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        <select id="crud-stock-filter" class="filter-select">
          <option value="">Tồn kho</option>
          <option value="inStock">Còn hàng</option>
          <option value="lowStock">Sắp hết</option>
          <option value="outOfStock">Hết hàng</option>
        </select>
      </div>

      <!-- Sort filter -->
      <div class="filter-select-wrap" style="display:none;" id="crud-sort-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5h10M11 9h7M11 13h4"/><path d="M3 4v16"/><path d="M3 4l4 4-4 4"/></svg>
        <select id="crud-sort-filter" class="filter-select">
          <option value="">Sắp xếp</option>
          <option value="bestSeller">Bán chạy</option>
          <option value="priceAsc">Giá ↑</option>
          <option value="priceDesc">Giá ↓</option>
        </select>
      </div>

      <!-- Total + Clear -->
      <div class="filter-actions">
        <span class="filter-total"><span id="crud-total-label">Tổng cộng</span>: <b id="crud-total">0</b></span>
        <a id="crud-clear-search" href="#" class="filter-clear">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Xoá lọc
        </a>
      </div>
    </div>

    <!-- Row 2: Advanced filters (product only, collapsible) -->
    <div id="crud-advanced-filters" class="filter-row-advanced" style="display:none;">
      <div class="filter-row">
        <div class="filter-select-wrap">
          <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <select id="crud-status-filter" class="filter-select">
            <option value="">Trạng thái</option>
            <option value="draft">Bản nháp</option>
            <option value="active">Đang bán</option>
            <option value="archived">Đã ẩn</option>
          </select>
        </div>

        <div class="filter-price-wrap">
          <input type="number" id="crud-price-min" class="filter-price-input" placeholder="Từ">
          <span class="filter-price-sep">—</span>
          <input type="number" id="crud-price-max" class="filter-price-input" placeholder="Đến">
        </div>

        <button type="button" id="crud-needs-supplement-btn" class="filter-btn-toggle filter-toggle-amber">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          Cần bổ sung
        </button>

        <button type="button" id="crud-out-of-stock-btn" class="filter-btn-toggle filter-toggle-red">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          Hết hàng
        </button>
      </div>
    </div>

    <!-- ── Order Filters (hidden by default, shown when entityName === 'order') ── -->
    <div id="crud-order-filters" class="filter-row" style="display:none;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);">
      <!-- Order status filter -->
      <div class="filter-select-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <select id="crud-order-status-filter" class="filter-select">
          <option value="">Trạng thái</option>
          <option value="pending">Chờ xác nhận</option>
          <option value="processing">Đang xử lý</option>
          <option value="shipped">Đang giao hàng</option>
          <option value="delivered">Hoàn thành</option>
          <option value="cancelled">Đã hủy</option>
        </select>
      </div>

      <!-- Cancel request toggle -->
      <button type="button" id="crud-cancel-request-btn" class="filter-btn-toggle filter-toggle-red">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        Yêu cầu hủy
      </button>

      <!-- Date range -->
      <div class="filter-date-wrap" style="display:flex;align-items:center;gap:6px;">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-muted);flex-shrink:0;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <input type="date" id="crud-order-start-date" class="filter-date-input" style="padding:7px 10px;background:var(--color-background-body);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:12px;font-family:inherit;outline:none;width:140px;" />
        <span style="color:var(--text-muted);font-size:12px;">→</span>
        <input type="date" id="crud-order-end-date" class="filter-date-input" style="padding:7px 10px;background:var(--color-background-body);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:12px;font-family:inherit;outline:none;width:140px;" />
      </div>

      <!-- Sort filter -->
      <div class="filter-select-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5h10M11 9h7M11 13h4"/><path d="M3 4v16"/><path d="M3 4l4 4-4 4"/></svg>
        <select id="crud-order-sort-filter" class="filter-select">
          <option value="newest">Mới nhất</option>
          <option value="oldest">Cũ nhất</option>
          <option value="totalAsc">Giá trị ↑</option>
          <option value="totalDesc">Giá trị ↓</option>
        </select>
      </div>
    </div>

    <!-- ── Review Filters (shown when entityName === 'review') ── -->
    <div id="crud-review-filters" class="filter-row" style="display:none;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);gap:12px;">
      <!-- Review status filter -->
      <div class="filter-select-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <select id="crud-review-status-filter" class="filter-select">
          <option value="">Trạng thái duyệt</option>
          <option value="pending">Chờ duyệt AI</option>
          <option value="rejected">Không được duyệt</option>
          <option value="visible">Hiển thị</option>
          <option value="hidden">Đã ẩn</option>
        </select>
      </div>

      <!-- Rating filter -->
      <div class="filter-select-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <select id="crud-review-rating-filter" class="filter-select">
          <option value="">Số sao đánh giá</option>
          <option value="5">5 sao ★★★★★</option>
          <option value="4">4 sao ★★★★</option>
          <option value="3">3 sao ★★★</option>
          <option value="2">2 sao ★★</option>
          <option value="1">1 sao ★</option>
        </select>
      </div>
    </div>

    <!-- ── Voucher Filters (shown when entityName === 'voucher') ── -->
    <div id="crud-voucher-filters" class="filter-row" style="display:none;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);gap:12px;">
      <div class="filter-select-wrap">
        <svg class="filter-select-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        <select id="crud-voucher-scope-filter" class="filter-select">
          <option value="">Tất cả phân loại</option>
          <option value="all">Toàn sàn</option>
          <option value="membership">Hạng thành viên</option>
          <option value="minigame">Mini Game (5 mã cố định)</option>
        </select>
      </div>
    </div>

    <!-- ── Brand Filters (shown when entityName === 'brand') ── -->
    <div id="crud-brand-filters" class="filter-row" style="display:none;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);">
      <div class="filter-search-wrap">
        <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="crud-origin-filter" class="filter-search" placeholder="Xuất xứ..." style="width:180px;">
      </div>
      <span style="color:var(--text-muted);font-size:12px;align-self:center;">Gõ tên nước xuất xứ để lọc nhanh</span>
    </div>

    <!-- Toggle advanced filters (product only) -->
    <button id="crud-toggle-advanced" class="filter-toggle-link" style="display:none;" onclick="toggleAdvancedFilters()">
      <svg class="filter-toggle-chevron" id="crud-toggle-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      Bộ lọc nâng cao
    </button>
  </div>

  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead><tr id="crud-thead"></tr></thead>
      <tbody id="crud-tbody">
      </tbody>
    </table>
  </div>

  <div id="crud-pagination" style="display:flex;justify-content:center;gap:6px;margin-top:20px;"></div>
</div>

<!-- ── Bulk action bar (toast) ── -->
<div id="bulk-bar" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);display:none;align-items:center;gap:12px;background:#1e1e2e;color:#fff;padding:10px 20px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.3);z-index:1000;font-size:14px;">
  <span id="bulk-count">0 sản phẩm đã chọn</span>
  <button onclick="bulkDelete()" id="bulk-delete-btn" style="background:#ef4444;color:#fff;border:none;padding:6px 16px;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px;"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:4px;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>Xóa</button>
  <button onclick="clearBulkSelection()" style="background:none;border:1px solid rgba(255,255,255,0.3);color:rgba(255,255,255,0.7);padding:6px 12px;border-radius:8px;cursor:pointer;font-size:13px;">✕ Bỏ chọn</button>
</div>



<script>
var C = window.__ADMIN_CONFIG__;

// Khôi phục trạng thái từ URL
var URL_PARAMS = new URLSearchParams(window.location.search);
var PAGE = parseInt(URL_PARAMS.get('page'), 10) || 1;
var SEARCH = URL_PARAMS.get('search') || '';
var CATEGORY = URL_PARAMS.get('category') || '';
var BRAND = URL_PARAMS.get('brand') || '';
var STOCK = URL_PARAMS.get('stock') || '';
var SORT = URL_PARAMS.get('sortBy') || '';
var STATUS = URL_PARAMS.get('status') || '';
var PRICE_MIN = URL_PARAMS.get('minPrice') || '';
var PRICE_MAX = URL_PARAMS.get('maxPrice') || '';
var CANCEL_REQUESTED = URL_PARAMS.get('cancelRequested') || '';
var ORDER_START_DATE = URL_PARAMS.get('startDate') || '';
var ORDER_END_DATE = URL_PARAMS.get('endDate') || '';
var ORIGIN = URL_PARAMS.get('origin') || '';
var REVIEW_RATING = URL_PARAMS.get('rating') || '';
var APPLICABLE_TO = URL_PARAMS.get('applicableTo') || '';
var LIMIT = 30;
var TOTAL_PAGES = 1;
var ALL_ITEMS = [];       // current page items (with _id)
var SELECTED = new Set(); // set of selected _id

// ── Lưu/khôi phục trạng thái lọc (localStorage theo từng entity) ──
var LS_FILTER_KEY = 'crud-filters-' + (C.entityName || 'entity');
var HAS_URL_FILTERS = (PAGE > 1) || SEARCH || CATEGORY || BRAND || STOCK || SORT || STATUS || PRICE_MIN || PRICE_MAX || CANCEL_REQUESTED || ORDER_START_DATE || ORDER_END_DATE || ORIGIN || REVIEW_RATING || APPLICABLE_TO;
if (!HAS_URL_FILTERS) {
  try {
    var savedF = JSON.parse(localStorage.getItem(LS_FILTER_KEY) || 'null');
    if (savedF) {
      if (savedF.page > 1) PAGE = savedF.page;
      if (savedF.search) SEARCH = savedF.search;
      if (savedF.category) CATEGORY = savedF.category;
      if (savedF.brand) BRAND = savedF.brand;
      if (savedF.stock) STOCK = savedF.stock;
      if (savedF.sortBy) SORT = savedF.sortBy;
      if (savedF.status) STATUS = savedF.status;
      if (savedF.minPrice) PRICE_MIN = savedF.minPrice;
      if (savedF.maxPrice) PRICE_MAX = savedF.maxPrice;
      if (savedF.cancelRequested) CANCEL_REQUESTED = savedF.cancelRequested;
      if (savedF.startDate) ORDER_START_DATE = savedF.startDate;
      if (savedF.endDate) ORDER_END_DATE = savedF.endDate;
      if (savedF.origin) ORIGIN = savedF.origin;
      if (savedF.rating) REVIEW_RATING = savedF.rating;
      if (savedF.applicableTo) APPLICABLE_TO = savedF.applicableTo;
    }
  } catch (e) {}
}

<%- include('admin/partials/utils') %>

var COLORS = { pending:'#f59e0b', processing:'#3b82f6', shipped:'#8b5cf6', delivered:'#22c55e', cancelled:'#ef4444' };
var STATUS_LABELS = { pending:'Chờ XN', processing:'Đang XL', shipped:'Đang giao hàng', delivered:'Hoàn thành', cancelled:'Đã hủy' };

document.getElementById('crud-search').placeholder = C.searchPlaceholder || 'Tìm kiếm...';
document.getElementById('crud-search').value = SEARCH;
document.getElementById('crud-search').addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); crudSearch(); } });

function syncUrl() {
  var p = new URLSearchParams();
  if (PAGE > 1) p.set('page', PAGE);
  if (SEARCH) p.set('search', SEARCH);
  if (CATEGORY) p.set('category', CATEGORY);
  if (BRAND) p.set('brand', BRAND);
  if (STOCK) p.set('stock', STOCK);
  if (SORT) p.set('sortBy', SORT);
  if (STATUS) p.set('status', STATUS);
  if (PRICE_MIN) p.set('minPrice', PRICE_MIN);
  if (PRICE_MAX) p.set('maxPrice', PRICE_MAX);
  if (CANCEL_REQUESTED) p.set('cancelRequested', CANCEL_REQUESTED);
  if (ORDER_START_DATE) p.set('startDate', ORDER_START_DATE);
  if (ORDER_END_DATE) p.set('endDate', ORDER_END_DATE);
  if (ORIGIN) p.set('origin', ORIGIN);
  if (REVIEW_RATING) p.set('rating', REVIEW_RATING);
  if (APPLICABLE_TO) p.set('applicableTo', APPLICABLE_TO);
  var qs = p.toString();
  var url = window.location.pathname + (qs ? '?' + qs : '');
  history.replaceState(null, '', url);
  try {
    localStorage.setItem(LS_FILTER_KEY, JSON.stringify({
      page: PAGE, search: SEARCH, category: CATEGORY, brand: BRAND, stock: STOCK,
      sortBy: SORT, status: STATUS, minPrice: PRICE_MIN, maxPrice: PRICE_MAX,
      cancelRequested: CANCEL_REQUESTED, startDate: ORDER_START_DATE, endDate: ORDER_END_DATE,
      origin: ORIGIN, rating: REVIEW_RATING, applicableTo: APPLICABLE_TO
    }));
  } catch (e) {}
}

// ── Build header with checkbox column ──
var thead = document.getElementById('crud-thead');
var showCheckboxes = C.entityName === 'product';

if (showCheckboxes) {
  var thCheck = document.createElement('th');
  thCheck.className = 'checkbox-col';
  var cbAll = document.createElement('input');
  cbAll.type = 'checkbox';
  cbAll.title = 'Chọn tất cả';
  cbAll.onchange = function() { toggleSelectAll(this.checked); };
  thCheck.appendChild(cbAll);
  thead.appendChild(thCheck);
}

C.columns.forEach(function(c) {
  var th = document.createElement('th');
  th.textContent = c.label;
  thead.appendChild(th);
});

function skeletonRows(count, cols) {
  var h = '';
  for (var r = 0; r < count; r++) {
    h += '<tr>';
    if (showCheckboxes) {
      h += '<td style="border:none;padding:10px 14px;"><div class="skeleton" style="width:16px;height:16px;border-radius:4px;"></div></td>';
    }
    for (var c = 0; c < cols; c++) {
      var w = 50 + Math.floor(Math.random() * 40);
      h += '<td style="border:none;padding:10px 14px;"><div class="skeleton" style="width:' + w + '%;height:14px;border-radius:4px;"></div></td>';
    }
    h += '</tr>';
  }
  return h;
}

function v(val, fallback) { return (val !== undefined && val !== null && val !== '') ? val : (fallback || '—'); }

function fmtCurrency(n) { return fmt(n) + 'đ'; }
function fmtDate(d) { return d ? new Date(d).toLocaleDateString('vi-VN') : '—'; }
function fmtDateTime(d) { return d ? new Date(d).toLocaleString('vi-VN') : '—'; }

function cellContent(row, col, idx) {
  if (col.key === 'index' || col.render === 'rowIndex') {
    return (PAGE - 1) * LIMIT + idx + 1;
  }
  var val = deepGet(row, col.key);
  if ((val === null || val === undefined || val === '') && col.key === 'shippingInfo.customerName') {
    val = deepGet(row, 'userId.username') || deepGet(row, 'userId.email') || 'Khách hàng';
  }
  if (col.format === 'currency') return fmtCurrency(val);
  if (col.format === 'date') return fmtDate(val);
  if (col.format === 'dateTime') return fmtDateTime(val);

  if (col.render === 'status') {
    var s = val || '';
    var label = (col.statusMap && col.statusMap[s]) || s || (col.fallbackStatus || 'Ẩn');
    var badgeClass = 'badge-status ' + (s || 'archived');
    return '<span class="' + badgeClass + '">' + label + '</span>';
  }
  if (col.render === 'orderStatus') {
    var s = val || '';
    var label = STATUS_LABELS[s] || s;
    var color = COLORS[s] || '#94a3b8';
    return '<span style="color:' + color + '">' + label + '</span>';
  }
  if (col.render === 'role') {
    var rc = { ADMIN: '#ef4444', SUBADMIN: '#f59e0b', USER: '#22c55e' };
    return '<span style="color:' + (rc[val] || '#94a3b8') + '">' + v(val) + '</span>';
  }
  if (col.render === 'voucherValue') {
    if (row.type === 'percentage') return (Number(row.value) || 0) + '%';
    return fmtCurrency(row.value);
  }
  if (col.render === 'voucherApplicableTo') {
    var mapping = { all: 'Toàn sàn', membership: 'Thành viên', minigame: 'Mini games' };
    var label = mapping[val] || 'Toàn sàn';
    var color = val === 'membership' ? '#3b82f6' : (val === 'minigame' ? '#8b5cf6' : '#22c55e');
    return '<span style="color:' + color + '; font-weight: 600;">' + label + '</span>';
  }
  if (col.render === 'image') {
    if (!val) return '<span class="product-thumb-empty"></span>';
    return '<div class="product-thumb-cell"><img src="' + escapeHtml(val) + '" alt="" class="product-thumb" onerror="this.style.display=\'none\'" /><div class="product-info"><span class="product-name">' + escapeHtml(row.name || '') + '</span><span class="product-sku">' + (row.sku || row._id?.slice(-6).toUpperCase() || '') + '</span></div></div>';
  }
  if (col.render === 'reviewProduct') {
    return v(val && val.name);
  }
  if (col.render === 'reviewUser') {
    return v(val && (val.name || val.email));
  }
  if (col.render === 'cancelRequest') {
    if (val) {
      return '<span style="display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(239,68,68,0.12);color:#ef4444;"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg> Có</span>';
    }
    return '<span style="color:var(--text-muted);font-size:12px;">—</span>';
  }
  if (col.render === 'editableStatus') {
    var sid = row._id;
    var sopts = col.statusOptions || [
      {v:'draft',l:'Nháp'},
      {v:'active',l:'Đang bán'},
      {v:'archived',l:'Đã ẩn'}
    ];
    var curLabel = '';
    sopts.forEach(function(o) { if (o.v === val) curLabel = o.l; });
    if (!curLabel) curLabel = val || '';

    // Check if it's the order status endpoint
    var isOrder = col.statusApiEndpoint && col.statusApiEndpoint.indexOf('/orders/') !== -1;

    if (row.cancelRequested || (isOrder && (val === 'delivered' || val === 'cancelled'))) {
      // Đơn có yêu cầu hủy hoặc đã hoàn thành/hủy — khóa đổi trạng thái
      return '<span class="filter-status-select status-' + (val || '') + ' status-static">' + escapeHtml(curLabel) + '</span>';
    }

    if (isOrder) {
      if (val === 'pending') {
        sopts = [{v:'processing', l:'Đang xử lý'}];
      } else if (val === 'processing') {
        sopts = [{v:'shipped', l:'Đang giao hàng'}];
      } else if (val === 'shipped') {
        sopts = [{v:'delivered', l:'Hoàn thành'}];
      } else {
        sopts = [];
      }
    }

    var optsJson = JSON.stringify(sopts).replace(/'/g, '&#39;').replace(/"/g, '&quot;');
    return '<div class="status-dd-wrap">' +
      '<button type="button" class="filter-status-select status-' + (val || '') + '"' +
        ' data-id="' + sid + '"' +
        ' data-api="' + (col.statusApiEndpoint || '') + '"' +
        ' data-opts=\'' + optsJson + '\'' +
        ' onclick="toggleStatusPopup(this, event)">' + escapeHtml(curLabel) +
      '</button></div>';
  }
  if (col.render === 'editableFlashSale') {
    var sid = row._id;
    var fsOpts = col.flashSaleOptions || [];
    var currentFsId = row.flashSaleId || '';
    var displayLabel = row.flashSale || '';
    var hasFs = Boolean(currentFsId || displayLabel);

    if (fsOpts.length === 0 && !hasFs) {
      return '<div class="status-dd-wrap" onclick="event.stopPropagation()">' +
        '<button type="button" class="filter-status-select status-draft" style="opacity:0.6;cursor:not-allowed;"' +
          ' onclick="showToast(\'Chưa có sự kiện Flash Sale nào. Vui lòng tạo sự kiện trong Quản lý Flash Sale trước!\', \'info\'); event.stopPropagation();">+ Gán sự kiện</button></div>';
    }

    var labelText = hasFs ? escapeHtml(displayLabel) : '+ Gán sự kiện';
    var badgeClass = hasFs ? 'status-active' : 'status-draft';

    var fsOptsJson = JSON.stringify(fsOpts).replace(/'/g, '&#39;').replace(/"/g, '&quot;');
    return '<div class="status-dd-wrap" onclick="event.stopPropagation()">' +
      '<button type="button" class="filter-status-select ' + badgeClass + '"' +
        ' data-id="' + sid + '"' +
        ' data-fsid="' + currentFsId + '"' +
        ' data-fsopts=\'' + fsOptsJson + '\'' +
        ' onclick="toggleFlashSalePopup(this, event)">' + labelText +
      '</button></div>';
  }
  return v(val);
}

function deepGet(obj, path) {
  if (!path) return obj;
  return path.split('.').reduce(function(o, k) { return (o && o[k] !== undefined) ? o[k] : null; }, obj);
}

// ── Bulk selection ──
function toggleSelectAll(checked) {
  ALL_ITEMS.forEach(function(row) {
    if (checked) { SELECTED.add(row._id); }
    else         { SELECTED.delete(row._id); }
  });
  updateBulkBar();
  updateSelectAllCb();
  rerenderCheckboxes();
}

function toggleSelectOne(id, checked) {
  if (checked) { SELECTED.add(id); } else { SELECTED.delete(id); }
  updateBulkBar();
  updateSelectAllCb();
}

function updateBulkBar() {
  var bar = document.getElementById('bulk-bar');
  var count = SELECTED.size;
  if (count > 0) {
    bar.style.display = 'flex';
    var bulkLabels = { product:'sản phẩm', brand:'thương hiệu', category:'danh mục', tag:'tag', order:'đơn hàng', review:'đánh giá', voucher:'mã giảm giá', user:'người dùng' };
    var entityLabel = bulkLabels[C.entityName] || 'mục';
    document.getElementById('bulk-count').textContent = count + ' ' + entityLabel + ' đã chọn';
    document.getElementById('bulk-delete-btn').textContent = '🗑 Xóa (' + count + ')';
  } else {
    bar.style.display = 'none';
  }
}

function updateSelectAllCb() {
  var cb = thead.querySelector('input[type="checkbox"]');
  if (!cb) return;
  if (ALL_ITEMS.length === 0) { cb.checked = false; cb.indeterminate = false; return; }
  var allSelected = ALL_ITEMS.every(function(r) { return SELECTED.has(r._id); });
  var someSelected = ALL_ITEMS.some(function(r) { return SELECTED.has(r._id); });
  cb.checked = allSelected;
  cb.indeterminate = someSelected && !allSelected;
}

function rerenderCheckboxes() {
  var rows = document.querySelectorAll('#crud-tbody tr[data-id]');
  rows.forEach(function(tr) {
    var cb = tr.querySelector('input[type="checkbox"]');
    if (cb) cb.checked = SELECTED.has(tr.getAttribute('data-id'));
    tr.classList.toggle('selected', SELECTED.has(tr.getAttribute('data-id')));
  });
}

function clearBulkSelection() {
  SELECTED.clear();
  updateBulkBar();
  updateSelectAllCb();
  rerenderCheckboxes();
}

function bulkDelete() {
  var ids = Array.from(SELECTED);
  if (ids.length === 0) return;
  var endpoint = C.bulkDeleteEndpoint || '';
  if (!endpoint) {
    showToast('Mục này không hỗ trợ xóa hàng loạt', 'error');
    return;
  }
  var bulkLabels = { product:'sản phẩm', brand:'thương hiệu', category:'danh mục', tag:'tag', order:'đơn hàng', review:'đánh giá', voucher:'mã giảm giá', user:'người dùng' };
  var label = bulkLabels[C.entityName] || 'mục';
  showToast('Đang xóa ' + ids.length + ' ' + label + '...', 'info');

  fetch(endpoint, {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + window.__API_TOKEN__, 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: ids })
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success) {
        showToast('Đã xóa ' + ids.length + ' ' + label + ' thành công!', 'success');
        SELECTED.clear();
        updateBulkBar();
        crudFetch();
      } else {
        showToast('Lỗi: ' + (res.message || 'Không thể xóa'), 'error');
      }
    })
    .catch(function() {
      showToast('Lỗi kết nối đến server', 'error');
    });
}

// ── Inline status change (generic) ──
function changeProductStatus(id, status) {
  fetch('/api/products/' + id, {
    method: 'PATCH',
    headers: { 'Authorization': 'Bearer ' + window.__API_TOKEN__, 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: status })
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success) {
        showToast('Đã cập nhật trạng thái', 'success');
      } else {
        showToast(res.message || 'Không thể cập nhật', 'error');
      }
    })
    .catch(function() {
      showToast('Lỗi kết nối', 'error');
    });
}

function changeEntityStatus(sel, id, status, apiEndpoint, label) {
  var url = apiEndpoint ? apiEndpoint.replace(':id', id) : ('/api/' + C.entityName + 's/' + id);
  fetch(url, {
    method: 'PATCH',
    headers: { 'Authorization': 'Bearer ' + window.__API_TOKEN__, 'Content-Type': 'application/json' },
    body: JSON.stringify({ status: status })
  })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.success) {
        if (sel) {
          sel.className = 'filter-status-select status-' + status;
          if (label) sel.textContent = label;

          // Cập nhật options chuyển trạng thái tiếp theo cho Đơn Hàng mà không cần F5
          var isOrder = apiEndpoint && apiEndpoint.indexOf('/orders/') !== -1;
          if (isOrder) {
            var nextOpts = [];
            if (status === 'pending') {
              nextOpts = [{v:'processing', l:'Đang xử lý'}];
            } else if (status === 'processing') {
              nextOpts = [{v:'shipped', l:'Đang giao hàng'}];
            } else if (status === 'shipped') {
              nextOpts = [{v:'delivered', l:'Hoàn thành'}];
            }
            sel.setAttribute('data-opts', JSON.stringify(nextOpts));
          }
        }
        showToast('Đã cập nhật trạng thái thành công', 'success');
        if (typeof crudFetch === 'function') {
          crudFetch();
        }
      } else {
        if (sel) {
          sel.className = 'filter-status-select';
        }
        showToast(res.message || 'Không thể cập nhật', 'error');
      }
    })
    .catch(function() {
      if (sel) {
        sel.className = 'filter-status-select';
      }
      showToast('Lỗi kết nối', 'error');
    });
}

// ── Inline status popup ──
var STATUS_POPUP = null;
var STATUS_POPUP_TRIGGER = null;

function toggleStatusPopup(btn, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  if (STATUS_POPUP && STATUS_POPUP_TRIGGER === btn) {
    closeStatusPopup();
    return;
  }
  openStatusPopup(btn);
}

function openStatusPopup(btn) {
  closeStatusPopup();
  var opts = [];
  try { opts = JSON.parse(btn.getAttribute('data-opts')) || []; } catch (err) { opts = []; }
  var current = '';
  var m = btn.className.match(/status-(\S+)/);
  current = m ? m[1] : '';

  var popup = document.createElement('div');
  popup.className = 'status-dd-popup';
  var html = '';
  opts.forEach(function(o) {
    var active = o.v === current ? ' active' : '';
    html += '<button type="button" class="status-dd-item' + active + '" data-status="' + o.v + '" onclick="pickStatus(this, event)">' +
      '<span class="status-dd-dot status-' + o.v + '"></span>' + escapeHtml(o.l) + '</button>';
  });
  popup.innerHTML = html;

  STATUS_POPUP_TRIGGER = btn;
  btn.classList.add('open');
  document.body.appendChild(popup);

  var r = btn.getBoundingClientRect();
  popup.style.left = r.left + 'px';
  popup.style.top = (r.bottom + 6) + 'px';
  if (r.bottom + popup.offsetHeight + 12 > window.innerHeight) {
    popup.style.top = (r.top - popup.offsetHeight - 6) + 'px';
  }
  // Keep within viewport horizontally
  if (r.left + popup.offsetWidth > window.innerWidth - 8) {
    popup.style.left = Math.max(8, window.innerWidth - popup.offsetWidth - 8) + 'px';
  }
  popup.classList.add('open');
  STATUS_POPUP = popup;
}

function pickStatus(item, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  var btn = STATUS_POPUP_TRIGGER;
  var status = item.getAttribute('data-status');
  var label = item.textContent.trim();
  closeStatusPopup();
  if (btn) changeEntityStatus(btn, btn.getAttribute('data-id'), status, btn.getAttribute('data-api'), label);
}

function closeStatusPopup() {
  if (STATUS_POPUP) {
    STATUS_POPUP.remove();
    STATUS_POPUP = null;
  }
  if (STATUS_POPUP_TRIGGER) {
    STATUS_POPUP_TRIGGER.classList.remove('open');
    STATUS_POPUP_TRIGGER = null;
  }
}

// ── Flash Sale Popup Dropdown ──
var FS_POPUP = null;
var FS_POPUP_TRIGGER = null;

function toggleFlashSalePopup(btn, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  if (FS_POPUP && FS_POPUP_TRIGGER === btn) {
    closeFlashSalePopup();
    return;
  }
  openFlashSalePopup(btn);
}

function openFlashSalePopup(btn) {
  closeFlashSalePopup();
  closeStatusPopup();
  var opts = [];
  try { opts = JSON.parse(btn.getAttribute('data-fsopts')) || []; } catch (err) { opts = []; }
  var currentFsId = btn.getAttribute('data-fsid') || '';

  if (opts.length === 0 && !currentFsId) {
    showToast('Chưa có sự kiện Flash Sale nào. Vui lòng tạo sự kiện trong Quản lý Flash Sale trước!', 'info');
    return;
  }

  var popup = document.createElement('div');
  popup.className = 'status-dd-popup';
  var html = '';

  var activeNone = !currentFsId ? ' active' : '';
  html += '<button type="button" class="status-dd-item' + activeNone + '" data-fsid="" onclick="pickFlashSale(this, event)">' +
    '<span class="status-dd-dot status-archived"></span> Không tham gia sự kiện</button>';

  opts.forEach(function(o) {
    var active = o.v === currentFsId ? ' active' : '';
    html += '<button type="button" class="status-dd-item' + active + '" data-fsid="' + o.v + '" onclick="pickFlashSale(this, event)">' +
      '<span class="status-dd-dot status-active"></span> ' + escapeHtml(o.l) + '</button>';
  });

  popup.innerHTML = html;

  FS_POPUP_TRIGGER = btn;
  btn.classList.add('open');
  document.body.appendChild(popup);

  var r = btn.getBoundingClientRect();
  popup.style.left = r.left + 'px';
  popup.style.top = (r.bottom + 6) + 'px';
  if (r.bottom + popup.offsetHeight + 12 > window.innerHeight) {
    popup.style.top = (r.top - popup.offsetHeight - 6) + 'px';
  }
  if (r.left + popup.offsetWidth > window.innerWidth - 8) {
    popup.style.left = Math.max(8, window.innerWidth - popup.offsetWidth - 8) + 'px';
  }
  popup.classList.add('open');
  FS_POPUP = popup;
}

function pickFlashSale(item, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  var btn = FS_POPUP_TRIGGER;
  var fsId = item.getAttribute('data-fsid') || '';
  var label = item.textContent.trim();
  closeFlashSalePopup();
  if (!btn) return;

  var productId = btn.getAttribute('data-id');

  if (fsId) {
    openDiscountModal(btn, productId, fsId, label);
  } else {
    changeProductFlashSale(btn, productId, '', 0, label);
  }
}

function openDiscountModal(btn, productId, fsId, label) {
  var existingModal = document.getElementById('fs-discount-modal');
  if (existingModal) existingModal.remove();

  var modal = document.createElement('div');
  modal.id = 'fs-discount-modal';
  modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.4);display:flex;align-items:center;justify-content:center;z-index:9999;backdrop-filter:blur(4px);';

  modal.innerHTML = '<div style="background:#FFFFFF;border:1px solid #E8E8E8;border-radius:16px;padding:24px;width:380px;max-width:90vw;box-shadow:0 20px 40px rgba(0,0,0,0.12);color:#1A1A1A;font-family:var(--font-sans, sans-serif);">' +
    '<h3 style="font-size:16px;font-weight:700;margin:0 0 8px 0;color:#1A1A1A;">' +
      'Mức giảm giá Flash Sale' +
    '</h3>' +
    '<p style="font-size:13px;color:#666666;margin:0 0 18px 0;">' +
      'Chọn mức % giảm giá CỘNG THÊM cho sản phẩm này:' +
    '</p>' +
    '<div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">' +
      '<label style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #E8E8E8;border-radius:10px;cursor:pointer;background:#F9F9F8;transition:all 0.2s;">' +
        '<input type="radio" name="fs-disc-opt" value="default" checked style="accent-color:#C9A96E;width:16px;height:16px;cursor:pointer;" onchange="toggleCustomDiscountInput(false)">' +
        '<span style="font-size:13px;font-weight:600;color:#1A1A1A;">Mặc định (+10%)</span>' +
      '</label>' +
      '<label style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #E8E8E8;border-radius:10px;cursor:pointer;background:#F9F9F8;transition:all 0.2s;">' +
        '<input type="radio" name="fs-disc-opt" value="custom" style="accent-color:#C9A96E;width:16px;height:16px;cursor:pointer;" onchange="toggleCustomDiscountInput(true)">' +
        '<span style="font-size:13px;font-weight:600;color:#1A1A1A;">Tự nhập % giảm giá</span>' +
      '</label>' +
      '<div id="fs-custom-input-wrap" style="display:none;margin-top:-4px;padding-left:26px;">' +
        '<div style="display:flex;align-items:center;gap:8px;">' +
          '<input type="number" id="fs-custom-disc-val" min="0" max="100" placeholder="VD: 15" style="width:100px;padding:8px 12px;border-radius:8px;border:1px solid #E8E8E8;background:#FFFFFF;color:#1A1A1A;font-size:13px;font-weight:600;outline:none;" onfocus="this.style.borderColor=\'#C9A96E\'" onblur="this.style.borderColor=\'#E8E8E8\'">' +
          '<span style="font-size:13px;font-weight:600;color:#666666;">% cộng thêm</span>' +
        '</div>' +
      '</div>' +
    '</div>' +
    '<div style="display:flex;justify-content:flex-end;gap:10px;">' +
      '<button type="button" onclick="document.getElementById(\'fs-discount-modal\').remove()" style="padding:8px 18px;border-radius:8px;border:1px solid #E8E8E8;background:#FFFFFF;color:#666666;cursor:pointer;font-size:13px;font-weight:600;transition:all 0.2s;">Hủy</button>' +
      '<button type="button" id="fs-confirm-disc-btn" style="padding:8px 22px;border-radius:8px;border:none;background:#C9A96E;color:#FFFFFF;cursor:pointer;font-size:13px;font-weight:600;box-shadow:0 2px 8px rgba(201,169,110,0.3);transition:all 0.2s;">Xác nhận</button>' +
    '</div>' +
  '</div>';

  document.body.appendChild(modal);

  document.getElementById('fs-confirm-disc-btn').onclick = function() {
    var checkedOpt = document.querySelector('input[name="fs-disc-opt"]:checked');
    var isCustom = checkedOpt && checkedOpt.value === 'custom';
    var extraDiscount = 10;
    if (isCustom) {
      var val = parseInt(document.getElementById('fs-custom-disc-val').value, 10);
      if (isNaN(val) || val < 0 || val > 100) {
        showToast('Vui lòng nhập số % giảm từ 0 đến 100', 'error');
        return;
      }
      extraDiscount = val;
    }
    modal.remove();
    changeProductFlashSale(btn, productId, fsId, extraDiscount, label);
  };
}

function toggleCustomDiscountInput(show) {
  var wrap = document.getElementById('fs-custom-input-wrap');
  if (wrap) {
    wrap.style.display = show ? 'block' : 'none';
    if (show) {
      var input = document.getElementById('fs-custom-disc-val');
      if (input) input.focus();
    }
  }
}

function closeFlashSalePopup() {
  if (FS_POPUP) {
    FS_POPUP.remove();
    FS_POPUP = null;
  }
  if (FS_POPUP_TRIGGER) {
    FS_POPUP_TRIGGER.classList.remove('open');
    FS_POPUP_TRIGGER = null;
  }
}

function changeProductFlashSale(btn, productId, flashSaleId, extraDiscount, label) {
  btn.disabled = true;
  var oldText = btn.textContent;

  fetch('/api/flash-sales/assign-product', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + API_TOKEN
    },
    body: JSON.stringify({
      productId: productId,
      flashSaleId: flashSaleId,
      extraDiscountPercentage: extraDiscount
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    btn.disabled = false;
    if (res.success) {
      if (flashSaleId) {
        btn.textContent = label.replace(/^[\u2715\u26a1]\s*/, '') + ' (-' + extraDiscount + '%)';
        btn.className = 'filter-status-select status-active';
        btn.setAttribute('data-fsid', flashSaleId);
      } else {
        btn.textContent = '+ Gán sự kiện';
        btn.className = 'filter-status-select status-draft';
        btn.setAttribute('data-fsid', '');
      }
      showToast(res.message || 'Cập nhật sự kiện Flash Sale thành công!', 'success');
    } else {
      btn.textContent = oldText;
      showToast(res.message || 'Lỗi cập nhật sự kiện', 'error');
    }
  })
  .catch(function(err) {
    btn.disabled = false;
    btn.textContent = oldText;
    showToast('Lỗi kết nối máy chủ', 'error');
  });
}

document.addEventListener('click', function(e) {
  if (STATUS_POPUP && !(STATUS_POPUP_TRIGGER && STATUS_POPUP_TRIGGER.contains(e.target)) && !STATUS_POPUP.contains(e.target)) {
    closeStatusPopup();
  }
  if (FS_POPUP && !(FS_POPUP_TRIGGER && FS_POPUP_TRIGGER.contains(e.target)) && !FS_POPUP.contains(e.target)) {
    closeFlashSalePopup();
  }
});
window.addEventListener('scroll', function() { closeStatusPopup(); closeFlashSalePopup(); }, { passive: true });
window.addEventListener('resize', function() { closeStatusPopup(); closeFlashSalePopup(); });

// ── Render table ──
function renderTable(items) {
  ALL_ITEMS = items || [];
  var tbody = document.getElementById('crud-tbody');
  if (!items || items.length === 0) {
    tbody.innerHTML = '<tr><td colspan="99" style="text-align:center;padding:40px;color:var(--text-muted);">Không có dữ liệu</td></tr>';
    updateBulkBar();
    return;
  }
  var html = '';
  items.forEach(function(row, idx) {
    var sel = SELECTED.has(row._id) ? ' selected' : '';
    var checked = SELECTED.has(row._id) ? ' checked' : '';
    html += '<tr data-id="' + row._id + '" class="' + sel + '">';
    if (showCheckboxes) {
      html += '<td class="checkbox-col" onclick="event.stopPropagation()"><input type="checkbox" ' + checked + ' onchange="toggleSelectOne(\'' + row._id + '\', this.checked)"></td>';
    }
    C.columns.forEach(function(col) {
      html += '<td>' + cellContent(row, col, idx) + '</td>';
    });
    html += '</tr>';
  });
  tbody.innerHTML = html;

  // Make rows clickable (navigate to detail)
  if (C.detailEndpoint) {
    tbody.querySelectorAll('tr[data-id]').forEach(function(tr) {
      tr.style.cursor = 'pointer';
      tr.addEventListener('click', function(e) {
        // Ignore clicks on checkbox
        if (e.target.tagName === 'INPUT') return;
        location.href = C.detailEndpoint.replace(':id', tr.getAttribute('data-id'));
      });
    });
  }

  updateSelectAllCb();
  updateBulkBar();
}

function renderPagination() {
  var el = document.getElementById('crud-pagination');
  if (!TOTAL_PAGES || TOTAL_PAGES <= 1) { el.innerHTML = ''; return; }
  var html = '';
  html += '<button class="pg-btn' + (PAGE <= 1 ? ' pg-disabled' : '') + '" onclick="if(' + PAGE + '>1)crudGoPage(' + (PAGE - 1) + ')"' + (PAGE <= 1 ? ' disabled' : '') + '>&lsaquo;</button>';
  var pages = [];
  if (TOTAL_PAGES <= 7) {
    for (var i = 1; i <= TOTAL_PAGES; i++) pages.push(i);
  } else {
    pages.push(1);
    if (PAGE > 3) pages.push('...');
    for (var j = Math.max(2, PAGE - 1); j <= Math.min(TOTAL_PAGES - 1, PAGE + 1); j++) pages.push(j);
    if (PAGE < TOTAL_PAGES - 2) pages.push('...');
    pages.push(TOTAL_PAGES);
  }
  pages.forEach(function(p) {
    if (p === '...') {
      html += '<span class="pg-ellipsis">...</span>';
    } else {
      html += '<button class="pg-btn' + (p === PAGE ? ' pg-active' : '') + '" onclick="crudGoPage(' + p + ')">' + p + '</button>';
    }
  });
  html += '<button class="pg-btn' + (PAGE >= TOTAL_PAGES ? ' pg-disabled' : '') + '" onclick="if(' + PAGE + '<' + TOTAL_PAGES + ')crudGoPage(' + (PAGE + 1) + ')"' + (PAGE >= TOTAL_PAGES ? ' disabled' : '') + '>&rsaquo;</button>';
  el.innerHTML = html;
}

function crudFetch() {
  var sep = (C.apiEndpoint && C.apiEndpoint.indexOf('?') !== -1) ? '&' : '?';
  var url = C.apiEndpoint + sep + 'page=' + PAGE + '&limit=' + LIMIT;

  if (SEARCH) url += '&search=' + encodeURIComponent(SEARCH);
  if (CATEGORY) url += '&category=' + encodeURIComponent(CATEGORY);
  if (BRAND) url += '&brand=' + encodeURIComponent(BRAND);
  if (STOCK) url += '&stock=' + encodeURIComponent(STOCK);
  if (SORT) url += '&sortBy=' + encodeURIComponent(SORT);
  if (STATUS) url += '&status=' + encodeURIComponent(STATUS);
  if (PRICE_MIN) url += '&minPrice=' + encodeURIComponent(PRICE_MIN);
  if (PRICE_MAX) url += '&maxPrice=' + encodeURIComponent(PRICE_MAX);
  if (CANCEL_REQUESTED) url += '&cancelRequested=' + encodeURIComponent(CANCEL_REQUESTED);
  if (ORDER_START_DATE) url += '&startDate=' + encodeURIComponent(ORDER_START_DATE);
  if (ORDER_END_DATE) url += '&endDate=' + encodeURIComponent(ORDER_END_DATE);
  if (ORIGIN) url += '&origin=' + encodeURIComponent(ORIGIN);
  if (APPLICABLE_TO) url += '&applicableTo=' + encodeURIComponent(APPLICABLE_TO);
  if (C.entityName === 'review' && REVIEW_RATING) url += '&rating=' + encodeURIComponent(REVIEW_RATING);
  document.getElementById('crud-tbody').innerHTML = skeletonRows(5, C.columns.length);

  fetch(url, { headers: { 'Authorization': 'Bearer ' + window.__API_TOKEN__ } })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success) { document.getElementById('crud-tbody').innerHTML = '<tr><td colspan="99" style="text-align:center;padding:40px;color:var(--danger);">Lỗi tải dữ liệu</td></tr>'; return; }
      var data = res.data !== undefined ? res.data : res;
      var items = C.itemsPath ? deepGet(data, C.itemsPath) : data;
      var total = C.totalPath ? deepGet(data, C.totalPath) : (data && data.total);
      var totalPages = C.totalPagesPath ? deepGet(data, C.totalPagesPath) : (data && data.totalPages);
      if (!items && Array.isArray(data)) items = data;
      if (!total && items) total = items.length;
      if (!totalPages && total) totalPages = Math.ceil(total / LIMIT);
      TOTAL_PAGES = totalPages || 1;
      document.getElementById('crud-total').textContent = total || 0;
      var totalLabel = document.getElementById('crud-total-label');
      if (totalLabel) {
        var labels = { product:'Tổng sản phẩm', brand:'Tổng thương hiệu', category:'Tổng danh mục', tag:'Tổng tag', order:'Tổng đơn hàng', review:'Tổng đánh giá', voucher:'Tổng mã giảm giá', user:'Tổng người dùng' };
        totalLabel.textContent = labels[C.entityName] || 'Tổng cộng';
      }
      // Update bulk bar label
      var bulkCountEl = document.getElementById('bulk-count');
      if (bulkCountEl) {
        var bulkLabels = { product:'sản phẩm', brand:'thương hiệu', category:'danh mục', tag:'tag', order:'đơn hàng', review:'đánh giá', voucher:'mã giảm giá', user:'người dùng' };
        var entityLabel = bulkLabels[C.entityName] || 'mục';
        bulkCountEl.dataset.entityLabel = entityLabel;
      }
      renderTable(items || []);
      renderPagination();
      
      // Show product filters
      if (C.entityName === 'product') {
        document.getElementById('crud-category-filter').style.display = 'inline-block';
      }
      syncUrl();
    })
    .catch(function() {
      document.getElementById('crud-tbody').innerHTML = '<tr><td colspan="99" style="text-align:center;padding:40px;color:var(--danger);">Lỗi kết nối</td></tr>';
    });
}

function crudSearch() {
  SEARCH = document.getElementById('crud-search').value.trim();
  PAGE = 1;
  crudFetch();
}

function crudGoPage(p) {
  PAGE = p;
  crudFetch();
}


        CATEGORY_DATA = items;
        // Restore selected state from URL
        if (CATEGORY) {
          CATEGORY_IDS = CATEGORY.split(',').filter(Boolean);
        }
        renderCategoryOptions();
        updateCategoryLabel();
      })
      .catch(function() {});
  })();

  // Stock filter
  var stockEl = document.getElementById('crud-stock-filter');

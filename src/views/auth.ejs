<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập - L'essence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ══════════════════════════════════════════════════════
       L'essence Auth Pages — Frontend Design System
       Gold accent (#C9A96E) · Inter typography · Editorial
       ══════════════════════════════════════════════════════ */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --color-background: #FFFFFF;
      --color-foreground: #1A1A1A;
      --color-primary: #C9A96E;
      --color-primary-dark: #B8944F;
      --color-primary-light: #D4BC82;
      --color-primary-muted: rgba(201,169,110,0.12);
      --color-border: #E8E8E8;
      --color-border-subtle: rgba(232,232,232,0.5);
      --color-text-primary: #1A1A1A;
      --color-text-secondary: #666666;
      --color-text-muted: #999999;
      --color-text-on-primary: #FFFFFF;
      --color-success: #10B981;
      --color-success-light: #D1FAE5;
      --color-error: #DC2626;
      --color-error-muted: rgba(239,68,68,0.08);
      --color-rich-black: #0A0A0A;

      --shadow-soft: 0 4px 20px rgba(0,0,0,0.04);
      --shadow-card: 0 8px 32px rgba(0,0,0,0.06);
      --shadow-elevated: 0 20px 60px rgba(0,0,0,0.08);

      --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
      --ease-premium: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    }


    body {
      font-family: var(--font-sans);
      background: var(--color-background);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: var(--color-text-primary);
      color-scheme: light;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    /* ===== WRAPPER ===== */
    .form-wrapper {
      position: relative;
      width: 100%;
      max-width: 420px;
      transition: max-width 0.35s var(--ease-premium);
    }
    .form-wrapper.register-mode {
      max-width: 640px;
    }

    .back-badge {
      position: absolute;
      top: -16px;
      left: -16px;
      z-index: 10;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--color-background);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-soft);
      font-family: var(--font-sans);
    }
    .back-badge:hover {
      color: var(--color-text-primary);
      border-color: var(--color-primary-dark);
    }
    @media (max-width: 680px) {
      .back-badge {
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
      }
      .form-wrapper, .form-wrapper.register-mode {
        max-width: 420px;
      }
    }

    .container {
      background: var(--color-background);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 48px 40px;
      width: 100%;
      min-height: 520px;
      box-shadow: var(--shadow-card);
      position: relative;
      overflow: hidden;
    }

    /* ===== FORM PANELS ===== */
    .form-panel {
      display: none;
      opacity: 0;
    }
    .form-panel.active {
      display: block;
      opacity: 1;
      animation: fade-up 0.4s var(--ease-premium) forwards;
    }
    .form-panel.fade-out {
      display: block;
      animation: fade-down 0.25s var(--ease-premium) forwards;
    }

    @keyframes fade-up {
      0% { opacity: 0; transform: translateY(16px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-down {
      0% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(-12px); }
    }

    .logo {
      text-align: center;
      margin-bottom: 32px;
    }
    .logo img { width: 48px; height: 48px; object-fit: contain; }
    .logo h1 {
      color: var(--color-text-primary);
      font-size: 24px;
      margin-top: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      transition: all 0.35s ease;
    }
    .logo .subtitle {
      color: var(--color-text-muted);
      font-size: 14px;
      margin-top: 4px;
      font-weight: 400;
      transition: all 0.35s ease;
    }

    /* --- Register grid --- */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 24px;
    }
    @media (max-width: 540px) {
      .form-grid {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }

    .form-group { margin-bottom: 18px; }
    label {
      display: block;
      color: var(--color-text-secondary);
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 6px;
    }

    /* ── Input field — matches Frontend .input-field ── */
    input {
      width: 100%;
      padding: 12px 16px;
      background: var(--color-background);
      border: 1px solid var(--color-border);
      border-radius: 10px;
      color: var(--color-text-primary);
      font-size: 15px;
      outline: none;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }
    input:focus {
      border-color: var(--color-primary-dark);
      box-shadow: 0 0 0 3px rgba(201,169,110,0.12);
    }
    input::placeholder { color: var(--color-text-muted); }

    .error-msg {
      background: var(--color-error-muted);
      border: 1px solid rgba(239,68,68,0.2);
      color: var(--color-error);
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 20px;
      display: none;
    }
    .error-msg.show { display: block; }
    .success-msg {
      background: var(--color-success-light);
      border: 1px solid rgba(16,185,129,0.2);
      color: var(--color-success);
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 20px;
      display: none;
    }
    .success-msg.show { display: block; }

    .field-error {
      color: var(--color-error);
      font-size: 12px;
      margin-top: 4px;
      display: none;
    }
    .field-error.show { display: block; }

    /* ── Button — matches Frontend .btn-primary ── */
    .btn {
      width: 100%;
      padding: 13px;
      background: var(--color-primary);
      color: var(--color-text-on-primary);
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .btn:hover { background: var(--color-primary-dark); transform: translateY(-1px); }
    .btn:active { transform: translateY(0) scale(0.98); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .spinner { display: none; }
    .btn.loading .spinner { display: inline-flex; }
    .btn.loading .btn-text { display: none; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner-icon {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255,255,255,0.15);
      border-top-color: var(--color-text-on-primary);
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    .password-wrapper {
      position: relative;
    }
    .password-wrapper input {
      padding-right: 44px;
    }
    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
      transition: color 0.2s ease;
    }
    .toggle-password:hover {
      color: var(--color-text-secondary);
    }

    .turnstile-container { margin-bottom: 20px; display: flex; justify-content: center; }

    .footer { text-align: center; margin-top: 24px; }
    .footer a {
      color: var(--color-text-secondary);
      text-decoration: none;
      font-size: 14px;
      transition: color 0.2s ease;
      cursor: pointer;
      font-family: var(--font-sans);
    }
    .footer a:hover { color: var(--color-primary-dark); }

    /* OAuth section */
    .oauth-section { margin-top: 16px; }
    .oauth-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }
    .oauth-divider .line {
      flex: 1;
      height: 1px;
      background: var(--color-border);
    }
    .oauth-divider span {
      color: var(--color-text-muted);
      font-size: 13px;
      white-space: nowrap;
    }

    /* ── Google button — matches Frontend .btn-ghost ── */
    .google-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 12px;
      background: var(--color-background);
      border: 1px solid var(--color-border);
      border-radius: 10px;
      color: var(--color-text-primary);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s ease;
      cursor: pointer;
      font-family: var(--font-sans);
    }
    .google-btn:hover {
      background: var(--color-background);
      border-color: var(--color-primary);
      color: var(--color-primary);
    }
    .google-btn:active { transform: scale(0.98); }
  </style>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
  <div class="form-wrapper" id="formWrapper">
    <a href="<%= frontendUrl %>" class="back-badge">
      <span>↩</span> Quay lại cửa hàng
    </a>
    <div class="container" id="container">
      <!-- ========== LOGO ========== -->
      <div class="logo">
        <img src="https://l-essence.vercel.app/logo.png" alt="L'essence" onerror="this.style.display='none'">
        <h1>L'essence</h1>
        <p class="subtitle" id="subtitle">Đăng nhập để tiếp tục</p>
      </div>

      <!-- ========== ERROR / SUCCESS ========== -->
      <div id="errorBox" class="error-msg"></div>
      <div id="successBox" class="success-msg"></div>

      <!-- ========== LOGIN PANEL ========== -->
      <div class="form-panel active" id="loginPanel">
        <form id="loginForm">
          <div class="form-group">
            <label for="loginEmail">Email hoặc tên đăng nhập</label>
            <input type="text" id="loginEmail" name="email" placeholder="your@email.com hoặc username" required autocomplete="username">
          </div>
          <div class="form-group">
            <label for="loginPassword">Mật khẩu</label>
            <div class="password-wrapper">
              <input type="password" id="loginPassword" name="password" placeholder="••••••••" required autocomplete="current-password">
              <button type="button" class="toggle-password" onclick="togglePassword('loginPassword', this)" tabindex="-1" aria-label="Hiện/ẩn mật khẩu">
                <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>
          <div class="turnstile-container" id="loginTurnstile">
            <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="light"></div>
          </div>
          <button type="submit" class="btn" id="loginSubmitBtn">
            <span class="btn-text">Đăng nhập</span>
            <span class="spinner"><span class="spinner-icon"></span></span>
          </button>
        </form>

        <div class="oauth-section">
          <div class="oauth-divider">
            <div class="line"></div>
            <span>hoặc</span>
            <div class="line"></div>
          </div>
          <a href="/api/auth/google" class="google-btn">
            <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            Đăng nhập bằng Google
          </a>
        </div>

        <div class="footer">
          <a onclick="switchMode('register')">Chưa có tài khoản? Đăng ký</a>
        </div>
      </div>

      <!-- ========== REGISTER PANEL ========== -->
      <div class="form-panel" id="registerPanel">
        <form id="registerForm" novalidate>
          <div class="form-grid grid-2-cols">
            <div class="form-group">
              <label for="regUsername">Tên đăng nhập</label>
              <input type="text" id="regUsername" name="username" placeholder="username" required autocomplete="username">
              <div class="field-error" id="usernameError">Tên đăng nhập tối thiểu 3 ký tự</div>
            </div>
            <div class="form-group">
              <label for="regPassword">Mật khẩu</label>
              <div class="password-wrapper">
                <input type="password" id="regPassword" name="password" placeholder="Ít nhất 6 ký tự" required autocomplete="new-password">
                <button type="button" class="toggle-password" onclick="togglePassword('regPassword', this)" tabindex="-1" aria-label="Hiện/ẩn mật khẩu">
                  <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="eye-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
              </div>
              <div class="field-error" id="passwordError">Mật khẩu phải có ít nhất 6 ký tự</div>
            </div>
            <div class="form-group">
              <label for="regEmail">Email</label>
              <input type="email" id="regEmail" name="email" placeholder="your@email.com" required autocomplete="email">
              <div class="field-error" id="emailError">Email không hợp lệ</div>
            </div>
            <div class="form-group">
              <label for="regConfirmPassword">Xác nhận mật khẩu</label>
              <input type="password" id="regConfirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu" required autocomplete="new-password">
              <div class="field-error" id="confirmPasswordError">Mật khẩu xác nhận không khớp</div>
            </div>
          </div>
          <div class="turnstile-container" id="registerTurnstile">
            <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="light"></div>
          </div>
          <button type="submit" class="btn" id="registerSubmitBtn">
            <span class="btn-text">Đăng ký</span>
            <span class="spinner"><span class="spinner-icon"></span></span>
          </button>
        </form>

        <div class="oauth-section">
          <div class="oauth-divider">
            <div class="line"></div>
            <span>hoặc</span>
            <div class="line"></div>
          </div>
          <a href="/api/auth/google" class="google-btn">
            <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            Đăng ký bằng Google
          </a>
        </div>

        <div class="footer">
          <a onclick="switchMode('login')">Đã có tài khoản? Đăng nhập</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ===== STATE =====
    let currentMode = '<%= mode %>'; // 'login' hoặc 'register'
    let isTransitioning = false;
    let turnstileWidgetId = null;

    const formWrapper = document.getElementById('formWrapper');
    const container = document.getElementById('container');
    const subtitle = document.getElementById('subtitle');
    const loginPanel = document.getElementById('loginPanel');
    const registerPanel = document.getElementById('registerPanel');
    const errorBox = document.getElementById('errorBox');
    const successBox = document.getElementById('successBox');
    const loginForm = document.getElementById('loginForm');
    const registerForm = document.getElementById('registerForm');
    const loginSubmitBtn = document.getElementById('loginSubmitBtn');
    const registerSubmitBtn = document.getElementById('registerSubmitBtn');

    // ===== INIT =====
    function init() {
      if (currentMode === 'register') {
        switchMode('register', false);
      }

      // URL params
      const params = new URLSearchParams(window.location.search);
      const errorParam = params.get('error');
      if (errorParam) {
        errorBox.textContent = decodeURIComponent(errorParam);
        errorBox.classList.add('show');
      }
      const successParam = params.get('success');
      if (successParam) {
        successBox.textContent = decodeURIComponent(successParam);
        successBox.classList.add('show');
      }
    }

    // ===== SWITCH MODE =====
    function switchMode(mode, animate = true) {
      if (isTransitioning || currentMode === mode) return;
      isTransitioning = true;
      document.title = mode === 'login' ? 'Đăng nhập - L\'essence' : 'Đăng ký - L\'essence';

      const fromPanel = currentMode === 'register' ? registerPanel : loginPanel;
      const toPanel = mode === 'register' ? registerPanel : loginPanel;

      // Update URL without reloading
      var newPath = mode === 'login' ? '/login' : '/register';
      history.pushState({ mode: mode }, '', newPath);

      if (mode === 'register') {
        subtitle.textContent = 'Tạo tài khoản mới';
        formWrapper.classList.add('register-mode');
      } else {
        subtitle.textContent = 'Đăng nhập để tiếp tục';
        formWrapper.classList.remove('register-mode');
      }

      if (!animate) {
        fromPanel.classList.remove('active');
        toPanel.classList.add('active');
        currentMode = mode;
        renderTurnstile(mode);
        errorBox.classList.remove('show');
        successBox.classList.remove('show');
        isTransitioning = false;
        return;
      }

      // Fade out current panel, then fade in new panel after width transition
      fromPanel.classList.add('fade-out');
      fromPanel.classList.remove('active');

      setTimeout(() => {
        fromPanel.classList.remove('fade-out');
        toPanel.classList.add('active');
        currentMode = mode;
        renderTurnstile(mode);
        errorBox.classList.remove('show');
        successBox.classList.remove('show');
        isTransitioning = false;
      }, 400);
    }

    // ===== TOGGLE PASSWORD VISIBILITY =====
    function togglePassword(inputId, btn) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      const eyeIcon = btn.querySelector('.eye-icon');
      const eyeOffIcon = btn.querySelector('.eye-off-icon');
      if (eyeIcon) eyeIcon.style.display = isPassword ? 'none' : '';
      if (eyeOffIcon) eyeOffIcon.style.display = isPassword ? '' : 'none';
    }

    // ===== TURNSTILE (lazy render) =====
    function renderTurnstile(mode) {
      const container = mode === 'register' ? document.getElementById('registerTurnstile') : document.getElementById('loginTurnstile');
      // Nếu đã có widget thì skip
      if (container && container.querySelector('.cf-turnstile')) return;

      // Reset container
      if (container) {
        container.innerHTML = '';
        const div = document.createElement('div');
        div.className = 'cf-turnstile';
        div.setAttribute('data-sitekey', '<%= turnstileSiteKey %>');
        div.setAttribute('data-theme', 'light');
        container.appendChild(div);

        // Re-render Turnstile
        if (window.turnstile) {
          window.turnstile.render(div);
        }
      }
    }

    // ===== VALIDATION =====
    const registerFields = {
      username: { el: document.getElementById('regUsername'), error: document.getElementById('usernameError') },
      email: { el: document.getElementById('regEmail'), error: document.getElementById('emailError') },
      password: { el: document.getElementById('regPassword'), error: document.getElementById('passwordError') },
      confirmPassword: { el: document.getElementById('regConfirmPassword'), error: document.getElementById('confirmPasswordError') },
    };

    function validateRegister() {
      let valid = true;
      const data = {
        username: registerFields.username.el.value.trim(),
        email: registerFields.email.el.value.trim(),
        password: registerFields.password.el.value,
        confirmPassword: registerFields.confirmPassword.el.value,
      };

      if (data.username.length < 3) { registerFields.username.error.classList.add('show'); valid = false; }
      else { registerFields.username.error.classList.remove('show'); }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) { registerFields.email.error.classList.add('show'); valid = false; }
      else { registerFields.email.error.classList.remove('show'); }

      if (data.password.length < 6) { registerFields.password.error.classList.add('show'); valid = false; }
      else { registerFields.password.error.classList.remove('show'); }

      if (data.password !== data.confirmPassword) { registerFields.confirmPassword.error.classList.add('show'); valid = false; }
      else { registerFields.confirmPassword.error.classList.remove('show'); }

      return valid ? data : null;
    }

    function getTurnstileToken() {
      const el = document.querySelector('.cf-turnstile[data-sitekey]');
      return el?.querySelector?.('[name="cf-turnstile-response"]')?.value || '';
    }

    // ===== LOGIN SUBMIT =====
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.remove('show');
      loginSubmitBtn.classList.add('loading');
      loginSubmitBtn.disabled = true;

      const turnstileToken = getTurnstileToken();
      if (!turnstileToken) {
        errorBox.textContent = 'Vui lòng xác minh bạn không phải là robot';
        errorBox.classList.add('show');
        loginSubmitBtn.classList.remove('loading');
        loginSubmitBtn.disabled = false;
        return;
      }

      const data = {
        email: document.getElementById('loginEmail').value,
        password: document.getElementById('loginPassword').value,
        turnstileToken,
        frontendUrl: '<%= frontendUrl %>'
      };

      try {
        const res = await fetch('/api/auth/login-page', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.success) {
          window.location.href = json.redirectUrl;
        } else {
          errorBox.textContent = json.message || 'Đăng nhập thất bại';
          errorBox.classList.add('show');
          // Reset Turnstile after failed attempt
          if (window.turnstile) window.turnstile.reset();
        }
      } catch (err) {
        errorBox.textContent = 'Lỗi kết nối đến máy chủ';
        errorBox.classList.add('show');
      } finally {
        loginSubmitBtn.classList.remove('loading');
        loginSubmitBtn.disabled = false;
      }
    });

    // ===== REGISTER SUBMIT =====
    registerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.remove('show');
      successBox.classList.remove('show');

      const turnstileToken = getTurnstileToken();
      if (!turnstileToken) {
        errorBox.textContent = 'Vui lòng xác minh bạn không phải là robot';
        errorBox.classList.add('show');
        return;
      }

      const data = validateRegister();
      if (!data) return;

      data.turnstileToken = turnstileToken;
      registerSubmitBtn.classList.add('loading');
      registerSubmitBtn.disabled = true;

      try {
        const res = await fetch('/api/auth/register-page', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.success) {
          successBox.textContent = 'Đăng ký thành công! Đang chuyển đến trang đăng nhập...';
          successBox.classList.add('show');
          setTimeout(() => {
            switchMode('login');
          }, 1500);
        } else {
          errorBox.textContent = json.message || 'Đăng ký thất bại';
          errorBox.classList.add('show');
          if (window.turnstile) window.turnstile.reset();
        }
      } catch (err) {
        errorBox.textContent = 'Lỗi kết nối đến máy chủ';
        errorBox.classList.add('show');
      } finally {
        registerSubmitBtn.classList.remove('loading');
        registerSubmitBtn.disabled = false;
      }
    });

    init();
  </script>
</body>
</html>